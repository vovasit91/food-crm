    "newCookingSteps": [
      {
        "id": "saute-spinach-sandwich-with-tuna-and-spinach",
        "en": {
          "title": "Sauté the spinach",
          "description": "Heat 1 tsp of butter in a skillet over medium heat. Add the spinach and sauté for 2-3 minutes until wilted. Season with salt and let cool slightly."
        }
      },
      {
        "id": "prepare-tuna-and-cheese-sandwich-with-tuna-and-spinach",
        "en": {
          "title": "Prepare the tuna, cheese, and onion",
          "description": "In a bowl, mash the tuna with a fork. Grate the semi-hard cheese coarsely. Finely chop the green onion."
        }
      },
      {
        "id": "mix-filling-sandwich-with-tuna-and-spinach",
        "en": {
          "title": "Mix the filling",
          "description": "Add the sautéed spinach, cream cheese, mustard, yogurt, chopped green onion, salt, and dried garlic to the tuna. Mix until well combined."
        }
      },
      {
        "id": "assemble-sandwich-sandwich-with-tuna-and-spinach",
        "en": {
          "title": "Assemble the sandwiches",
          "description": "Place the grated cheese on two slices of bread. Top each with a generous spoonful of the tuna-spinach filling. Cover with the remaining bread slices and press lightly."
        }
      },
      {
        "id": "fry-sandwich-sandwich-with-tuna-and-spinach",
        "en": {
          "title": "Fry the sandwiches",
          "description": "Heat the remaining butter in the skillet over medium heat. Fry the sandwiches on both sides until golden and crispy, about 2-3 minutes total."
        }
      }
    ],
