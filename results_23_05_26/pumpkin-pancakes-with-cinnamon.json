    "newCookingSteps": [
      {
        "id": "mix-honey-butter-pumpkin-pancakes-with-cinnamon",
        "en": {
          "title": "Mix honey butter",
          "description": "In a bowl, combine softened butter, honey, cinnamon, and vanilla extract. Whisk until smooth and set aside at room temperature until serving."
        }
      },
      {
        "id": "mix-dry-ingredients-pumpkin-pancakes-with-cinnamon",
        "en": {
          "title": "Mix dry ingredients",
          "description": "In a medium bowl, whisk together flour, cane sugar, baking powder, baking soda, salt, and cinnamon."
        }
      },
      {
        "id": "melt-butter-and-mix-wet-pumpkin-pancakes-with-cinnamon",
        "en": {
          "title": "Melt butter and mix wet ingredients",
          "description": "Melt 40 g of butter. In a large bowl, combine the melted butter with eggs, kefir, pumpkin puree, and vanilla extract."
        }
      },
      {
        "id": "whisk-batter-pumpkin-pancakes-with-cinnamon",
        "en": {
          "title": "Whisk batter",
          "description": "Add the dry ingredients to the wet mixture and whisk until smooth."
        }
      },
      {
        "id": "rest-batter-pumpkin-pancakes-with-cinnamon",
        "en": {
          "title": "Rest the batter",
          "description": "Let the batter rest for 10–15 minutes. This allows the pancakes to become fluffier."
        }
      },
      {
        "id": "make-cinnamon-swirl-pumpkin-pancakes-with-cinnamon",
        "en": {
          "title": "Make cinnamon swirl mixture",
          "description": "In a small bowl, combine 80 g softened butter, 3 tbsp sugar, 2 tsp cinnamon, and 2 tbsp of the prepared batter. Mix until smooth, then transfer to a piping bag or a zip‑top bag with a corner snipped off."
        }
      },
      {
        "id": "heat-pan-pumpkin-pancakes-with-cinnamon",
        "en": {
          "title": "Heat the pan",
          "description": "Place a frying pan over medium heat. Lightly grease the surface with butter or vegetable oil."
        }
      },
      {
        "id": "cook-pancake-first-side-pumpkin-pancakes-with-cinnamon",
        "en": {
          "title": "Cook first side with swirl",
          "description": "Pour about half a ladle of batter onto the hot pan. After 1 minute, pipe a spiral of the cinnamon mixture onto the batter. Cook for 2–3 minutes until bubbles form on the surface."
        }
      },
      {
        "id": "flip-and-cook-second-side-pumpkin-pancakes-with-cinnamon",
        "en": {
          "title": "Flip and cook second side",
          "description": "Carefully flip the pancake and cook for another 1–3 minutes until golden brown. Repeat the cooking steps for the remaining batter."
        }
      }
    ],
