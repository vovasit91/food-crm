    "newCookingSteps": [
      {
        "id": "fry-bacon-cream-cheese-quail-egg-toast",
        "en": {
          "title": "Fry the bacon",
          "description": "Heat a dry frying pan over medium heat. Finely chop the bacon and fry until crispy, about 5 minutes. Transfer the bacon to a paper towel to drain."
        }
      },
      {
        "id": "saute-spinach-cream-cheese-quail-egg-toast",
        "en": {
          "title": "Sauté the spinach",
          "description": "In the same pan, add the spinach and sauté over medium heat until wilted, about 1–2 minutes. No additional oil is needed as there is residual bacon fat."
        }
      },
      {
        "id": "mix-filling-cream-cheese-quail-egg-toast",
        "en": {
          "title": "Mix the filling",
          "description": "In a bowl, combine the fried bacon, sautéed spinach, and cream cheese. Stir until evenly mixed."
        }
      },
      {
        "id": "assemble-toasts-cream-cheese-quail-egg-toast",
        "en": {
          "title": "Assemble the toasts",
          "description": "Spread the cream cheese mixture onto the bread slices. Make a small well in the center of each slice. Place the toasts on a baking tray."
        }
      },
      {
        "id": "add-egg-cream-cheese-quail-egg-toast",
        "en": {
          "title": "Add the quail eggs",
          "description": "Carefully crack a quail egg into each well. Be gentle to keep the yolk intact."
        }
      },
      {
        "id": "bake-toasts-cream-cheese-quail-egg-toast",
        "en": {
          "title": "Bake the toasts",
          "description": "Preheat the oven to 180°C (350°F). Place the baking tray in the oven and bake for 10–15 minutes, until the egg white is set but the yolk remains runny. Watch carefully to avoid overcooking."
        }
      }
    ],
