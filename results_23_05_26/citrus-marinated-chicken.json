    "newCookingSteps": [
      {
        "id": "zest-and-juice-oranges-citrus-marinated-chicken",
        "en": {
          "title": "Zest and juice the oranges",
          "description": "Grate the zest from one orange, taking only the colored part. Squeeze the juice from that orange and two more. Slice the remaining two oranges, skin on, into wedges."
        }
      },
      {
        "id": "halve-lemon-and-chop-garlic-citrus-marinated-chicken",
        "en": {
          "title": "Prepare the lemon and garlic",
          "description": "Cut the lemon in half. Squeeze the juice from one half and slice the other half into wedges. Finely chop the garlic cloves or press them through a garlic press."
        }
      },
      {
        "id": "mix-marinade-citrus-marinated-chicken",
        "en": {
          "title": "Mix the marinade",
          "description": "In a bowl, combine the orange juice, lemon juice, orange zest, chopped garlic, honey, soy sauce, and dried oregano. Stir until well mixed."
        }
      },
      {
        "id": "prepare-chicken-in-dish-citrus-marinated-chicken",
        "en": {
          "title": "Prepare the chicken in the baking dish",
          "description": "Grease a baking dish with oil. Butcher the whole chicken into pieces and place them skin side up in the dish. Pour the marinade evenly over the chicken, then top with the orange and lemon wedges."
        }
      },
      {
        "id": "refrigerate-marinate-citrus-marinated-chicken",
        "en": {
          "title": "Marinate the chicken in the refrigerator",
          "description": "Cover the dish with plastic wrap or a lid and refrigerate for 2–4 hours, or overnight. For best results, occasionally baste the chicken with the marinade during this time."
        }
      },
      {
        "id": "rest-chicken-and-preheat-oven-citrus-marinated-chicken",
        "en": {
          "title": "Rest the chicken and preheat the oven",
          "description": "Remove the dish from the refrigerator 30 minutes before cooking to let the chicken come to room temperature. Meanwhile, preheat your oven to 210°C (410°F)."
        }
      },
      {
        "id": "bake-first-stage-citrus-marinated-chicken",
        "en": {
          "title": "Bake at high temperature",
          "description": "Remove the plastic wrap, season the chicken with salt and pepper, then bake at 210°C for 20 minutes."
        }
      },
      {
        "id": "bake-second-stage-citrus-marinated-chicken",
        "en": {
          "title": "Finish baking at lower temperature",
          "description": "Reduce the oven temperature to 190°C (375°F) and continue baking for 30–40 minutes, until the chicken is cooked through and the skin is golden brown and crispy. Baste occasionally with the pan juices."
        }
      }
    ],
