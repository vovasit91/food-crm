    "newCookingSteps": [
      {
        "id": "beat-eggs-omelette-with-potatoes-and-cheese",
        "en": {
          "title": "Beat the eggs",
          "description": "Crack the eggs into a bowl. Add salt and black pepper. Whisk until smooth and homogeneous."
        }
      },
      {
        "id": "grate-cheese-omelette-with-potatoes-and-cheese",
        "en": {
          "title": "Grate and mix cheese",
          "description": "Finely grate the Gouda cheese. Stir it into the beaten egg mixture until well combined."
        }
      },
      {
        "id": "chop-vegetables-omelette-with-potatoes-and-cheese",
        "en": {
          "title": "Chop the vegetables",
          "description": "Cut the potatoes into thin, almost translucent slices. Dice the onion into small cubes. Finely chop the green onion stalks."
        }
      },
      {
        "id": "fry-onion-omelette-with-potatoes-and-cheese",
        "en": {
          "title": "Fry the onion",
          "description": "Heat vegetable oil in a frying pan over medium heat. Add the diced onion and sauté, stirring, until golden brown, about 1 minute."
        }
      },
      {
        "id": "fry-potatoes-omelette-with-potatoes-and-cheese",
        "en": {
          "title": "Fry the potatoes",
          "description": "Add the potato slices to the pan with the onion. Continue frying for 2–3 minutes, stirring occasionally, until the potatoes are golden and tender."
        }
      },
      {
        "id": "combine-mixture-omelette-with-potatoes-and-cheese",
        "en": {
          "title": "Combine vegetables with egg mixture",
          "description": "Drain excess oil from the pan. Transfer the fried vegetables to the bowl with the egg and cheese mixture. Add the chopped green onion and stir well to combine."
        }
      },
      {
        "id": "cook-omelette-covered-omelette-with-potatoes-and-cheese",
        "en": {
          "title": "Cook the omelette covered",
          "description": "Heat the remaining vegetable oil in the pan over medium heat. Pour in the egg‑vegetable mixture and spread it evenly. Cover the pan and cook until the omelette is set, 3–4 minutes."
        }
      },
      {
        "id": "flip-and-cook-other-side-omelette-with-potatoes-and-cheese",
        "en": {
          "title": "Flip and finish cooking",
          "description": "Remove the lid. Place a large plate over the pan and carefully flip the omelette onto the plate. Slide the omelette back into the pan with the cooked side up. Fry until the other side is golden brown, about 3 minutes."
        }
      }
    ],
