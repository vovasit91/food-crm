    "newCookingSteps": [
      {
        "id": "separate-eggs-japanese-pancakes",
        "en": {
          "title": "Separate the eggs",
          "description": "Crack the eggs and carefully separate the whites from the yolks. Keep 2 yolks for later (you can discard the third yolk or save for another use) and place all 3 whites in a large bowl."
        }
      },
      {
        "id": "beat-egg-whites-japanese-pancakes",
        "en": {
          "title": "Beat the egg whites",
          "description": "Add a pinch of salt to the egg whites and beat until soft peaks form. Gradually add the sugar while continuing to beat until stiff, glossy peaks form. This should take about 5 minutes."
        }
      },
      {
        "id": "mix-yolk-mixture-japanese-pancakes",
        "en": {
          "title": "Mix the yolk mixture",
          "description": "In a separate bowl, combine the 2 reserved egg yolks with the milk and olive oil. Whisk until smooth and well combined. You don't need to achieve a frothy texture."
        }
      },
      {
        "id": "mix-dry-wet-japanese-pancakes",
        "en": {
          "title": "Combine dry and wet ingredients",
          "description": "In a small bowl, mix the flour and baking powder together. Gradually add the dry mixture to the yolk mixture, stirring constantly until no lumps remain and the batter is smooth."
        }
      },
      {
        "id": "fold-egg-whites-japanese-pancakes",
        "en": {
          "title": "Fold in the beaten egg whites",
          "description": "Gently add the beaten egg whites to the batter, one spoonful at a time. Use a spatula to fold them in with upward motions from the bottom until just incorporated. Be careful not to deflate the whites."
        }
      },
      {
        "id": "make-parchment-rings-japanese-pancakes",
        "en": {
          "title": "Make parchment rings",
          "description": "Cut parchment paper into strips about 26 cm long and 5 cm wide. Roll each strip into a ring about 8 cm in diameter, overlapping the ends by about 1 cm, and secure with a toothpick."
        }
      },
      {
        "id": "cook-first-side-japanese-pancakes",
        "en": {
          "title": "Cook the first side",
          "description": "Place the parchment rings in a dry, well-heated frying pan. Fill each ring about three-quarters full with batter. Cover the pan with a lid and cook over medium heat for 4–5 minutes, until the batter rises to the top of the rings."
        }
      },
      {
        "id": "cook-second-side-japanese-pancakes",
        "en": {
          "title": "Flip and cook the second side",
          "description": "Carefully flip the pancakes (still inside the rings) using a spatula. Cook for another 4 minutes without the lid until the other side is golden brown. Remove the rings before serving."
        }
      }
    ],
