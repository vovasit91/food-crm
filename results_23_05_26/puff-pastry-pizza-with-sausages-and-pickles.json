        "en": {
          "title": "Preheat the oven",
          "description": "Preheat your oven to 200°C (400°F). This ensures the oven is hot enough for baking the pizza."
        }
      },
      {
        "id": "slice-onion-and-grate-cheese-puff-pastry-pizza-with-sausages-and-pickles",
        "en": {
          "title": "Slice onion and grate cheese",
          "description": "Slice the onion into thin half rings. Grate the mozzarella cheese coarsely using a box grater."
        }
      },
      {
        "id": "slice-vegetables-and-sausages-puff-pastry-pizza-with-sausages-and-pickles",
        "en": {
          "title": "Slice vegetables and sausages",
          "description": "Cut the pickles, tomato, and sausages into round slices about 2–3 mm thick. Slice the mushrooms into similar thin slices."
        }
      },
      {
        "id": "roll-dough-and-form-crust-puff-pastry-pizza-with-sausages-and-pickles",
        "en": {
          "title": "Roll out dough and form crust",
          "description": "Roll the puff pastry sheet into a rectangle about 3–4 mm thick. Transfer it to a baking sheet. Fold the edges inward to create a raised crust."
        }
      },
      {
        "id": "spread-ketchup-and-add-toppings-puff-pastry-pizza-with-sausages-and-pickles",
        "en": {
          "title": "Spread ketchup and add first toppings",
          "description": "Evenly spread ketchup over the dough base. Arrange the sliced onion on top, then lay the mushroom slices over the onion. Season with salt, black pepper, and Italian herbs."
        }
      },
      {
        "id": "add-tomato-and-pickles-puff-pastry-pizza-with-sausages-and-pickles",
        "en": {
          "title": "Add tomato and pickles",
          "description": "Distribute the sliced tomato and pickles evenly over the pizza."
        }
      },
      {
        "id": "add-sausages-and-cheese-puff-pastry-pizza-with-sausages-and-pickles",
        "en": {
          "title": "Add sausages and cheese",
          "description": "Place the sausage slices on the pizza, then sprinkle the grated mozzarella cheese evenly over everything."
        }
      },
      {
        "id": "bake-pizza-puff-pastry-pizza-with-sausages-and-pickles",
        "en": {
          "title": "Bake the pizza",
          "description": "Place the baking sheet in the preheated oven and bake at 200°C for 20–25 minutes, until the crust is golden and cheese is melted and bubbly."
        }
      }
