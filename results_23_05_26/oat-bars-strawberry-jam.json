        "en": {
          "title": "Grind the oats",
          "description": "Place 150 g of oats into a mixer bowl and grind until fine. Transfer to a separate bowl."
        }
      },
      {
        "id": "combine-dry-ingredients-oat-bars-strawberry-jam",
        "en": {
          "title": "Combine dry ingredients",
          "description": "In a bowl, mix the ground oats with whole wheat flour, sugar, and salt."
        }
      },
      {
        "id": "cut-butter-oat-bars-strawberry-jam",
        "en": {
          "title": "Cut the butter",
          "description": "Cut the cold butter into small cubes."
        }
      },
      {
        "id": "rub-butter-into-dry-ingredients-oat-bars-strawberry-jam",
        "en": {
          "title": "Rub butter into dry mix",
          "description": "Add the butter cubes to the dry ingredients and use your fingers to rub them in until the mixture resembles coarse crumbs."
        }
      },
      {
        "id": "add-vanilla-and-remaining-oats-oat-bars-strawberry-jam",
        "en": {
          "title": "Add vanilla and remaining oats",
          "description": "Pour in the vanilla extract and add the remaining oats. Stir everything together thoroughly."
        }
      },
      {
        "id": "press-half-crumb-into-dish-oat-bars-strawberry-jam",
        "en": {
          "title": "Press half the crumb into dish",
          "description": "Transfer half of the oat mixture into a baking dish. Press it down firmly with your hands or a glass to form a compact, even base."
        }
      },
      {
        "id": "spread-jam-oat-bars-strawberry-jam",
        "en": {
          "title": "Spread the jam",
          "description": "Spread the strawberry jam evenly over the pressed base using a spoon."
        }
      },
      {
        "id": "top-with-remaining-crumb-oat-bars-strawberry-jam",
        "en": {
          "title": "Top with remaining crumb",
          "description": "Sprinkle the remaining oat mixture over the jam layer and gently press it down to compact."
        }
      },
      {
        "id": "bake-oat-bars-strawberry-jam",
        "en": {
          "title": "Bake",
          "description": "Place the dish in an oven preheated to 180°C and bake for 50 minutes until golden brown."
        }
      },
      {
        "id": "cool-in-pan-oat-bars-strawberry-jam",
        "en": {
          "title": "Cool in pan",
          "description": "Let the baked bars cool completely in the pan on a wire rack."
