    "newCookingSteps": [
      {
        "id": "soak-gelatin-curd-dessert-cookies-banana",
        "en": {
          "title": "Soak the gelatin",
          "description": "Pour gelatin into a small saucepan, add milk, and let it sit for 30 minutes to bloom."
        }
      },
      {
        "id": "heat-gelatin-curd-dessert-cookies-banana",
        "en": {
          "title": "Heat the gelatin mixture",
          "description": "Place the saucepan over the lowest heat. Stir continuously until the gelatin is completely dissolved. Do not let it boil."
        }
      },
      {
        "id": "add-cocoa-vanillin-curd-dessert-cookies-banana",
        "en": {
          "title": "Add cocoa and vanilla",
          "description": "Add cocoa powder and vanillin to the warm gelatin mixture. Whisk until smooth and uniformly chocolate-colored."
        }
      },
      {
        "id": "blend-curd-mix-curd-dessert-cookies-banana",
        "en": {
          "title": "Blend the curd mixture",
          "description": "Place the soft curd in a deep bowl. Pour in the chocolate-milk mixture and blend with an immersion blender until you have a smooth, homogeneous cream."
        }
      },
      {
        "id": "grate-chocolate-curd-dessert-cookies-banana",
        "en": {
          "title": "Grate the chocolate",
          "description": "Grate the milk chocolate on a coarse grater or chop finely with a knife. Add most of the chocolate shavings to the curd cream and mix. Reserve a small handful for decoration."
        }
      },
      {
        "id": "slice-banana-for-filling-curd-dessert-cookies-banana",
        "en": {
          "title": "Slice the first banana",
          "description": "Peel one banana and cut it into thin rounds. These will go inside the dessert."
        }
      },
      {
        "id": "assemble-layers-curd-dessert-cookies-banana",
        "en": {
          "title": "Assemble the layers",
          "description": "Crush the cookies and spread half of the crumbs on the bottom of serving dishes. Arrange half of the banana slices on top. Pour in half of the curd cream and spread evenly. Repeat with the remaining cookies, banana slices, and curd cream."
        }
      },
      {
        "id": "chill-dessert-curd-dessert-cookies-banana",
        "en": {
          "title": "Chill the dessert",
          "description": "Place the filled dishes in the refrigerator for at least 4 hours, or overnight, to allow the dessert to set completely."
        }
      },
      {
        "id": "decorate-with-banana-curd-dessert-cookies-banana",
        "en": {
          "title": "Decorate with the second banana",
          "description": "Take the dessert out of the fridge. Peel the second banana, slice it into rounds, and cut each round in half or into quarters. Arrange the pieces on top of the dessert as decoration."
        }
      }
    ],
