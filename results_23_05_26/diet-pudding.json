    "newCookingSteps": [
      {
        "id": "separate-and-mix-yolks-diet-pudding",
        "en": {
          "title": "Separate yolks and mix with butter and sugar",
          "description": "Separate the egg yolks from the whites. In a bowl, rub the yolks with the butter and sugar until smooth and well combined."
        }
      },
      {
        "id": "add-flour-cardamom-diet-pudding",
        "en": {
          "title": "Add flour and cardamom",
          "description": "Add the flour and ground cardamom to the yolk mixture. Stir thoroughly until the dry ingredients are fully incorporated."
        }
      },
      {
        "id": "add-sour-milk-diet-pudding",
        "en": {
          "title": "Add sour milk",
          "description": "Pour in the sour milk or yogurt. Mix well again until a smooth batter forms."
        }
      },
      {
        "id": "whip-egg-whites-diet-pudding",
        "en": {
          "title": "Whip egg whites with salt",
          "description": "In a separate, clean bowl, whip the egg whites with the salt using a mixer. Beat until stiff peaks form and the mixture is fluffy."
        }
      },
      {
        "id": "fold-whites-into-batter-diet-pudding",
        "en": {
          "title": "Fold whites into batter",
          "description": "Gently fold the whipped egg whites into the yolk batter using a spatula. Be careful not to deflate the whites; combine until just uniform."
        }
      },
      {
        "id": "grease-molds-diet-pudding",
        "en": {
          "title": "Grease baking molds",
          "description": "Lightly grease the baking molds with vegetable oil. This will help the puddings release easily after baking."
        }
      },
      {
        "id": "pour-batter-into-molds-diet-pudding",
        "en": {
          "title": "Pour batter into molds",
          "description": "Divide the batter evenly among the greased molds. Smooth the tops if needed."
        }
      },
      {
        "id": "bake-diet-pudding",
        "en": {
          "title": "Bake the puddings",
          "description": "Place the filled molds in a preheated oven. Bake for 30 minutes until the puddings are golden brown and set in the center. A toothpick inserted should come out clean."
        }
      }
    ],
