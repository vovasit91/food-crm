    "newCookingSteps": [
      {
        "id": "cut-pineapple-rings-pineapple-lassi",
        "en": {
          "title": "Cut the pineapple into rings",
          "description": "Cut the pineapple into 5 rings, each about 1–1.3 cm thick."
        }
      },
      {
        "id": "heat-pan-with-oils-pineapple-lassi",
        "en": {
          "title": "Heat the pan and melt the oils",
          "description": "Heat a frying pan over medium heat. Add the butter and coconut oil and let them melt."
        }
      },
      {
        "id": "cook-first-batch-pineapple-lassi",
        "en": {
          "title": "Cook the first batch of rings",
          "description": "Place 2–3 pineapple rings in the pan, sprinkle with half the sugar and salt. Cook for 4–5 minutes per side until caramelized and deep golden."
        }
      },
      {
        "id": "cook-second-batch-pineapple-lassi",
        "en": {
          "title": "Cook the remaining rings",
          "description": "Transfer the first batch to a plate. Add the remaining rings to the pan, sprinkle with the rest of the sugar and salt, and cook for 4–5 minutes per side until caramelized."
        }
      },
      {
        "id": "add-ingredients-to-blender-pineapple-lassi",
        "en": {
          "title": "Add ingredients to the blender",
          "description": "Place 4 cooked pineapple rings into the blender. Add the yogurt, coconut milk, cardamom, and cinnamon."
        }
      },
      {
        "id": "blend-lassi-pineapple-lassi",
        "en": {
          "title": "Blend until smooth",
          "description": "Blend on high speed for 2–3 minutes until the mixture is thick and homogeneous."
        }
      },
      {
        "id": "serve-lassi-pineapple-lassi",
        "en": {
          "title": "Pour into glasses and garnish",
          "description": "Pour the lassi into glasses. Cut the remaining grilled pineapple ring in half, place a half on top of each glass, and garnish with fresh mint if desired."
        }
      }
    ],
