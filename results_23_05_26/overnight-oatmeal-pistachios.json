      {
        "id": "combine-dry-overnight-oatmeal-pistachios",
        "en": {
          "title": "Combine dry ingredients",
          "description": "In a bowl, mix the rolled oats, ground cinnamon, ground cardamom, lemon zest, and orange zest. Stir well to combine."
        }
      },
      {
        "id": "add-wet-overnight-oatmeal-pistachios",
        "en": {
          "title": "Add wet ingredients",
          "description": "Pour oat milk into the dry mixture. Add nut paste and maple syrup. Stir until everything is evenly combined and smooth."
        }
      },
      {
        "id": "chop-nuts-overnight-oatmeal-pistachios",
        "en": {
          "title": "Chop nuts",
          "description": "Using a knife or rolling pin, coarsely chop the pistachios and walnuts. Set aside."
        }
      },
      {
        "id": "assemble-layers-overnight-oatmeal-pistachios",
        "en": {
          "title": "Assemble layers",
          "description": "Divide half of the oatmeal mixture into jars. Sprinkle half of the chopped nuts over the mixture. Top with the remaining oatmeal mixture and then with the rest of the nuts."
        }
      },
      {
        "id": "refrigerate-overnight-oatmeal-pistachios",
        "en": {
          "title": "Refrigerate overnight",
          "description": "Seal the jars and place them in the refrigerator. Let them chill for at least 6 hours, preferably overnight, until the oats are soft and the flavors meld."
        }
      }
