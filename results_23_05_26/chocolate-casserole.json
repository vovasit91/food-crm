    "newCookingSteps": [
      {
        "id": "melt-chocolate-chocolate-casserole",
        "en": {
          "title": "Melt the chocolate",
          "description": "Break the chocolate into pieces and place in a heatproof bowl. Add the cream and set the bowl over a pot of hot, but not boiling water. Make sure the bottom does not touch the water. Stir until melted and smooth, then remove from the pot."
        }
      },
      {
        "id": "blend-tvorog-mixture-chocolate-casserole",
        "en": {
          "title": "Blend tvorog and eggs",
          "description": "In a separate bowl, combine the tvorog and eggs. Blend with an immersion blender until smooth. Pour in the melted chocolate and mix again."
        }
      },
      {
        "id": "add-semolina-and-rest-chocolate-casserole",
        "en": {
          "title": "Add semolina and let rest",
          "description": "Add the sugar and semolina to the tvorog mixture. Stir well and let sit for 10 minutes so the semolina swells and the mixture thickens."
        }
      },
      {
        "id": "line-dish-and-transfer-chocolate-casserole",
        "en": {
          "title": "Line the baking dish",
          "description": "Line the bottom and sides of a baking dish with parchment paper. Transfer the tvorog mixture into the dish and spread evenly with a spoon."
        }
      },
      {
        "id": "bake-casserole-chocolate-casserole",
        "en": {
          "title": "Bake the casserole",
          "description": "Place the dish in an oven preheated to 180°C and bake for 45 minutes."
        }
      }
