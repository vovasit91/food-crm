    "newCookingSteps": [
      {
        "id": "cut-carrots-carrot-casserole-with-cottage-cheese",
        "en": {
          "title": "Cut the carrots",
          "description": "Peel the carrots and cut them into 2 cm cubes."
        }
      },
      {
        "id": "boil-carrots-carrot-casserole-with-cottage-cheese",
        "en": {
          "title": "Boil the carrots",
          "description": "Place the carrot cubes in a pot and cover with water. Bring to a boil over high heat, then reduce to low and simmer for 10 minutes."
        }
      },
      {
        "id": "drain-mince-carrots-carrot-casserole-with-cottage-cheese",
        "en": {
          "title": "Drain and mince the carrots",
          "description": "Drain the carrots in a colander. Allow the water to drip off, then pass the carrots through a meat grinder or food processor."
        }
      },
      {
        "id": "heat-carrot-puree-carrot-casserole-with-cottage-cheese",
        "en": {
          "title": "Heat the carrot puree to remove moisture",
          "description": "Transfer the carrot puree back to the pot. Place over high heat, stir constantly, and heat briefly to evaporate excess moisture. Do not fry. Remove from heat."
        }
      },
      {
        "id": "add-semolina-carrot-casserole-with-cottage-cheese",
        "en": {
          "title": "Add the semolina",
          "description": "Sprinkle the semolina into the hot carrot puree in a thin stream while stirring continuously."
        }
      },
      {
        "id": "add-tvorog-carrot-casserole-with-cottage-cheese",
        "en": {
          "title": "Add the processed cottage cheese",
          "description": "Press the tvorog through a sieve or pass it through a meat grinder. Add it to the carrot and semolina mixture and stir to combine."
        }
      },
      {
        "id": "mix-eggs-sugar-salt-carrot-casserole-with-cottage-cheese",
        "en": {
          "title": "Mix in eggs, sugar, and salt",
          "description": "Add the eggs, sugar, and a pinch of salt to the carrot mixture. Stir until evenly incorporated."
        }
      },
      {
        "id": "preheat-oven-carrot-casserole-with-cottage-cheese",
        "en": {
          "title": "Preheat the oven to 180°C",
          "description": "Turn on the oven and set it to 180°C. Allow it to preheat fully before baking."
        }
      },
      {
        "id": "assemble-casserole-carrot-casserole-with-cottage-cheese",
        "en": {
          "title": "Assemble the casserole",
          "description": "Grease a baking dish with 5 g of butter and sprinkle with breadcrumbs. Spread the carrot mixture evenly in the dish. Dot the top with the remaining butter pieces."
        }
      },
      {
        "id": "bake-casserole-carrot-casserole-with-cottage-cheese",
        "en": {
          "title": "Bake the casserole",
          "description": "Place the dish in the preheated oven and bake at 180°C for 35–40 minutes, until golden and set. If using a deep dish, bake for 40 minutes."
        }
      }
    ],
