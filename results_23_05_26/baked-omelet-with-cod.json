    "newCookingSteps": [
      {
        "id": "preheat-oven-baked-omelet-with-cod",
        "en": {
          "title": "Preheat the oven",
          "description": "Set your oven to 180°C (350°F) and allow it to preheat fully before baking."
        }
      },
      {
        "id": "grate-and-cut-baked-omelet-with-cod",
        "en": {
          "title": "Grate cheese and carrot, slice onion and fish",
          "description": "Grate the cheese and carrot on a coarse grater. Slice the onion into quarter rings. Cut the cod fillet into pieces 2–2.5 cm wide."
        }
      },
      {
        "id": "beat-egg-mixture-baked-omelet-with-cod",
        "en": {
          "title": "Beat eggs with milk and salt",
          "description": "Crack the eggs into a bowl, add the milk and salt. Beat with a mixer on medium speed for 2–3 minutes until the mixture is fluffy and smooth."
        }
      },
      {
        "id": "grease-baking-dish-baked-omelet-with-cod",
        "en": {
          "title": "Grease the baking dish",
          "description": "Use 1 tablespoon of sunflower oil to lightly grease the baking dish."
        }
      },
      {
        "id": "heat-oil-in-skillet-baked-omelet-with-cod",
        "en": {
          "title": "Heat oil in a skillet",
          "description": "Pour the remaining sunflower oil into a skillet and heat over medium heat."
        }
      },
      {
        "id": "saute-onion-baked-omelet-with-cod",
        "en": {
          "title": "Sauté the onion",
          "description": "Add the sliced onion to the hot skillet and sauté, stirring occasionally, for 1–2 minutes until it turns light golden."
        }
      },
      {
        "id": "add-carrot-and-saute-baked-omelet-with-cod",
        "en": {
          "title": "Add carrot and continue sautéing",
          "description": "Add the grated carrot to the skillet. Cook, stirring frequently, for another 2–3 minutes until the carrot is lightly browned. Remove the skillet from the heat."
        }
      },
      {
        "id": "assemble-baked-omelet-with-cod",
        "en": {
          "title": "Layer the ingredients in the dish",
          "description": "Spread the sautéed vegetables evenly in the greased baking dish. Arrange the cod pieces on top. Pour the egg mixture evenly over the fish, then sprinkle with the grated cheese."
        }
      },
      {
        "id": "bake-omelet-with-cod",
        "en": {
          "title": "Bake the omelet with cod",
          "description": "Place the dish in the preheated oven and bake for 20–25 minutes until the omelet is set and golden brown on top."
        }
      }
    ],
