    "newCookingSteps": [
      {
        "id": "grate-zucchini-zucchini-breads-with-cheese",
        "en": {
          "title": "Grate the zucchini",
          "description": "Grate the zucchini finely. Sprinkle with salt and let sit for 10 minutes to draw out moisture."
        }
      },
      {
        "id": "squeeze-zucchini-zucchini-breads-with-cheese",
        "en": {
          "title": "Squeeze out the moisture",
          "description": "After the zucchini has rested, squeeze it firmly to remove as much liquid as possible. This is important for a crispy texture."
        }
      },
      {
        "id": "mix-eggs-seasonings-zucchini-breads-with-cheese",
        "en": {
          "title": "Add eggs and seasonings",
          "description": "Add the eggs, dried dill, and black pepper to the squeezed zucchini. Mix until well combined."
        }
      },
      {
        "id": "add-flour-mix-zucchini-breads-with-cheese",
        "en": {
          "title": "Add the flour",
          "description": "Gradually add the flour while mixing. The batter should become thick and stretchy. You may need slightly more or less flour."
        }
      },
      {
        "id": "prepare-baking-sheet-zucchini-breads-with-cheese",
        "en": {
          "title": "Prepare the baking sheet",
          "description": "Line a baking sheet with parchment paper and brush it with sunflower oil."
        }
      },
      {
        "id": "spread-batter-zucchini-breads-with-cheese",
        "en": {
          "title": "Spread the batter",
          "description": "Spread the batter onto the prepared baking sheet in a rectangular shape, no more than 1 cm thick."
        }
      },
      {
        "id": "preheat-oven-zucchini-breads-with-cheese",
        "en": {
          "title": "Preheat the oven",
          "description": "Preheat your oven to 220 °C (430 °F)."
        }
      },
      {
        "id": "bake-base-zucchini-breads-with-cheese",
        "en": {
          "title": "Bake the base",
          "description": "Bake the zucchini base for 30 minutes at 220 °C. The edges should become nicely browned and crispy."
        }
      },
      {
        "id": "grate-cheese-zucchini-breads-with-cheese",
        "en": {
          "title": "Grate the cheese",
          "description": "Finely grate the Parmesan cheese."
        }
      },
      {
        "id": "top-with-cheese-zucchini-breads-with-cheese",
        "en": {
          "title": "Top with cheese",
          "description": "Remove the baked base from the oven and sprinkle the grated Parmesan evenly over the top."
        }
      },
      {
        "id": "bake-with-cheese-zucchini-breads-with-cheese",
        "en": {
          "title": "Bake with cheese",
          "description": "Reduce the oven temperature to 180 °C (350 °F) and return the sheet to the oven. Bake for another 15 minutes until the cheese is melted and golden."
        }
      }
    ],
