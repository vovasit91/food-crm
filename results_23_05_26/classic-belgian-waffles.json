    "newCookingSteps": [
      {
        "id": "melt-butter-classic-belgian-waffles",
        "en": {
          "title": "Melt the butter",
          "description": "Place the butter in a microwave-safe bowl and melt it in short bursts of 10–15 seconds until fully melted."
        }
      },
      {
        "id": "heat-milk-classic-belgian-waffles",
        "en": {
          "title": "Heat the milk",
          "description": "Warm the milk in a small saucepan over medium heat until it is hot but not boiling. Remove from heat immediately."
        }
      },
      {
        "id": "combine-butter-and-milk-classic-belgian-waffles",
        "en": {
          "title": "Combine butter and milk",
          "description": "Pour the warm milk into the melted butter and stir to combine."
        }
      },
      {
        "id": "beat-eggs-classic-belgian-waffles",
        "en": {
          "title": "Beat the eggs",
          "description": "Crack the eggs into a separate bowl and whisk them until the yolks and whites are fully blended."
        }
      },
      {
        "id": "add-eggs-to-mixture-classic-belgian-waffles",
        "en": {
          "title": "Add eggs to the mixture",
          "description": "While stirring the butter-milk mixture actively, slowly pour in the beaten eggs until incorporated."
        }
      },
      {
        "id": "add-flour-gradually-classic-belgian-waffles",
        "en": {
          "title": "Add flour gradually",
          "description": "Sift the flour into the mixture in small portions, stirring thoroughly after each addition to avoid lumps."
        }
      },
      {
        "id": "place-batter-on-low-heat-classic-belgian-waffles",
        "en": {
          "title": "Place batter on low heat",
          "description": "Set the saucepan with the batter over the lowest possible heat on the stove."
        }
      },
      {
        "id": "add-sparkling-water-salt-sugar-classic-belgian-waffles",
        "en": {
          "title": "Add sparkling water, salt, and sugar",
          "description": "Pour in the sparkling water, then add the salt and sugar. Stir everything together until evenly mixed, then remove the pan from the heat."
        }
      },
      {
        "id": "remove-from-heat-classic-belgian-waffles",
        "en": {
          "title": "Remove from heat",
          "description": "Take the saucepan off the stove."
        }
      },
      {
        "id": "add-yeast-classic-belgian-waffles",
        "en": {
          "title": "Add yeast",
          "description": "Sprinkle the dry yeast over the warm batter and stir thoroughly to distribute it evenly."
        }
      },
      {
        "id": "let-dough-rise-classic-belgian-waffles",
        "en": {
          "title": "Let dough rise",
          "description": "Cover the bowl with a clean cloth and leave it in a warm, draft‑free place for 40 minutes, until the batter has doubled in volume and becomes bubbly."
        }
      },
      {
        "id": "preheat-waffle-iron-classic-belgian-waffles",
        "en": {
          "title": "Preheat the waffle iron",
          "description": "Turn on your waffle iron and let it heat up until it reaches the desired temperature (usually indicated by a light). This takes about 5 minutes."
        }
      },
      {
        "id": "grease-waffle-iron-classic-belgian-waffles",
        "en": {
          "title": "Grease the waffle iron",
          "description": "Lightly brush the waffle plates with vegetable oil to prevent sticking."
        }
      },
      {
        "id": "pour-batter-and-cook-classic-belgian-waffles",
        "en": {
          "title": "Cook the waffles",
          "description": "Ladle a small amount of batter onto the hot waffle iron, close the lid, and cook until the waffle is golden brown and crisp. Repeat with the remaining batter."
        }
      },
      {
        "id": "trim-edges-classic-belgian-waffles",
        "en": {
          "title": "Trim the edges",
          "description": "Once each waffle is cooked, remove it carefully and use a knife to cut off any uneven or crisp edges for a neat appearance."
        }
      }
