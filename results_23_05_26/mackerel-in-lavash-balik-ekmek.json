    "newCookingSteps": [
      {
        "id": "prepare-fish-mackerel-in-lavash-balik-ekmek",
        "en": {
          "title": "Prepare the mackerel",
          "description": "Remove the head and tail from the fish. Remove the thin membrane from the body. Cut open the belly along the length, remove the innards and large bones. You should get two large fillets. Rinse them and pat dry with paper towels."
        }
      },
      {
        "id": "prepare-marinade-mackerel-in-lavash-balik-ekmek",
        "en": {
          "title": "Prepare the marinade",
          "description": "In a small bowl, mix together olive oil, soy sauce, lemon juice, and mustard. Set aside half of the marinade for later."
        }
      },
      {
        "id": "marinate-fish-mackerel-in-lavash-balik-ekmek",
        "en": {
          "title": "Marinate the fish",
          "description": "Brush the mackerel fillets with half of the marinade. Season with salt, black pepper, and dried thyme. Let the fish marinate for 10 minutes."
        }
      },
      {
        "id": "preheat-grill-pan-mackerel-in-lavash-balik-ekmek",
        "en": {
          "title": "Preheat the grill pan",
          "description": "Place a grill pan over medium heat and let it get hot."
        }
      },
      {
        "id": "grill-fish-mackerel-in-lavash-balik-ekmek",
        "en": {
          "title": "Grill the mackerel fillets",
          "description": "Place the marinated fillets on the hot grill pan. Cook for 3 minutes on each side, until golden and cooked through."
        }
      },
      {
        "id": "assemble-wraps-mackerel-in-lavash-balik-ekmek",
        "en": {
          "title": "Assemble the wraps",
          "description": "Slice the red onion into half-rings and the tomatoes into rounds. Cut the lavash sheet in half. Brush each half with the reserved marinade. Layer the tomatoes, then the onions, and finally one grilled fish fillet on each lavash half."
        }
      },
      {
        "id": "grill-wraps-mackerel-in-lavash-balik-ekmek",
        "en": {
          "title": "Grill the wraps",
          "description": "Fold the edges of the lavash inward and roll it up tightly. Place the wraps seam-side down on the grill pan. Cook over medium heat for 1–2 minutes on each side, until the lavash is lightly golden and crisp."
        }
      },
      {
        "id": "make-yogurt-sauce-mackerel-in-lavash-balik-ekmek",
        "en": {
          "title": "Make the yogurt sauce",
          "description": "Press the garlic clove through a press. Mix it with yogurt, salt, and black pepper. Serve the sauce alongside the wraps."
        }
      }
    ],
