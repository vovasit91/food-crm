        "en": {
          "title": "Prepare the sweet potato",
          "description": "Cut the sweet potato in half lengthwise. Score the cut sides in several places. Place the halves cut-side up in a baking dish and brush with 0.5 teaspoon of olive oil."
        }
      },
      {
        "id": "bake-sweet-potato-sweet-potato-chickpea-boat",
        "en": {
          "title": "Bake the sweet potato",
          "description": "Bake the sweet potato until tender, about 30–40 minutes, depending on your oven. Check with a fork; it should be soft."
        }
      },
      {
        "id": "make-chickpea-filling-sweet-potato-chickpea-boat",
        "en": {
          "title": "Make the chickpea filling",
          "description": "Place the canned chickpeas in a bowl and blend with an immersion blender until smooth. Add the remaining olive oil, lemon juice, salt, black pepper, turmeric, and paprika. Blend again until fully combined and creamy."
        }
      },
      {
        "id": "fill-sweet-potato-boat-sweet-potato-chickpea-boat",
        "en": {
          "title": "Fill the sweet potato boats",
          "description": "Transfer the baked sweet potato halves to a plate. Use a spoon to press down the centers, creating a boat shape. Distribute the chickpea mixture evenly into the indentations."
        }
      },
      {
        "id": "top-with-avocado-sweet-potato-chickpea-boat",
        "en": {
          "title": "Top with avocado and serve",
          "description": "Peel the avocado and remove the pit. Cut the flesh into half-round slices. Arrange the slices on top of the filled sweet potato boats and serve immediately."
        }
      }
