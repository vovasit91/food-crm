    "newCookingSteps": [
      {
        "id": "prepare-marinade-chicken-in-caramel-sauce",
        "en": {
          "title": "Prepare the marinade",
          "description": "In a bowl, combine honey, soy sauce, and white wine vinegar. Whisk together. Add brown sugar, black pepper, and chicken spices. Whisk until smooth."
        }
      },
      {
        "id": "marinate-chicken-chicken-in-caramel-sauce",
        "en": {
          "title": "Marinate the chicken",
          "description": "Brush the chicken all over with the marinade, including the cavity. Let it marinate at room temperature for at least 1 hour."
        }
      },
      {
        "id": "preheat-and-prepare-baking-dish-chicken-in-caramel-sauce",
        "en": {
          "title": "Preheat oven and prepare dish",
          "description": "Preheat the oven to 180°C (350°F). Grease a baking dish with vegetable oil. Place the chicken breast-side up. Pour the remaining marinade over the chicken, reserving 2–3 tablespoons for basting."
        }
      },
      {
        "id": "bake-chicken-chicken-in-caramel-sauce",
        "en": {
          "title": "Bake the chicken",
          "description": "Place the dish in the oven and bake for 1.5 hours. Every 15–20 minutes, baste the chicken with the accumulated juices and reserved marinade. Turn the chicken over 3–4 times. During the last basting, remove any foil from the wings and legs so they brown."
        }
      },
      {
        "id": "rest-and-serve-chicken-in-caramel-sauce",
        "en": {
          "title": "Rest and serve",
          "description": "Remove the chicken from the oven, pour the pan juices over it. Let it cool slightly, then carefully transfer to a serving platter."
        }
      }
    ],
