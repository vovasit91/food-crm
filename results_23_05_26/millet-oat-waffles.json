    "newCookingSteps": [
      {
        "id": "grind-flakes-millet-oat-waffles",
        "en": {
          "title": "Grind the flakes",
          "description": "Grind the wheat and oat flakes in a coffee grinder or blender until they become a fine powder."
        }
      },
      {
        "id": "combine-dry-millet-oat-waffles",
        "en": {
          "title": "Combine dry ingredients",
          "description": "In a large bowl, mix the ground flakes with whole wheat flour, baking powder, baking soda, salt, and cinnamon. Whisk to combine."
        }
      },
      {
        "id": "mash-banana-mix-wet-millet-oat-waffles",
        "en": {
          "title": "Mash banana and mix wet ingredients",
          "description": "Mash the banana into a puree. Add milk, vegetable oil, and vanilla extract. Whisk again until smooth."
        }
      },
      {
        "id": "combine-wet-dry-millet-oat-waffles",
        "en": {
          "title": "Combine wet and dry mixtures",
          "description": "Pour the wet mixture into the bowl with the dry ingredients. Stir with a whisk or silicone spatula until just combined. The batter should be like liquid sour cream. If too thick, add 1 tablespoon of water and mix again."
        }
      },
      {
        "id": "rest-batter-millet-oat-waffles",
        "en": {
          "title": "Rest the batter",
          "description": "Let the batter rest for 10 minutes. This allows the grains to hydrate and the batter to thicken slightly."
        }
      },
      {
        "id": "preheat-oven-millet-oat-waffles",
        "en": {
          "title": "Preheat the oven",
          "description": "Preheat your oven to 180°C (350°F) while the batter rests."
        }
      },
      {
        "id": "pour-batter-into-forms-millet-oat-waffles",
        "en": {
          "title": "Pour batter into waffle forms",
          "description": "Divide the batter into greased waffle baking forms or a waffle iron. Spread evenly."
        }
      },
      {
        "id": "bake-waffles-millet-oat-waffles",
        "en": {
          "title": "Bake the waffles",
          "description": "Bake the waffles in the preheated oven for 10-15 minutes until golden brown and cooked through. The exact time depends on your oven and forms."
        }
      }
    ],
