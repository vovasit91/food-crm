    "newCookingSteps": [
      {
        "id": "boil-eggs-quiche-with-cabbage-and-eggs",
        "en": {
          "title": "Boil the eggs",
          "description": "Place the eggs in a saucepan, cover with water, and bring to a boil. Cook for 8–10 minutes, then cool, peel, and halve each egg."
        }
      },
      {
        "id": "grind-bran-and-flax-quiche-with-cabbage-and-eggs",
        "en": {
          "title": "Grind bran and flax seeds",
          "description": "Use a blender or coffee grinder to process the rye bran and flax seeds into a fine crumb. Transfer to a deep bowl."
        }
      },
      {
        "id": "mix-dry-ingredients-quiche-with-cabbage-and-eggs",
        "en": {
          "title": "Mix dry ingredients",
          "description": "Add sifted wheat flour, baking powder, and a pinch of salt to the ground bran and flax. Stir to combine."
        }
      },
      {
        "id": "mix-wet-ingredients-quiche-with-cabbage-and-eggs",
        "en": {
          "title": "Mix wet ingredients",
          "description": "In a separate bowl, whisk together the sunflower oil, yogurt, and boiling water."
        }
      },
      {
        "id": "combine-and-knead-dough-quiche-with-cabbage-and-eggs",
        "en": {
          "title": "Combine and knead the dough",
          "description": "Pour the wet mixture into the dry ingredients. Knead until you have a smooth, non-sticky dough."
        }
      },
      {
        "id": "rest-dough-quiche-with-cabbage-and-eggs",
        "en": {
          "title": "Rest the dough",
          "description": "Cover the dough with a towel or plastic wrap and let it rest for 30 minutes."
        }
      },
      {
        "id": "prep-vegetables-quiche-with-cabbage-and-eggs",
        "en": {
          "title": "Prepare vegetables and cheese",
          "description": "Shred the cabbage, finely chop the dill, and coarsely grate the hard cheese."
        }
      },
      {
        "id": "saute-cabbage-quiche-with-cabbage-and-eggs",
        "en": {
          "title": "Sauté the cabbage",
          "description": "Melt butter in a frying pan over medium heat. Add the cabbage and cook for about 10 minutes until soft. Remove from heat and let cool."
        }
      },
      {
        "id": "mix-filling-quiche-with-cabbage-and-eggs",
        "en": {
          "title": "Mix the filling",
          "description": "Combine the cooked cabbage with dill, grated cheese, salt, and pepper. Stir well."
        }
      },
      {
        "id": "preheat-oven-quiche-with-cabbage-and-eggs",
        "en": {
          "title": "Preheat the oven",
          "description": "Preheat your oven to 200°C (400°F)."
        }
      },
      {
        "id": "roll-dough-quiche-with-cabbage-and-eggs",
        "en": {
          "title": "Roll out the dough",
          "description": "Roll the rested dough into a circle about 5 mm thick. Transfer it to a tart pan, pressing it into the bottom and up the sides. Prick the base with a fork."
        }
      },
      {
        "id": "blind-bake-crust-quiche-with-cabbage-and-eggs",
        "en": {
          "title": "Blind bake the crust",
          "description": "Place the pan in the preheated oven and bake the crust for 10 minutes."
        }
      },
      {
        "id": "assemble-quiche-quiche-with-cabbage-and-eggs",
        "en": {
          "title": "Assemble the quiche",
          "description": "Remove the partially baked crust from the oven. Spread the cabbage filling evenly over the crust, then arrange the halved boiled eggs on top, cut side up."
        }
      },
      {
        "id": "make-custard-quiche-with-cabbage-and-eggs",
        "en": {
          "title": "Make the custard",
          "description": "In a bowl, whisk together one raw egg, the yogurt, and sour cream until smooth. Pour this mixture over the filling."
        }
      },
      {
        "id": "bake-final-quiche-with-cabbage-and-eggs",
        "en": {
          "title": "Bake the quiche",
          "description": "Return the pan to the oven, reduce the temperature to 180°C (350°F), and bake for 20–25 minutes until the custard is set and the top is light golden."
        }
      }
    ],
