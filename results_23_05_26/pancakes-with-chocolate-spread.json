        "en": {
          "title": "Melt the butter",
          "description": "Melt the butter in a microwave in short bursts of 10-15 seconds until fully melted."
        }
      },
      {
        "id": "add-sugar-and-egg-pancakes-with-chocolate-spread",
        "en": {
          "title": "Add vanilla sugar and egg",
          "description": "Add the vanilla sugar and the egg to the melted butter. Mix until well combined."
        }
      },
      {
        "id": "add-milk-pancakes-with-chocolate-spread",
        "en": {
          "title": "Add milk",
          "description": "Pour in the milk and stir until the mixture is smooth and homogeneous."
        }
      },
      {
        "id": "make-batter-pancakes-with-chocolate-spread",
        "en": {
          "title": "Make the pancake batter",
          "description": "Combine the flour and baking powder, then sift them into the wet mixture. Mix until you get a thick but flowing batter that easily drips off the ladle."
        }
      },
      {
        "id": "heat-pan-pancakes-with-chocolate-spread",
        "en": {
          "title": "Heat the pan",
          "description": "Place a non-stick pan over medium heat and let it warm up."
        }
      },
      {
        "id": "fill-and-fry-pancakes-pancakes-with-chocolate-spread",
        "en": {
          "title": "Fill and fry the pancakes",
          "description": "Pour a ladle of batter into the center of the pan. Quickly pipe a small amount of chocolate paste onto the batter. Cover the paste with a thin layer of batter. Fry on low heat with the lid on for 3-4 minutes per side. Repeat with the remaining batter."
        }
      }
