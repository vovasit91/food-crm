      {
        "id": "season-chicken-egg-pancakes-with-chicken",
        "en": {
          "title": "Season the chicken",
          "description": "Rub the chicken thighs with salt and spices on all sides."
        }
      },
      {
        "id": "bake-chicken-egg-pancakes-with-chicken",
        "en": {
          "title": "Bake the chicken",
          "description": "Place the seasoned chicken in a parchment-lined baking dish and bake at 180°C until fully cooked, about 30 minutes."
        }
      },
      {
        "id": "whisk-egg-mixture-egg-pancakes-with-chicken",
        "en": {
          "title": "Whisk the egg mixture",
          "description": "In a bowl, beat 1 egg with 1 tablespoon of milk and a pinch of salt until smooth."
        }
      },
      {
        "id": "cook-pancake-egg-pancakes-with-chicken",
        "en": {
          "title": "Cook the egg pancake",
          "description": "Pour the egg mixture into a hot oiled frying pan, spread it thinly, and fry on both sides until golden. Transfer to a plate."
        }
      },
      {
        "id": "saute-mushrooms-egg-pancakes-with-chicken",
        "en": {
          "title": "Sauté the mushrooms",
          "description": "Finely chop the mushrooms. Heat oil in a clean pan and sauté the mushrooms, stirring occasionally, until all liquid evaporates and they turn golden brown."
        }
      },
      {
        "id": "prepare-chicken-filling-egg-pancakes-with-chicken",
        "en": {
          "title": "Prepare the chicken filling",
          "description": "Remove the baked chicken from the bones, cut it into small cubes, and mix with the sautéed mushrooms."
        }
      },
      {
        "id": "assemble-pancakes-egg-pancakes-with-chicken",
        "en": {
          "title": "Assemble the pancakes",
          "description": "Place the chicken-mushroom filling in the center of the egg pancake. Fold the top and bottom edges over the filling, then fold the sides to form an envelope."
        }
      }
    ],
