    "newCookingSteps": [
      {
        "id": "prep-vegetables-okonomiyaki",
        "en": {
          "title": "Grate and shred the vegetables",
          "description": "Finely grate the potato and carrot into a bowl. Shred the cabbage, bell pepper, and pickled ginger, and add them to the same bowl."
        }
      },
      {
        "id": "make-batter-okonomiyaki",
        "en": {
          "title": "Mix the batter",
          "description": "Crack the eggs into the bowl with the vegetables, add soy sauce, and mix well. Gradually add the flour while stirring continuously until a thick batter forms."
        }
      },
      {
        "id": "cook-first-side-first-patty-okonomiyaki",
        "en": {
          "title": "Cook the first patty, first side",
          "description": "Grease a frying pan with sunflower oil and heat over medium heat. Form half of the batter into a flat, round patty about 1 cm thick and 12–15 cm in diameter. Place it in the pan, cover with a lid, and cook for 12–15 minutes until the bottom is golden and crispy."
        }
      },
      {
        "id": "cook-second-side-first-patty-okonomiyaki",
        "en": {
          "title": "Flip and cook the first patty, second side",
          "description": "Flip the patty carefully, cover again, and cook for another 10–12 minutes. Transfer the cooked patty to a plate."
        }
      },
      {
        "id": "cook-first-side-second-patty-okonomiyaki",
        "en": {
          "title": "Cook the second patty, first side",
          "description": "Using the remaining batter, form another patty of the same size. Place it in the hot pan, cover, and cook for 12–15 minutes on the first side."
        }
      },
      {
        "id": "cook-second-side-second-patty-okonomiyaki",
        "en": {
          "title": "Flip and cook the second patty, second side",
          "description": "Flip the second patty, cover, and cook for 10–12 minutes. Remove to the plate and serve."
        }
      }
    ],
