    "newCookingSteps": [
      {
        "id": "slice-and-arrange-potatoes-potato-tacos",
        "en": {
          "title": "Slice and arrange potatoes",
          "description": "Slice the potatoes into thin rounds. Pat them dry with a paper towel, then arrange on a parchment-lined baking sheet in a single layer, slightly overlapping, to form two rectangular sheets."
        }
      },
      {
        "id": "preheat-oven-potato-tacos",
        "en": {
          "title": "Preheat the oven",
          "description": "Set your oven to 200°C (400°F) and let it preheat completely."
        }
      },
      {
        "id": "grate-cheese-and-sprinkle-potato-tacos",
        "en": {
          "title": "Grate cheese and sprinkle over potatoes",
          "description": "Coarsely grate the hard cheese and distribute it evenly over the potato slices."
        }
      },
      {
        "id": "bake-potatoes-potato-tacos",
        "en": {
          "title": "Bake the potato base",
          "description": "Place the baking sheet in the preheated oven and bake for 15 minutes, until the potatoes are tender and the cheese is melted and golden."
        }
      },
      {
        "id": "salt-cucumbers-and-rest-potato-tacos",
        "en": {
          "title": "Salt cucumbers and let rest",
          "description": "Grate the cucumber coarsely, sprinkle with salt, and let it sit for 5 minutes to draw out excess moisture."
        }
      },
      {
        "id": "squeeze-cucumber-potato-tacos",
        "en": {
          "title": "Squeeze cucumber dry",
          "description": "After resting, squeeze the grated cucumber firmly to remove as much liquid as possible."
        }
      },
      {
        "id": "make-yogurt-sauce-potato-tacos",
        "en": {
          "title": "Make the yogurt sauce",
          "description": "Press the garlic through a press and chop the dill. In a bowl, combine the yogurt, squeezed cucumber, garlic, dill, lemon juice, lemon zest, and salt. Mix well."
        }
      },
      {
        "id": "assemble-base-potato-tacos",
        "en": {
          "title": "Assemble the base",
          "description": "Spread a thick layer of the yogurt sauce over one half of each baked potato sheet. Top the saucy half with arugula."
        }
      },
      {
        "id": "add-toppings-potato-tacos",
        "en": {
          "title": "Add toppings",
          "description": "Slice the tomato into rounds and arrange over the arugula. Halve the avocado, remove the pit and skin, slice the flesh, and place on the tomatoes. Cut the salmon into strips and lay them on top."
        }
      }
    ],
