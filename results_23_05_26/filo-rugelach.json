    "newCookingSteps": [
      {
        "id": "mash-egg-tvorog-filo-rugelach",
        "en": {
          "title": "Mash cottage cheese with egg",
          "description": "Mash the tvorog with a fork until smooth. Crack the egg into the tvorog and mix until combined."
        }
      },
      {
        "id": "chop-spinach-mix-filo-rugelach",
        "en": {
          "title": "Chop spinach and mix with filling",
          "description": "Finely chop the spinach and add it to the tvorog-egg mixture. Stir thoroughly until evenly distributed."
        }
      },
      {
        "id": "melt-butter-filo-rugelach",
        "en": {
          "title": "Melt butter in microwave",
          "description": "Place the butter in a microwave-safe bowl and melt it in 10-second bursts, stirring between each burst to prevent burning and ensure even melting."
        }
      },
      {
        "id": "lay-brush-filo-filo-rugelach",
        "en": {
          "title": "Lay out filo and brush with butter",
          "description": "Place one sheet of filo dough on a clean work surface. Using a pastry brush, coat the entire sheet evenly with melted butter."
        }
      },
      {
        "id": "shape-filo-fan-filo-rugelach",
        "en": {
          "title": "Shape filo into a fan",
          "description": "Gather the buttered filo into a loose accordion pleat, then fold it in half. Join the ends to form a fan-like shape and overlap the joined sides slightly."
        }
      },
      {
        "id": "add-filling-filo-rugelach",
        "en": {
          "title": "Add filling to filo fan",
          "description": "Divide the tvorog mixture into as many portions as you have filo sheets. Spoon one portion onto the wide part of the filo fan."
        }
      },
      {
        "id": "roll-rugelach-filo-rugelach",
        "en": {
          "title": "Roll and seal rugelach",
          "description": "Starting from the wide end, roll the filo into a rugelach shape. Twist the ends slightly to secure the roll so it doesn’t unwind."
        }
      },
      {
        "id": "preheat-oven-filo-rugelach",
        "en": {
          "title": "Preheat oven to 180°C",
          "description": "Set your oven to 180°C (350°F) and allow it to fully preheat before baking."
        }
      },
      {
        "id": "assemble-tray-filo-rugelach",
        "en": {
          "title": "Arrange rugelach on baking tray",
          "description": "Line a baking tray with parchment paper. Place the rugelach on the tray, leaving some space between them. Brush the tops with beaten egg and sprinkle with sesame seeds."
        }
      },
      {
        "id": "bake-filo-rugelach",
        "en": {
          "title": "Bake until golden",
          "description": "Transfer the tray to the preheated oven and bake for 15–20 minutes, or until the rugelach are golden brown and crisp."
        }
      }
