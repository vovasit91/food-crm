      },
      {
        "id": "combine-ingredients-chicken-draniki",
        "en": {
          "title": "Combine base ingredients",
          "description": "In a mixing bowl, combine the grated potatoes, chopped chicken, and diced onion. Crack an egg into the bowl. Add salt and black pepper to taste. Mix until well combined."
        }
      },
      {
        "id": "add-mayo-flour-chicken-draniki",
        "en": {
          "title": "Add mayonnaise and flour",
          "description": "Add mayonnaise for moisture and flour to bind the mixture. Stir thoroughly until the batter is homogeneous and holds together."
        }
      },
      {
        "id": "fry-pancakes-chicken-draniki",
        "en": {
          "title": "Fry the pancakes",
          "description": "Heat a frying pan with vegetable oil over medium-high heat. Drop spoonfuls of batter onto the pan, flattening into small pancakes. Fry until golden brown on the bottom, then flip and cook until the other side is golden. Transfer to paper towels to absorb excess oil."
        }
      }
