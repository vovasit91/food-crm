    "newCookingSteps": [
      {
        "id": "soak-lentils-lentil-pancakes",
        "en": {
          "title": "Soak the lentils",
          "description": "Rinse the red lentils and place them in a bowl. Cover with water and let them soak at room temperature for 3 hours. Drain the water afterward."
        }
      },
      {
        "id": "drain-blender-lentil-pancakes",
        "en": {
          "title": "Prepare the blender",
          "description": "Drain the soaked lentils and transfer them to the blender jar. Measure the remaining water (150 ml) and add it to the blender with the lentils."
        }
      },
      {
        "id": "blend-lentils-lentil-pancakes",
        "en": {
          "title": "Blend until smooth",
          "description": "Blend the lentils and water for 3–4 minutes until you get a smooth, frothy puree similar to foam."
        }
      },
      {
        "id": "add-seasoning-lentil-pancakes",
        "en": {
          "title": "Add spices and mix",
          "description": "Add the salt, black pepper, paprika, and Italian herbs to the lentil puree. Stir well to combine."
        }
      },
      {
        "id": "heat-pan-lentil-pancakes",
        "en": {
          "title": "Heat the pan with oil",
          "description": "Place a non-stick pan over medium heat and lightly grease it with sunflower oil using a brush or paper towel."
        }
      },
      {
        "id": "fry-pancakes-lentil-pancakes",
        "en": {
          "title": "Cook the pancakes",
          "description": "Pour a small ladle of the lentil batter onto the hot pan and spread it thinly. Cook for 1–2 minutes on one side until set, then flip and cook for about 1 minute on the other side until golden. Transfer to a plate and repeat with the remaining batter."
        }
      }
    ],
