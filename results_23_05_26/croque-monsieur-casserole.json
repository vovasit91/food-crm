    "newCookingSteps": [
      {
        "id": "preheat-oven-croque-monsieur-casserole",
        "en": {
          "title": "Preheat oven to 150°C",
          "description": "Set your oven to 150°C (300°F) so it's ready when you need it."
        }
      },
      {
        "id": "prep-ingredients-croque-monsieur-casserole",
        "en": {
          "title": "Grate cheese and cut meat and bread",
          "description": "Grate the hard cheese. Cut the carbonade into 3-4 pieces. Cut the bread into 2.5 cm cubes."
        }
      },
      {
        "id": "toast-bread-croque-monsieur-casserole",
        "en": {
          "title": "Toast the bread cubes",
          "description": "Spread the bread cubes in a single layer on a baking sheet. Bake at 150°C for 10-15 minutes until dry and lightly golden."
        }
      },
      {
        "id": "transfer-bread-croque-monsieur-casserole",
        "en": {
          "title": "Transfer bread to a bowl",
          "description": "Remove the toasted bread from the baking sheet and place it in a large bowl."
        }
      },
      {
        "id": "make-egg-mixture-and-soak-croque-monsieur-casserole",
        "en": {
          "title": "Make egg mixture and soak bread",
          "description": "In a separate bowl, whisk together eggs, cream, mustard, salt, and pepper. Pour this mixture over the toasted bread and let it soak for 10 minutes."
        }
      },
      {
        "id": "prepare-dish-croque-monsieur-casserole",
        "en": {
          "title": "Increase oven and grease dish",
          "description": "Raise the oven temperature to 180°C (350°F). Grease a baking dish with 20g of butter."
        }
      },
      {
        "id": "layer-casserole-croque-monsieur-casserole",
        "en": {
          "title": "Layer the casserole",
          "description": "Spread half the soaked bread in the dish. Top with half the grated cheese and half the carbonade. Repeat with remaining bread, then the rest of the carbonade, and most of the remaining cheese."
        }
      },
      {
        "id": "bake-casserole-first-croque-monsieur-casserole",
        "en": {
          "title": "Bake the casserole",
          "description": "Bake at 180°C for 30-40 minutes until the cheese is melted and the casserole is set."
        }
      },
      {
        "id": "make-roux-croque-monsieur-casserole",
        "en": {
          "title": "Make the roux",
          "description": "In a saucepan, melt 80g of butter over medium heat. Add the flour and cook, stirring constantly, for about 2 minutes until the mixture turns golden and smells nutty."
        }
      },
      {
        "id": "finish-bechamel-croque-monsieur-casserole",
        "en": {
          "title": "Finish the bechamel sauce",
          "description": "Gradually whisk in the warm milk. Cook, stirring, until the sauce comes to a boil and thickens. Season with salt, pepper, and nutmeg. Simmer for 2 minutes, then remove from heat."
        }
      },
      {
        "id": "final-bake-croque-monsieur-casserole",
        "en": {
          "title": "Top with sauce and finish baking",
          "description": "Increase oven to 210-220°C (410-430°F). Pour the bechamel sauce over the casserole, sprinkle with remaining cheese, and bake for 2-3 minutes until golden and bubbly."
        }
      }
    ],
