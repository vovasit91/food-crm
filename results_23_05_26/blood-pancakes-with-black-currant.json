        "en": {
          "title": "Add blood and some milk",
          "description": "Add 150 ml of pork blood and 100 ml of milk to the beaten eggs. Mix until combined."
        }
      },
      {
        "id": "add-butter-and-honey-blood-pancakes-with-black-currant",
        "en": {
          "title": "Add butter and honey",
          "description": "Add the softened butter and honey to the liquid mixture. Stir well."
        }
      },
      {
        "id": "add-dry-ingredients-blood-pancakes-with-black-currant",
        "en": {
          "title": "Add dry ingredients",
          "description": "Pour the sifted dry ingredients (including the finely chopped onion) into the liquid mixture. Mix until smooth."
        }
      },
      {
        "id": "add-remaining-milk-blood-pancakes-with-black-currant",
        "en": {
          "title": "Add remaining milk",
          "description": "Add the remaining 150 ml of milk and stir again until you have a thin, smooth batter."
        }
      },
      {
        "id": "heat-pan-blood-pancakes-with-black-currant",
        "en": {
          "title": "Heat the pan",
          "description": "Place a frying pan over high heat, then reduce to medium. Lightly grease the pan with vegetable oil using a brush."
        }
      },
      {
        "id": "fry-pancakes-blood-pancakes-with-black-currant",
        "en": {
          "title": "Fry the pancakes",
          "description": "Pour a ladle of batter into the pan and cook until the bottom is golden brown. Flip and cook the other side until browned. Repeat with remaining batter."
        }
      },
      {
        "id": "mix-currants-and-sugar-blood-pancakes-with-black-currant",
