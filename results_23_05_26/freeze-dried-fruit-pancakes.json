    "newCookingSteps": [
      {
        "id": "melt-butter-freeze-dried-fruit-pancakes",
        "en": {
          "title": "Melt the butter",
          "description": "Place the butter in a microwave-safe bowl and melt it in the microwave."
        }
      },
      {
        "id": "heat-cream-freeze-dried-fruit-pancakes",
        "en": {
          "title": "Heat the cream with vanilla sugar",
          "description": "Pour the cream into a small saucepan, add the vanilla sugar, and stir. Place over medium heat and warm through, but do not let it boil."
        }
      },
      {
        "id": "cool-cream-freeze-dried-fruit-pancakes",
        "en": {
          "title": "Let the cream cool slightly",
          "description": "Remove the saucepan from the heat and allow the cream to cool for about 2 minutes, so it is warm but not hot."
        }
      },
      {
        "id": "mix-wet-ingredients-freeze-dried-fruit-pancakes",
        "en": {
          "title": "Mix the wet ingredients",
          "description": "Crack the egg into a deep bowl. Pour in the warm cream and melted butter, then add the sugar. Whisk until smooth and well combined."
        }
      },
      {
        "id": "mix-dry-ingredients-freeze-dried-fruit-pancakes",
        "en": {
          "title": "Mix the dry ingredients",
          "description": "In a separate clean bowl, combine the flour, salt, and baking powder. Stir together."
        }
      },
      {
        "id": "combine-batter-freeze-dried-fruit-pancakes",
        "en": {
          "title": "Combine and add fruit",
          "description": "Pour the dry mixture into the wet ingredients. Mix until a thick, slightly runny batter forms. Fold in the freeze-dried strawberries until evenly distributed."
        }
      },
      {
        "id": "fry-pancakes-freeze-dried-fruit-pancakes",
        "en": {
          "title": "Fry the pancakes",
          "description": "Heat a dry non-stick frying pan over medium heat. Drop spoonfuls of batter (about 2 tablespoons per pancake) to form rounds. Cook for 2–3 minutes until the surface bubbles and sets. Flip and cook the other side for 1–2 minutes. Transfer to a plate and repeat with the remaining batter."
        }
      }
    ],
