      },
      {
        "id": "marinate-chicken-chicken-with-prunes-in-creamy-sauce",
        "en": {
          "title": "Marinate the chicken",
          "description": "Let the chicken marinate at room temperature for 2–3 hours, or refrigerate for longer."
        }
      },
      {
        "id": "fry-chicken-chicken-with-prunes-in-creamy-sauce",
        "en": {
          "title": "Fry the chicken",
          "description": "Heat 1 tablespoon of vegetable oil in a deep skillet over high heat. Fry the chicken pieces for 3–4 minutes per side until golden brown, then transfer to a plate."
        }
      },
      {
        "id": "chop-onion-and-grate-carrot-chicken-with-prunes-in-creamy-sauce",
        "en": {
          "title": "Chop onion and grate carrot",
          "description": "Finely chop the onion. Peel and grate the carrot on a medium grater."
        }
      },
      {
        "id": "heat-oil-for-vegetables-chicken-with-prunes-in-creamy-sauce",
        "en": {
          "title": "Heat oil for the vegetables",
          "description": "Add another tablespoon of vegetable oil to the skillet and heat over medium heat."
        }
      },
      {
        "id": "saute-vegetables-chicken-with-prunes-in-creamy-sauce",
        "en": {
          "title": "Sauté the vegetables",
          "description": "Add the onion and carrot to the hot oil. Cook over medium heat for 5 minutes, stirring frequently, until softened."
        }
      },
      {
        "id": "add-chicken-and-water-chicken-with-prunes-in-creamy-sauce",
        "en": {
          "title": "Add chicken and water",
          "description": "Return the fried chicken to the skillet and stir to combine with the vegetables. Pour in the water and bring to a simmer."
        }
      },
      {
        "id": "braise-chicken-with-vegetables-chicken-with-prunes-in-creamy-sauce",
        "en": {
          "title": "Braise the chicken with vegetables",
          "description": "Cover the skillet with a lid and simmer over low heat for 30 minutes, until the chicken is tender."
        }
      },
      {
        "id": "add-sour-cream-and-prunes-chicken-with-prunes-in-creamy-sauce",
        "en": {
          "title": "Add sour cream and prunes",
          "description": "Add the sour cream and prunes to the skillet and stir well to combine with the sauce."
        }
      },
      {
        "id": "braise-with-cream-chicken-with-prunes-in-creamy-sauce",
        "en": {
          "title": "Finish braising with cream",
          "description": "Cover and continue cooking over low heat for 20–30 minutes, until the sauce thickens slightly and the flavors meld."
        }
      }
