    "newCookingSteps": [
      {
        "id": "slice-filling-cheese-roll",
        "en": {
          "title": "Slice the filling ingredients",
          "description": "Slice the cooked sausage, pepperoni, and cherry tomatoes into rounds. Slice the onion into half-rings and tear the lettuce into small pieces with your hands."
        }
      },
      {
        "id": "arrange-cheese-cheese-roll",
        "en": {
          "title": "Arrange the cheese base",
          "description": "Line a baking sheet with parchment paper. Slice the cheese into thin slices and arrange them on the baking sheet in a slightly overlapping rectangle."
        }
      },
      {
        "id": "bake-cheese-cheese-roll",
        "en": {
          "title": "Bake the cheese base",
          "description": "Place the baking sheet on the middle rack of an oven preheated to 180°C (350°F) and bake for 6–7 minutes, until the cheese becomes golden."
        }
      },
      {
        "id": "blot-cheese-cheese-roll",
        "en": {
          "title": "Blot the cheese",
          "description": "Remove the baking sheet from the oven and blot the cheese with a paper towel to absorb any released moisture and fat."
        }
      },
      {
        "id": "layer-meats-cheese-roll",
        "en": {
          "title": "Layer the meats and mayonnaise",
          "description": "While the cheese is still warm, place the cooked sausage and pepperoni on top, then spread mayonnaise over them."
        }
      },
      {
        "id": "add-vegetables-cheese-roll",
        "en": {
          "title": "Add the remaining filling",
          "description": "Arrange the onion, lettuce, and cherry tomatoes over the mayonnaise. Drizzle with Dijon mustard and season with black pepper."
        }
      },
      {
        "id": "roll-and-cut-cheese-roll",
        "en": {
          "title": "Roll and cut the roll",
          "description": "Carefully roll the cheese with the filling into a tight roll. Slice into portions and serve."
        }
      }
    ],
