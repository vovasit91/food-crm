    "newCookingSteps": [
      {
        "id": "heat-water-pizza-salmon-cherry",
        "en": {
          "title": "Heat the water",
          "description": "Pour water into a microwave-safe bowl and heat it for 1–1.5 minutes until warm. Take 3 tablespoons of the warm water into a small bowl."
        }
      },
      {
        "id": "activate-yeast-pizza-salmon-cherry",
        "en": {
          "title": "Activate the yeast",
          "description": "Add the compressed yeast to the 3 tablespoons of warm water. Stir and let it stand for 10–15 minutes until the yeast activates and becomes frothy."
        }
      },
      {
        "id": "mix-dry-ingredients-pizza-salmon-cherry",
        "en": {
          "title": "Mix the dry ingredients",
          "description": "In a large bowl, combine the flour and 0.5 teaspoon of salt. Stir to mix, then make a well in the center."
        }
      },
      {
        "id": "knead-dough-pizza-salmon-cherry",
        "en": {
          "title": "Knead the dough",
          "description": "Pour the activated yeast and remaining warm water into the well. Gradually mix into a dough. Add 1 tablespoon of olive oil and knead for about 10 minutes until smooth and elastic. Form into a ball."
        }
      },
      {
        "id": "first-rise-pizza-salmon-cherry",
        "en": {
          "title": "Let the dough rise",
          "description": "Grease a deep bowl with remaining olive oil, place the dough ball inside, cover with a towel or plastic wrap, and leave in a warm place for about 1 hour until doubled in size."
        }
      },
      {
        "id": "shape-dough-pizza-salmon-cherry",
        "en": {
          "title": "Shape the pizza base",
          "description": "Punch down the risen dough, then flatten it into a round disc about 1 cm thick. Place on a baking sheet, brush with 1 tablespoon of olive oil, and sprinkle with a pinch of sea salt."
        }
      },
      {
        "id": "bake-base-pizza-salmon-cherry",
        "en": {
          "title": "Bake the pizza base",
          "description": "Preheat the oven to 220°C. Bake the base for 12–15 minutes until golden and cooked through. Remove and let cool."
        }
      },
      {
        "id": "slice-onion-pizza-salmon-cherry",
        "en": {
          "title": "Slice the red onion",
          "description": "Cut the red onion into thin feather-like slices."
        }
      },
      {
        "id": "saute-onion-first-pizza-salmon-cherry",
        "en": {
          "title": "Sauté the onion until soft",
          "description": "Heat a mixture of olive oil and vegetable oil in a frying pan over medium heat. Add the sliced onion and sauté for 7–9 minutes until soft."
        }
      },
      {
        "id": "caramelize-onion-pizza-salmon-cherry",
        "en": {
          "title": "Caramelize the onion",
          "description": "Pour in balsamic vinegar, add salt and sugar. Continue cooking over medium heat for 10–15 minutes, stirring occasionally, until the onion is caramelized and dark."
        }
      },
      {
        "id": "prep-toppings-pizza-salmon-cherry",
        "en": {
          "title": "Prepare the toppings",
          "description": "Cut the cherry tomatoes in half. Finely chop the green onion, dill, and pickles."
        }
      },
      {
        "id": "assemble-pizza-base-pizza-salmon-cherry",
        "en": {
          "title": "Assemble the pizza base",
          "description": "Transfer the cooled pizza base to a board. Spread an even layer of ricotta over the base. Sprinkle with chopped green onion and dill. Arrange the tomato halves, chopped pickles, and caramelized onion on top."
        }
      },
      {
        "id": "add-fish-and-oil-pizza-salmon-cherry",
        "en": {
          "title": "Top with fish and oil",
          "description": "Lay slices of trout fillet over the pizza. Drizzle with 1 tablespoon of extra virgin olive oil. Serve immediately."
        }
      }
    ],
