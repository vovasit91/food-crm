    "newCookingSteps": [
      {
        "id": "mix-dough-tvorog-kneli-berries",
        "en": {
          "title": "Mix the dough",
          "description": "In a bowl, combine tvorog, butter, egg, salt, flour, and semolina. Mix thoroughly until a uniform dough forms."
        }
      },
      {
        "id": "refrigerate-dough-tvorog-kneli-berries",
        "en": {
          "title": "Refrigerate the dough",
          "description": "Cover the bowl with plastic wrap and place it in the refrigerator. Let it chill for 30 to 40 minutes to allow the dough to stabilize."
        }
      },
      {
        "id": "chop-walnuts-tvorog-kneli-berries",
        "en": {
          "title": "Chop the walnuts",
          "description": "Finely chop the walnuts with a knife or in a food processor."
        }
      },
      {
        "id": "toast-crumb-mixture-tvorog-kneli-berries",
        "en": {
          "title": "Toast the crumb mixture",
          "description": "Heat a pan over medium heat and melt the butter. Add the breadcrumbs, chopped walnuts, sugar, and cinnamon. Cook, stirring frequently, for 8 to 10 minutes until the mixture turns golden and aromatic. Remove from heat."
        }
      },
      {
        "id": "cool-crumb-mixture-tvorog-kneli-berries",
        "en": {
          "title": "Cool the crumb mixture",
          "description": "Let the toasted crumb mixture cool completely on a plate or in a bowl."
        }
      },
      {
        "id": "combine-berry-sauce-tvorog-kneli-berries",
        "en": {
          "title": "Combine the berry sauce ingredients",
          "description": "In a small saucepan, combine the frozen berries, maple syrup, and lemon zest."
        }
      },
      {
        "id": "cook-berry-sauce-tvorog-kneli-berries",
        "en": {
          "title": "Cook the berry sauce",
          "description": "Place the saucepan over medium heat. Cook for 7 to 10 minutes, stirring occasionally, until the berries soften and the sauce thickens. Remove from heat."
        }
      },
      {
        "id": "remove-sauce-from-heat-tvorog-kneli-berries",
        "en": {
          "title": "Remove sauce from heat",
          "description": "Take the saucepan off the stove and set the berry sauce aside."
        }
      },
      {
        "id": "take-dough-out-tvorog-kneli-berries",
        "en": {
          "title": "Take the dough out of the fridge",
          "description": "Remove the chilled dough from the refrigerator."
        }
      },
      {
        "id": "bring-water-to-boil-tvorog-kneli-berries",
        "en": {
          "title": "Bring water to a boil",
          "description": "Fill a large pot about two-thirds full with water. Place over high heat and bring to a rolling boil."
        }
      },
      {
        "id": "reduce-heat-and-add-salt-tvorog-kneli-berries",
        "en": {
          "title": "Reduce heat and add salt",
          "description": "Once boiling, reduce the heat to medium and add a pinch of salt to the water."
        }
      },
      {
        "id": "form-kneli-tvorog-kneli-berries",
        "en": {
          "title": "Form the kneli",
          "description": "Using a tablespoon, scoop portions of the dough and shape them into elongated dumplings (kneli)."
        }
      },
      {
        "id": "boil-kneli-tvorog-kneli-berries",
        "en": {
          "title": "Boil the kneli",
          "description": "Gently drop the formed kneli into the simmering water. Cook for 10 minutes, until they float and are cooked through."
        }
      },
      {
        "id": "remove-kneli-tvorog-kneli-berries",
        "en": {
          "title": "Remove the kneli",
          "description": "Use a slotted spoon to lift the cooked kneli out of the water and transfer them to a plate."
        }
      },
      {
        "id": "coat-kneli-in-crumb-tvorog-kneli-berries",
        "en": {
          "title": "Coat the kneli in crumb mixture",
          "description": "While still warm, roll each kneli in the cooled crumb mixture until evenly coated on all sides."
        }
      },
      {
        "id": "transfer-to-serving-plate-tvorog-kneli-berries",
        "en": {
          "title": "Transfer to serving plate",
          "description": "Arrange the coated kneli on a serving plate. Serve with the berry sauce on the side or drizzled over."
        }
      }
    ],
