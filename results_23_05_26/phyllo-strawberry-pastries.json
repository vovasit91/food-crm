    "newCookingSteps": [
      {
        "id": "melt-butter-phyllo-strawberry-pastries",
        "en": {
          "title": "Melt the butter",
          "description": "Melt the butter in the microwave in short 10-second bursts, stirring in between, until completely melted."
        }
      },
      {
        "id": "assemble-phyllo-blanks-phyllo-strawberry-pastries",
        "en": {
          "title": "Assemble phyllo blanks",
          "description": "Lay one sheet of phyllo dough, brush it with melted butter, then place a second sheet on top. Gather the edges toward the center to form a round, crumpled blank. Repeat for the remaining sheets to make three blanks."
        }
      },
      {
        "id": "make-cream-filling-phyllo-strawberry-pastries",
        "en": {
          "title": "Make the cream filling",
          "description": "In a bowl, combine cream cheese, sugar, and one egg yolk. Mix until smooth and homogeneous."
        }
      },
      {
        "id": "fill-and-brush-edges-phyllo-strawberry-pastries",
        "en": {
          "title": "Fill and brush edges",
          "description": "Place a spoonful of the cream filling in the center of each phyllo blank. Brush the exposed dough edges with the remaining egg yolk."
        }
      },
      {
        "id": "sprinkle-almonds-and-bake-phyllo-strawberry-pastries",
        "en": {
          "title": "Sprinkle almonds and bake",
          "description": "Sprinkle the edges of the pastries with almond flakes. Bake in an oven preheated to 180°C for 15–20 minutes until golden and crispy."
        }
      },
      {
        "id": "top-with-strawberries-phyllo-strawberry-pastries",
        "en": {
          "title": "Top with strawberries",
          "description": "Remove the pastries from the oven. Cut the strawberries into quarters and arrange them on top of the cream filling."
        }
      },
      {
        "id": "melt-chocolate-and-drizzle-phyllo-strawberry-pastries",
        "en": {
          "title": "Melt chocolate and drizzle",
          "description": "Break the white chocolate into pieces and melt it in the microwave in 10–15 second bursts. Drizzle the melted chocolate over the pastries."
        }
      }
    ],
