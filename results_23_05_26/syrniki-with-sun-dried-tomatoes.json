    "newCookingSteps": [
      {
        "id": "prep-ingredients-syrniki-with-sun-dried-tomatoes",
        "en": {
          "title": "Prepare the herbs, cheese, and tomatoes",
          "description": "Separate the parsley and basil leaves from the stems and finely chop them. Finely grate the hard cheese. Cut the sun-dried tomatoes into small pieces."
        }
      },
      {
        "id": "mix-tvorog-mixture-syrniki-with-sun-dried-tomatoes",
        "en": {
          "title": "Mix the tvorog, sour cream, and egg yolk",
          "description": "In a bowl, combine the tvorog, sour cream, and egg yolk. Mix well, mashing the tvorog until smooth."
        }
      },
      {
        "id": "combine-dough-syrniki-with-sun-dried-tomatoes",
        "en": {
          "title": "Add the vegetables, cheese, and flour",
          "description": "Add the chopped sun-dried tomatoes, herbs, grated hard cheese, salt, and black pepper to the tvorog mixture. Stir until combined. Gradually add 2-3 tablespoons of rice flour, adjusting the amount until the dough is slightly sticky but firm. Knead gently."
        }
      },
      {
        "id": "form-syrniki-patties-syrniki-with-sun-dried-tomatoes",
        "en": {
          "title": "Shape the syrniki patties",
          "description": "Pour the remaining rice flour onto a plate. Form the tvorog dough into round patties about 3-3.5 cm in diameter. Coat each patty thoroughly in rice flour."
        }
      },
      {
        "id": "fry-syrniki-syrniki-with-sun-dried-tomatoes",
        "en": {
          "title": "Fry the syrniki",
          "description": "Pour sunflower oil into a frying pan and heat over medium heat. Place the syrniki in the pan and fry for 3-4 minutes until golden brown. Flip and fry the other side for another 3-4 minutes. Cover the pan, reduce heat to low, and steam the syrniki for about 2 minutes more."
        }
      }
    ],
