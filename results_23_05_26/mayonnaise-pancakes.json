    "newCookingSteps": [
      {
        "id": "crack-beat-eggs-mayonnaise-pancakes",
        "en": {
          "title": "Crack and beat eggs",
          "description": "Crack the eggs into a bowl and beat with a whisk for 2-3 minutes until light foam appears on the surface."
        }
      },
      {
        "id": "add-mayonnaise-mayonnaise-pancakes",
        "en": {
          "title": "Add mayonnaise",
          "description": "Add the mayonnaise to the beaten eggs and mix well with a whisk until fluffy."
        }
      },
      {
        "id": "add-sugar-salt-beat-mayonnaise-pancakes",
        "en": {
          "title": "Add sugar and salt",
          "description": "While continuing to mix, add the sugar and salt. Beat for another 2-3 minutes until the crystals are fully dissolved."
        }
      },
      {
        "id": "add-water-mayonnaise-pancakes",
        "en": {
          "title": "Add warm water",
          "description": "Pour warm water into the egg mixture and stir."
        }
      },
      {
        "id": "add-flour-mix-mayonnaise-pancakes",
        "en": {
          "title": "Add flour and mix",
          "description": "Sift in the flour and whisk until the batter is smooth and free of lumps."
        }
      },
      {
        "id": "add-oil-mix-mayonnaise-pancakes",
        "en": {
          "title": "Add oil and mix",
          "description": "Pour in the sunflower oil and stir once more to combine."
        }
      },
      {
        "id": "heat-pan-mayonnaise-pancakes",
        "en": {
          "title": "Heat the pan",
          "description": "Heat a frying pan over medium heat and lightly grease it with a little oil."
        }
      },
      {
        "id": "cook-pancakes-mayonnaise-pancakes",
        "en": {
          "title": "Cook pancakes",
          "description": "Pour about half a ladle of batter into the pan and spread it into a thin, even layer. Cook for 30-40 seconds on each side until golden. Transfer to a plate and repeat with the remaining batter, greasing the pan as needed. Stack the pancakes and cover with a lid to keep warm."
        }
      }
    ],
