    "newCookingSteps": [
      {
        "id": "grate-carrot-carrot-cake-oatmeal",
        "en": {
          "title": "Grate the carrot",
          "description": "Finely grate the carrot on a box grater or with a food processor. Set aside."
        }
      },
      {
        "id": "chop-apricots-carrot-cake-oatmeal",
        "en": {
          "title": "Chop the dried apricots",
          "description": "Cut the dried apricots into small pieces, about the size of raisins."
        }
      },
      {
        "id": "melt-butter-carrot-cake-oatmeal",
        "en": {
          "title": "Melt the butter",
          "description": "Place a saucepan or pot over medium heat and add the butter. Let it melt completely."
        }
      },
      {
        "id": "saute-carrot-carrot-cake-oatmeal",
        "en": {
          "title": "Sauté the carrot",
          "description": "Add the grated carrot to the melted butter. Cook over medium heat for 2–3 minutes, stirring frequently, until the carrot softens slightly."
        }
      },
      {
        "id": "add-water-apricots-spices-carrot-cake-oatmeal",
        "en": {
          "title": "Add water, apricots, and spices",
          "description": "Pour the water into the saucepan. Add the chopped dried apricots, cinnamon, ginger, and nutmeg. Stir to combine."
        }
      },
      {
        "id": "simmer-carrot-cake-oatmeal",
        "en": {
          "title": "Simmer the mixture",
          "description": "Keep the heat at medium and let the mixture simmer gently for 5 minutes. The aromas will meld together."
        }
      },
      {
        "id": "add-milk-boil-carrot-cake-oatmeal",
        "en": {
          "title": "Add milk and bring to a boil",
          "description": "Pour the milk into the pot. Increase the heat to high and bring the liquid to a boil, stirring occasionally to prevent scorching."
        }
      },
      {
        "id": "add-oats-sugar-carrot-cake-oatmeal",
        "en": {
          "title": "Add oats and sugar",
          "description": "Once the liquid is boiling, add the rolled oats and brown sugar. Stir to incorporate."
        }
      },
      {
        "id": "cook-oatmeal-carrot-cake-oatmeal",
        "en": {
          "title": "Cook the oatmeal",
          "description": "Reduce the heat to low and cook the oatmeal, stirring gently from time to time, for 10–15 minutes until it thickens. About 5 minutes before it's done, add salt and stir."
        }
      },
      {
        "id": "remove-rest-carrot-cake-oatmeal",
        "en": {
          "title": "Remove from heat and rest",
          "description": "Take the pot off the stove. Cover with a lid and let the oatmeal rest for 3–5 minutes. It will continue to thicken. Serve warm."
        }
      }
    ],
