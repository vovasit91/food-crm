        "en": {
          "title": "Cut the lavash into strips",
          "description": "Cut the lavash into strips as wide as the sausages. You will need one strip per sausage."
        }
      },
      {
        "id": "place-sauce-sausage-lavash-rolls",
        "en": {
          "title": "Place ketchup and mayonnaise on each strip",
          "description": "Place 1 teaspoon of ketchup and 1 teaspoon of mayonnaise in the center of each lavash strip."
        }
      },
      {
        "id": "spread-sauce-sausage-lavash-rolls",
        "en": {
          "title": "Spread the sauce",
          "description": "Using a silicone brush or spoon, spread the ketchup and mayonnaise evenly over the entire surface of the lavash strip."
        }
      },
      {
        "id": "grate-cheese-sausage-lavash-rolls",
        "en": {
          "title": "Grate and sprinkle cheese",
          "description": "Grate the cheese and sprinkle it evenly over the lavash strip, leaving a 1 cm border."
        }
      },
      {
        "id": "roll-sausage-sausage-lavash-rolls",
        "en": {
          "title": "Roll up the sausage in lavash",
          "description": "Place a sausage on the edge of the strip and roll it tightly. Repeat for all sausages."
        }
      },
      {
        "id": "fry-rolls-sausage-lavash-rolls",
        "en": {
          "title": "Fry the lavash rolls",
          "description": "Heat vegetable oil in a skillet over medium heat. Fry the lavash rolls for 1–2 minutes on each side until golden and crispy."
        }
      }
