          "title": "Soak the rice",
          "description": "Pour 1 cup of boiling water over the rice and let it sit for 1 hour to soften."
        }
      },
      {
        "id": "cook-rice-rice-pudding-with-cinnamon",
        "en": {
          "title": "Cook the rice",
          "description": "Transfer the rice and its soaking water to a saucepan. Cook over medium heat for about 10 minutes."
        }
      },
      {
        "id": "add-milk-rice-pudding-with-cinnamon",
        "en": {
          "title": "Add milk and bring to a boil",
          "description": "Pour the milk into the saucepan and bring the mixture to a boil."
        }
      },
      {
        "id": "simmer-pudding-rice-pudding-with-cinnamon",
        "en": {
          "title": "Simmer with sugar and vanilla",
          "description": "Add sugar and vanilla to the pan. Cook on the lowest heat with the lid slightly open, stirring occasionally, for about 30 minutes."
        }
      },
      {
        "id": "dissolve-starch-rice-pudding-with-cinnamon",
        "en": {
          "title": "Dissolve the cornstarch",
          "description": "In a small bowl, dissolve the cornstarch in 50 ml of cold water until smooth."
        }
      },
      {
        "id": "add-starch-rice-pudding-with-cinnamon",
        "en": {
          "title": "Thicken the pudding",
          "description": "Pour the cornstarch mixture into the milk-rice pudding in a thin stream while stirring continuously. Cook for another 3 minutes, stirring gently."
        }
      },
      {
        "id": "cool-pudding-rice-pudding-with-cinnamon",
        "en": {
          "title": "Cool the pudding",
          "description": "Divide the pudding into serving bowls and let it cool completely at room temperature."
        }
      },
