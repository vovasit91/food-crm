    "newCookingSteps": [
      {
        "id": "blanch-almonds-pistachio-lemon-cake",
        "en": {
          "title": "Blanch the almonds",
          "description": "Pour boiling water over the almonds and let them sit for 1-2 minutes. Then drain the water and peel off the skins."
        }
      },
      {
        "id": "peel-almonds-pistachio-lemon-cake",
        "en": {
          "title": "Peel the almonds",
          "description": "Remove the skins from the almonds after blanching. Discard the skins."
        }
      },
      {
        "id": "dry-almonds-pistachio-lemon-cake",
        "en": {
          "title": "Dry the almonds",
          "description": "Place the peeled almonds in a dry frying pan over medium heat. Toast them for 1-2 minutes, stirring frequently, until they are dry and lightly golden."
        }
      },
      {
        "id": "preheat-oven-pistachio-lemon-cake",
        "en": {
          "title": "Preheat the oven",
          "description": "Set your oven to preheat to 190°C (375°F). This will ensure it's hot enough when the batter is ready."
        }
      },
      {
        "id": "prepare-lemon-pistachio-lemon-cake",
        "en": {
          "title": "Prepare the lemon",
          "description": "Finely grate the zest from the lemon, then cut the lemon in half and squeeze out the juice. Set both aside."
        }
      },
      {
        "id": "grind-nuts-pistachio-lemon-cake",
        "en": {
          "title": "Grind the nuts",
          "description": "Place the dried almonds and 100 g of pistachios (original recipe; adjust for portion) into a blender. Process on high speed for 3-4 minutes until the mixture becomes a fine crumb."
        }
      },
      {
        "id": "cream-butter-pistachio-lemon-cake",
        "en": {
          "title": "Cream butter and sugar",
          "description": "In a large bowl, combine the softened butter and sugar. Add half of the lemon zest. Beat with an electric mixer on medium speed for 2-3 minutes until light and fluffy."
        }
      },
      {
        "id": "add-eggs-pistachio-lemon-cake",
        "en": {
          "title": "Add the eggs",
          "description": "While continuing to beat, add the eggs one at a time. Mix well after each addition until the mixture is smooth and fully combined."
        }
      },
      {
        "id": "add-dry-pistachio-lemon-cake",
        "en": {
          "title": "Add the dry ingredients",
          "description": "Add the ground nut mixture, flour, and the seeds scraped from the vanilla pod. Mix on the lowest speed until just combined, being careful not to overmix."
        }
      },
      {
        "id": "transfer-to-pan-pistachio-lemon-cake",
        "en": {
          "title": "Transfer to the pan",
          "description": "Scoop the batter into a greased loaf pan or cake mold. Spread it evenly with a spatula."
        }
      },
      {
        "id": "bake-cake-pistachio-lemon-cake",
        "en": {
          "title": "Bake the cake",
          "description": "Place the pan in the preheated oven and bake at 190°C for 40-50 minutes, or until a skewer inserted into the center comes out clean. The top should be golden brown."
        }
      },
      {
        "id": "make-syrup-pistachio-lemon-cake",
        "en": {
          "title": "Make the lemon syrup",
          "description": "In a small saucepan, combine the lemon juice and sugar. Heat over medium heat, stirring constantly, for 3-4 minutes until the sugar has completely dissolved."
        }
      },
      {
        "id": "finish-syrup-pistachio-lemon-cake",
        "en": {
          "title": "Finish the syrup",
          "description": "Add the remaining lemon zest to the saucepan, stir, then remove from heat. Set aside."
        }
      },
      {
        "id": "cool-cake-pistachio-lemon-cake",
        "en": {
          "title": "Cool the cake",
          "description": "Let the cake cool in the pan for about 10 minutes. Then carefully remove it from the pan and transfer to a wire rack or serving plate."
        }
      },
      {
        "id": "glaze-cake-pistachio-lemon-cake",
        "en": {
          "title": "Glaze the cake",
          "description": "While the cake is still warm, pour the lemon syrup evenly over the top. Allow it to soak in."
        }
      },
      {
        "id": "chop-pistachios-pistachio-lemon-cake",
        "en": {
          "title": "Chop the pistachios",
          "description": "Roughly chop the remaining pistachios (50 g original; adjust for portion) into coarse pieces."
        }
      },
      {
        "id": "sprinkle-pistachios-pistachio-lemon-cake",
        "en": {
          "title": "Sprinkle with pistachios",
          "description": "Distribute the chopped pistachios evenly over the syrup-glazed cake. Press lightly so they stick."
        }
      }
    ],
