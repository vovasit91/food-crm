    "newCookingSteps": [
      {
        "id": "sift-dry-apple-pancakes",
        "en": {
          "title": "Sift dry ingredients",
          "description": "Sift the flour into a deep bowl. Add a pinch of salt and vanilla sugar."
        }
      },
      {
        "id": "mix-eggs-milk-apple-pancakes",
        "en": {
          "title": "Mix eggs and milk",
          "description": "In a separate bowl, beat the eggs with the milk until combined."
        }
      },
      {
        "id": "combine-batter-apple-pancakes",
        "en": {
          "title": "Combine wet and dry ingredients",
          "description": "Slowly pour the egg-milk mixture into the flour while whisking. Add the rum and mix until the batter is smooth and free of lumps."
        }
      },
      {
        "id": "rest-batter-apple-pancakes",
        "en": {
          "title": "Rest the batter",
          "description": "Cover the bowl and let the batter rest at room temperature for 1 hour. This allows the gluten to relax and gives a tender texture."
        }
      },
      {
        "id": "slice-apples-apple-pancakes",
        "en": {
          "title": "Slice the apples",
          "description": "Core the apples and cut them into thin slices, about 3 mm thick."
        }
      },
      {
        "id": "heat-pan-apple-pancakes",
        "en": {
          "title": "Heat the pan with oil",
          "description": "Place a frying pan over medium heat and lightly grease it with sunflower oil."
        }
      },
      {
        "id": "dip-apples-apple-pancakes",
        "en": {
          "title": "Dip apple slices in batter and arrange in pan",
          "description": "Quickly dip each apple slice into the batter, then place them overlapping in a circular pattern in the hot pan. Spoon a little extra batter over the top."
        }
      },
      {
        "id": "fry-first-side-apple-pancakes",
        "en": {
          "title": "Fry the first side",
          "description": "Cook the pancakes on one side for 3 to 5 minutes, until golden brown and set. Be careful not to rush, as they need to hold their shape."
        }
      },
      {
        "id": "flip-fry-second-side-apple-pancakes",
        "en": {
          "title": "Flip and fry the second side",
          "description": "Using a spatula, carefully flip the pancakes. Fry for another 3 to 5 minutes until cooked through and golden on both sides."
        }
      }
    ],
