    "newCookingSteps": [
      {
        "id": "mash-cottage-cheese-cottage-cheese-flatbreads",
        "en": {
          "title": "Mash the cottage cheese",
          "description": "In a bowl, mash the cottage cheese with a fork until smooth. Crack the egg into the bowl and add the flour, salt, pepper, and dried garlic. Stir to combine."
        }
      },
      {
        "id": "add-grated-cheese-cottage-cheese-flatbreads",
        "en": {
          "title": "Add grated cheese",
          "description": "Grate the hard cheese on a fine grater. Add it to the cottage cheese mixture and stir well until you have a homogeneous dough."
        }
      },
      {
        "id": "shape-flatbreads-cottage-cheese-flatbreads",
        "en": {
          "title": "Shape the flatbreads",
          "description": "Line a baking tray with parchment paper. Using a spoon, drop portions of the dough onto the tray and spread them into thin rounds."
        }
      },
      {
        "id": "bake-flatbreads-cottage-cheese-flatbreads",
        "en": {
          "title": "Bake the flatbreads",
          "description": "Preheat the oven to 180°C. Bake the flatbreads for 20–25 minutes, until they are golden brown. Set a timer to track the baking time."
        }
      },
      {
        "id": "assemble-flatbreads-cottage-cheese-flatbreads",
        "en": {
          "title": "Assemble the flatbreads",
          "description": "Carefully remove the baked flatbreads from the parchment. Spread cream cheese over each flatbread, then place arugula on top. Slice the tomato into thin rounds and lay them over the arugula, followed by the ham."
        }
      },
      {
        "id": "fold-and-serve-cottage-cheese-flatbreads",
        "en": {
          "title": "Fold and serve",
          "description": "Fold each flatbread in half so the filling is enclosed. Serve immediately for breakfast."
        }
      }
    ],
