    "newCookingSteps": [
      {
        "id": "fry-sausages-hot-dog-with-cheese-corn",
        "en": {
          "title": "Fry the sausages",
          "description": "Make shallow cuts on the sausages and fry them in a skillet over medium heat until golden brown, about 5 minutes."
        }
      },
      {
        "id": "chop-vegetables-hot-dog-with-cheese-corn",
        "en": {
          "title": "Chop the onion and pickles",
          "description": "Finely dice the red onion and cornichons (pickled cucumbers)."
        }
      },
      {
        "id": "mix-sauce-hot-dog-with-cheese-corn",
        "en": {
          "title": "Mix the sauce",
          "description": "Combine the chopped onion and pickles in a bowl. Add mayonnaise and barbecue sauce, then stir well."
        }
      },
      {
        "id": "melt-butter-add-corn-hot-dog-with-cheese-corn",
        "en": {
          "title": "Melt butter and add corn",
          "description": "In a skillet, melt the butter over medium heat. Add the corn kernels and stir. Grate the Gouda cheese and add it to the pan."
        }
      },
      {
        "id": "melt-cheese-hot-dog-with-cheese-corn",
        "en": {
          "title": "Melt the processed cheese",
          "description": "Add the processed cheese to the pan. Stir continuously until the cheese is completely melted and combined with the corn."
        }
      },
      {
        "id": "add-cream-hot-dog-with-cheese-corn",
        "en": {
          "title": "Add cream and mix",
          "description": "Pour in the light cream in a thin stream while stirring. Mix until the sauce is smooth and homogeneous."
        }
      },
      {
        "id": "prepare-buns-hot-dog-with-cheese-corn",
        "en": {
          "title": "Prepare the buns",
          "description": "Slice the hot dog buns lengthwise without cutting all the way through. Spread the onion-pickle-mayo sauce inside each bun."
        }
      },
      {
        "id": "assemble-hot-dogs-hot-dog-with-cheese-corn",
        "en": {
          "title": "Assemble the hot dogs",
          "description": "Place a cooked sausage into each bun on top of the sauce. Spoon the corn-cheese mixture over the sausage. Sprinkle with ground paprika."
        }
      }
    ],
