      {
        "id": "preheat-oven-orange-juice-muffins",
        "en": {
          "title": "Preheat the oven",
          "description": "Preheat the oven to 180°C. While it heats, prepare the muffin tin."
        }
      },
      {
        "id": "line-muffin-tin-orange-juice-muffins",
        "en": {
          "title": "Line the muffin tin",
          "description": "Place paper liners in the wells of a muffin tin."
        }
      },
      {
        "id": "squeeze-orange-orange-juice-muffins",
        "en": {
          "title": "Squeeze orange and grate zest",
          "description": "Squeeze the juice from the orange and grate the zest. Set aside."
        }
      },
      {
        "id": "mix-wet-ingredients-orange-juice-muffins",
        "en": {
          "title": "Mix wet ingredients",
          "description": "In a bowl, crack the egg. Add the orange juice, vegetable oil, and yogurt. Beat with a mixer on medium speed until smooth."
        }
      },
      {
        "id": "combine-dry-and-wet-orange-juice-muffins",
        "en": {
          "title": "Combine dry and wet ingredients",
          "description": "In a separate bowl, mix the flour, baking powder, sugar, salt, cornstarch, and vanilla. Gradually add the dry mixture to the wet mixture, stirring until no lumps remain."
        }
      },
      {
        "id": "fill-forms-orange-juice-muffins",
        "en": {
          "title": "Fill the forms",
          "description": "Divide the batter evenly among the paper liners."
        }
      },
      {
        "id": "bake-muffins-orange-juice-muffins",
        "en": {
          "title": "Bake the muffins",
          "description": "Bake the muffins for 20 minutes at 180°C, until a toothpick comes out clean."
        }
      },
      {
        "id": "cool-and-transfer-orange-juice-muffins",
        "en": {
          "title": "Cool and transfer",
          "description": "Let the muffins cool slightly in the pan, then transfer to a serving plate."
        }
      },
      {
        "id": "cream-butter-and-condensed-milk-orange-juice-muffins",
        "en": {
          "title": "Cream butter and condensed milk",
          "description": "In a clean bowl, beat the softened butter on medium speed for 2-3 minutes until creamy. Add the condensed milk and beat again until well combined."
        }
      },
      {
        "id": "add-cream-cheese-and-zest-orange-juice-muffins",
        "en": {
          "title": "Add cream cheese and zest",
          "description": "Add the cream cheese and beat on low speed until incorporated. Fold in the orange zest gently with a spatula."
        }
      },
      {
        "id": "pipe-cream-orange-juice-muffins",
        "en": {
          "title": "Pipe cream onto muffins",
          "description": "Transfer the cream to a piping bag and pipe onto the cooled muffins."
        }
      }
