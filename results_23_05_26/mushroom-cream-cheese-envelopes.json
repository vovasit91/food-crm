    "newCookingSteps": [
      {
        "id": "chop-vegetables-mushroom-cream-cheese-envelopes",
        "en": {
          "title": "Chop the vegetables",
          "description": "Cut the onion into small cubes, about 3–4 mm. Chop the mushrooms into slightly larger cubes."
        }
      },
      {
        "id": "fry-onion-mushroom-cream-cheese-envelopes",
        "en": {
          "title": "Fry the onion",
          "description": "Heat 1 tablespoon of oil in a frying pan over medium heat. Fry the onion, stirring occasionally, for 2–3 minutes until golden brown."
        }
      },
      {
        "id": "fry-mushrooms-mushroom-cream-cheese-envelopes",
        "en": {
          "title": "Fry the mushrooms",
          "description": "Add the chopped mushrooms to the pan with the onion. Cook together, stirring, for 3–4 minutes until the liquid evaporates and the mushrooms are lightly browned. Season with salt and pepper, stir, and remove from heat."
        }
      },
      {
        "id": "assemble-envelopes-mushroom-cream-cheese-envelopes",
        "en": {
          "title": "Assemble the envelopes",
          "description": "Cut each lavash into 3 long strips. Spread cream cheese evenly over each strip. Place about 2 teaspoons of the mushroom filling in the center of each strip, then fold into triangular envelopes."
        }
      },
      {
        "id": "beat-eggs-mushroom-cream-cheese-envelopes",
        "en": {
          "title": "Beat the eggs",
          "description": "Crack the eggs into a bowl and beat them with a fork until smooth."
        }
      },
      {
        "id": "fry-envelopes-mushroom-cream-cheese-envelopes",
        "en": {
          "title": "Fry the envelopes",
          "description": "Add another tablespoon of oil to the pan and heat over medium heat. Dip each assembled envelope into the beaten egg, then fry for 2–3 minutes per side until golden brown."
        }
      }
    ],
