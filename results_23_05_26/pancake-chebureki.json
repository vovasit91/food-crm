    "newCookingSteps": [
      {
        "id": "heat-milk-and-beat-eggs-pancake-chebureki",
        "en": {
          "title": "Heat the milk and beat the eggs",
          "description": "Pour the milk into a microwave-safe bowl and heat for 1-2 minutes until warm but not hot. In a separate bowl, beat the eggs with a fork until smooth."
        }
      },
      {
        "id": "mix-dry-ingredients-pancake-chebureki",
        "en": {
          "title": "Mix the dry ingredients",
          "description": "In a large bowl, combine the sifted flour, yeast, sugar, and salt. Stir to combine."
        }
      },
      {
        "id": "add-wet-and-mix-batter-pancake-chebureki",
        "en": {
          "title": "Add wet ingredients and mix the batter",
          "description": "Pour the warm milk and beaten eggs into the dry mixture. Mix until a smooth, thin pancake batter forms."
        }
      },
      {
        "id": "add-oil-and-mix-pancake-chebureki",
        "en": {
          "title": "Add oil and mix again",
          "description": "Add 2 tablespoons of vegetable oil to the batter and mix well."
        }
      },
      {
        "id": "let-dough-rise-pancake-chebureki",
        "en": {
          "title": "Let the dough rise",
          "description": "Cover the bowl with a clean kitchen towel and leave it in a warm place for 1 hour until the batter becomes bubbly and slightly thickened."
        }
      },
      {
        "id": "chop-vegetables-pancake-chebureki",
        "en": {
          "title": "Chop the vegetables",
          "description": "Shred the cabbage into 4-5 mm strips. Coarsely grate the carrot. Dice the onion into 3-4 mm cubes."
        }
      },
      {
        "id": "saute-onion-pancake-chebureki",
        "en": {
          "title": "Sauté the onion",
          "description": "Heat 2 tablespoons of vegetable oil in a deep skillet over medium heat. Add the diced onion and cook, stirring, for 1-2 minutes until golden."
        }
      },
      {
        "id": "cook-cabbage-and-carrots-pancake-chebureki",
        "en": {
          "title": "Cook the cabbage and carrots",
          "description": "Add the grated carrot and shredded cabbage to the skillet. Sprinkle with 2 g of salt. Cook, stirring occasionally, for 5-6 minutes until the vegetables are soft."
        }
      },
      {
        "id": "add-mince-and-cook-pancake-chebureki",
        "en": {
          "title": "Add the minced meat and cook",
          "description": "Add the ground beef to the skillet. Season with black pepper and the remaining salt. Cook, breaking up any clumps, for 7-8 minutes until the meat is fully cooked. Remove from heat and let cool slightly."
        }
      },
      {
        "id": "cool-filling-pancake-chebureki",
        "en": {
          "title": "Cool the filling",
          "description": "Take the skillet off the heat and let the filling cool down a bit before assembling the chebureki."
        }
      },
      {
        "id": "grease-and-heat-pan-pancake-chebureki",
        "en": {
          "title": "Grease and heat the pancake pan",
          "description": "Brush a thin layer of vegetable oil onto a flat pancake pan and heat it over medium heat."
        }
      },
      {
        "id": "pour-and-cook-pancake-base-pancake-chebureki",
        "en": {
          "title": "Pour and cook the pancake base",
          "description": "Fill a ladle halfway with the risen batter and pour it into the pan. Swirl to spread evenly. Cook for 1-2 minutes until the surface sets."
        }
      },
      {
        "id": "add-filling-and-fold-pancake-chebureki",
        "en": {
          "title": "Add the filling and fold",
          "description": "Visually divide the pancake in half. Place 2-3 tablespoons of meat filling on one half and spread slightly. Fold the other half over to form a half-moon shape."
        }
      },
      {
        "id": "fry-first-side-pancake-chebureki",
        "en": {
          "title": "Fry the first side",
          "description": "Fry the cheburek for 1-2 minutes until the bottom is golden brown, then flip."
        }
      },
      {
        "id": "fry-second-side-pancake-chebureki",
        "en": {
          "title": "Fry the second side",
          "description": "Fry the other side for another 1-2 minutes until golden and crispy. Transfer to a plate."
        }
      },
      {
        "id": "repeat-for-remaining-chebureki-pancake-chebureki",
        "en": {
          "title": "Repeat for all chebureki",
          "description": "Repeat the cooking process with the remaining batter and filling to make all the chebureki. Serve hot."
        }
      }
    ],
