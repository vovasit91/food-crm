    "newCookingSteps": [
      {
        "id": "preheat-oven-green-frittata",
        "en": {
          "title": "Preheat the oven",
          "description": "Preheat your oven to 180°C (350°F). This ensures the frittata bakes evenly once you transfer the skillet."
        }
      },
      {
        "id": "slice-spinach-green-frittata",
        "en": {
          "title": "Slice the spinach",
          "description": "Cut the spinach leaves into strips about 6-7 mm wide. This will help them wilt quickly."
        }
      },
      {
        "id": "chop-herbs-and-green-onion-green-frittata",
        "en": {
          "title": "Chop herbs and green onion",
          "description": "Separate the leaves from the stems of parsley, dill, and basil. Finely chop them together with the green onion."
        }
      },
      {
        "id": "dice-red-onion-green-frittata",
        "en": {
          "title": "Dice the red onion",
          "description": "Cut the red onion into small cubes about 3-4 mm in size. This ensures they cook evenly."
        }
      },
      {
        "id": "mince-garlic-green-frittata",
        "en": {
          "title": "Mince the garlic",
          "description": "Finely chop the garlic clove. You can use a knife or a garlic press."
        }
      },
      {
        "id": "mix-egg-mixture-green-frittata",
        "en": {
          "title": "Mix the egg mixture",
          "description": "Crack the eggs into a bowl. Add the chopped herbs, milk, salt, and black pepper. Whisk everything together until well combined."
        }
      },
      {
        "id": "saute-onion-and-garlic-green-frittata",
        "en": {
          "title": "Sauté the onion and garlic",
          "description": "Heat the vegetable oil in a skillet over medium heat. Add the diced red onion and cook, stirring, for 2-3 minutes until golden. Add the minced garlic and cook for another minute."
        }
      },
      {
        "id": "cook-frittata-on-stove-green-frittata",
        "en": {
          "title": "Cook the frittata on the stove",
          "description": "Reduce the heat to low. Pour the egg mixture into the skillet with the cooked onions and garlic. Cook for 2-3 minutes until the edges and bottom are set but the top is still slightly runny."
        }
      },
      {
        "id": "bake-frittata-green-frittata",
        "en": {
          "title": "Bake the frittata",
          "description": "Transfer the skillet to the preheated oven. Bake for 4-5 minutes until the top is golden brown and the frittata is fully set."
        }
      }
    ],
