    "newCookingSteps": [
      {
        "id": "mix-dough-and-rise-khachapuri-with-pumpkin",
        "en": {
          "title": "Mix dough and let rise",
          "description": "Combine flour, yeast, salt, and warm water. Mix until a dough forms. Cover with a towel and let rise in a warm place for 30 minutes."
        }
      },
      {
        "id": "saute-onion-khachapuri-with-pumpkin",
        "en": {
          "title": "Sauté onion",
          "description": "Finely chop the onion and fry in a pan over medium heat until soft and translucent."
        }
      },
      {
        "id": "prepare-pumpkin-filling-khachapuri-with-pumpkin",
        "en": {
          "title": "Prepare pumpkin filling",
          "description": "Grate the pumpkin using a coarse grater. Mix with the sautéed onion and chopped dill. Season with salt to taste."
        }
      },
      {
        "id": "assemble-khachapuri-with-pumpkin",
        "en": {
          "title": "Assemble khachapuri",
          "description": "Roll out the dough into a thin circle, about 0.3 cm thick. Place the filling in the center. Gather the edges of the dough over the filling and pinch tightly to seal."
        }
      },
      {
        "id": "preheat-oven-khachapuri-with-pumpkin",
        "en": {
          "title": "Preheat oven",
          "description": "Preheat your oven to 190°C (375°F)."
        }
      },
      {
        "id": "prepare-for-baking-khachapuri-with-pumpkin",
        "en": {
          "title": "Prepare for baking",
          "description": "Transfer the assembled khachapuri seam-side down onto a parchment-lined baking sheet. Brush the surface with milk and make a small hole in the center to allow steam to escape."
        }
      },
      {
        "id": "bake-khachapuri-with-pumpkin",
        "en": {
          "title": "Bake khachapuri",
          "description": "Place the khachapuri in the preheated oven and bake for 30 minutes until golden brown."
        }
      }
