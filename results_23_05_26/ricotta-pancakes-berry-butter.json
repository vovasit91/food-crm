    "newCookingSteps": [
      {
        "id": "mix-dry-ingredients-ricotta-pancakes-berry-butter",
        "en": {
          "title": "Mix dry ingredients",
          "description": "In a bowl, whisk together the flour, baking powder, and salt."
        }
      },
      {
        "id": "melt-butter-ricotta-pancakes-berry-butter",
        "en": {
          "title": "Melt butter in microwave",
          "description": "Place 10 g of butter in a microwave-safe bowl. Melt it in short 10-second bursts until just melted, then let it cool slightly."
        }
      },
      {
        "id": "beat-eggs-sugar-ricotta-pancakes-berry-butter",
        "en": {
          "title": "Beat eggs with sugar",
          "description": "In a separate bowl, beat the eggs with sugar until light and frothy."
        }
      },
      {
        "id": "add-wet-ingredients-ricotta-pancakes-berry-butter",
        "en": {
          "title": "Add wet ingredients to eggs",
          "description": "Add the vanilla extract, cooled melted butter, milk, and ricotta to the egg mixture. Stir until well combined."
        }
      },
      {
        "id": "combine-batter-ricotta-pancakes-berry-butter",
        "en": {
          "title": "Combine dry and wet mixtures",
          "description": "Pour the dry ingredients into the egg mixture and mix until a thick batter forms. The batter should resemble thick sour cream."
        }
      },
      {
        "id": "rest-batter-ricotta-pancakes-berry-butter",
        "en": {
          "title": "Rest the batter",
          "description": "Let the batter rest for 10 minutes. This allows the baking powder to activate and results in fluffier pancakes."
        }
      },
      {
        "id": "heat-pan-ricotta-pancakes-berry-butter",
        "en": {
          "title": "Heat the pan",
          "description": "Place a frying pan over medium heat and grease the bottom lightly with a little vegetable oil."
        }
      },
      {
        "id": "cook-first-side-ricotta-pancakes-berry-butter",
        "en": {
          "title": "Cook first side of pancakes",
          "description": "Scoop about 2 tablespoons of batter per pancake onto the hot pan. Cook for 2 minutes until bubbles appear on the surface."
        }
      },
      {
        "id": "flip-cook-second-side-ricotta-pancakes-berry-butter",
        "en": {
          "title": "Flip and cook second side",
          "description": "Carefully flip the pancakes and cook for another 2 minutes until golden brown and cooked through."
        }
      },
      {
        "id": "make-berry-butter-ricotta-pancakes-berry-butter",
        "en": {
          "title": "Make berry butter",
          "description": "In a clean bowl, beat the softened 50 g butter with the blueberry jam until smooth and evenly combined."
        }
      }
    ],
