        "en": {
          "title": "Cut and fry the chicken",
          "description": "Cut the chicken into small pieces. Pat them dry with paper towels. Heat oil in a skillet over high heat and fry the chicken until golden brown on all sides."
        }
      },
      {
        "id": "chop-and-mix-herbs-chicken-with-accent",
        "en": {
          "title": "Chop and mix herbs",
          "description": "Chop the cilantro, dill, and green onion. Slice the onion into half rings. Press the garlic through a press. Combine all the herbs, onion, garlic, salt, pepper, and vinegar. Stir thoroughly."
        }
      },
      {
        "id": "press-herbs-chicken-with-accent",
        "en": {
          "title": "Press the herbs to release juice",
          "description": "Transfer the herb mixture to a bowl and press it with a pestle to release as much juice as possible."
        }
      },
      {
        "id": "marinate-chicken-chicken-with-accent",
        "en": {
          "title": "Marinate the chicken",
          "description": "Add the fried chicken to the bowl with herbs. Pour in the pan juices. Mix well and let it stand for 20-30 minutes so the chicken absorbs the flavors."
        }
      }
