    "newCookingSteps": [
      {
        "id": "whisk-egg-sugar-salt-milk-pancake-casserole",
        "en": {
          "title": "Whisk egg with sugar, salt, and milk",
          "description": "In a bowl, beat the egg with the sugar and salt until smooth. Add the milk and mix well."
        }
      },
      {
        "id": "mix-dry-wet-pancake-casserole",
        "en": {
          "title": "Mix dry ingredients into batter",
          "description": "Combine the flour with the baking powder. Gradually add the dry mixture to the egg-milk mixture, stirring vigorously to break up any lumps."
        }
      },
      {
        "id": "add-berries-batter-pancake-casserole",
        "en": {
          "title": "Fold in berries",
          "description": "Add the berries to the batter and fold gently until evenly distributed."
        }
      },
      {
        "id": "fry-pancakes-pancake-casserole",
        "en": {
          "title": "Fry the pancakes",
          "description": "Heat a frying pan with oil over medium heat. Fry the pancakes until golden brown on both sides, about 1-2 minutes per side. Make small pancakes, about 13-15 cm in diameter. You should get about 4 pancakes per serving."
        }
      },
      {
        "id": "assemble-pancakes-pan-pancake-casserole",
        "en": {
          "title": "Arrange pancakes in baking dish",
          "description": "Line a baking dish with parchment or grease with oil. Cut each pancake in half to form semicircles. Arrange them tightly in the dish, cut side down, with the rounded edges facing up."
        }
      },
      {
        "id": "mix-custard-pancake-casserole",
        "en": {
          "title": "Prepare the custard",
          "description": "In a clean bowl, combine the cream, remaining eggs, brown sugar, vanilla extract, salt, and cinnamon. Whisk with a mixer until smooth."
        }
      },
      {
        "id": "pour-custard-and-chill-pancake-casserole",
        "en": {
          "title": "Pour custard and refrigerate",
          "description": "Pour the custard mixture over the arranged pancakes. Cover the dish with plastic wrap and refrigerate for at least 4 hours or overnight."
        }
      },
      {
        "id": "preheat-oven-pancake-casserole",
        "en": {
          "title": "Preheat the oven",
          "description": "Preheat your oven to 180°C (350°F)."
        }
      },
      {
        "id": "bake-casserole-pancake-casserole",
        "en": {
          "title": "Bake the casserole",
          "description": "Remove the dish from the fridge, take off the plastic wrap, and place in the preheated oven. Bake for 45 minutes until the top is golden and the custard is set."
        }
      },
      {
        "id": "cool-casserole-pancake-casserole",
        "en": {
          "title": "Let cool",
          "description": "Remove from the oven and let the casserole cool for about 15 minutes before serving."
        }
      }
    ],
