      {
        "id": "blend-cottage-cheese-cottage-cheese-waffles",
        "en": {
          "title": "Blend the cottage cheese",
          "description": "Blend the cottage cheese with an immersion blender or food processor until completely smooth."
        }
      },
      {
        "id": "add-oil-and-vanilla-cottage-cheese-waffles",
        "en": {
          "title": "Add oil and vanilla",
          "description": "Add the vegetable oil and vanilla essence to the blended cottage cheese and stir to combine."
        }
      },
      {
        "id": "pour-milk-cottage-cheese-waffles",
        "en": {
          "title": "Pour in the milk",
          "description": "Pour the milk into the cottage cheese mixture and whisk until uniform."
        }
      },
      {
        "id": "separate-eggs-cottage-cheese-waffles",
        "en": {
          "title": "Separate the eggs",
          "description": "Crack the eggs and carefully separate the yolks from the whites. Place the whites in a clean, grease‑free bowl."
        }
      },
      {
        "id": "add-yolks-and-mix-cottage-cheese-waffles",
        "en": {
          "title": "Add yolks and mix",
          "description": "Add the egg yolks to the cottage cheese mixture and stir until well incorporated."
        }
      },
      {
        "id": "mix-dry-ingredients-cottage-cheese-waffles",
        "en": {
          "title": "Mix dry ingredients",
          "description": "In a separate bowl, whisk together the flour, baking powder, sugar, cornstarch, and salt."
        }
      },
      {
        "id": "combine-wet-dry-mixtures-cottage-cheese-waffles",
        "en": {
          "title": "Combine wet and dry mixtures",
          "description": "Gradually add the dry ingredients to the wet mixture, stirring gently to avoid lumps. Mix until just combined."
        }
      },
      {
        "id": "whip-egg-whites-cottage-cheese-waffles",
        "en": {
          "title": "Whip egg whites to soft peaks",
          "description": "Using a mixer or whisk, beat the egg whites until soft peaks form. They should hold their shape but droop slightly when lifted."
        }
      },
      {
        "id": "fold-egg-whites-into-batter-cottage-cheese-waffles",
        "en": {
          "title": "Fold egg whites into batter",
          "description": "Gently fold the whipped egg whites into the batter in small additions, using a spatula and lifting from the bottom to keep the mixture airy. Continue until no streaks remain."
        }
      },
      {
        "id": "preheat-waffle-iron-cottage-cheese-waffles",
        "en": {
          "title": "Preheat the waffle iron",
          "description": "Turn on your waffle iron and let it heat up according to the manufacturer’s instructions. A hot iron ensures even cooking and a crisp exterior."
        }
      },
      {
        "id": "cook-waffles-cottage-cheese-waffles",
        "en": {
          "title": "Cook the waffles",
          "description": "Spoon small portions of batter onto the preheated waffle iron, close the lid, and cook for 4–5 minutes until golden brown and fragrant. Repeat with remaining batter."
        }
      }
