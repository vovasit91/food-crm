          "title": "Chop onion and garlic",
          "description": "Finely chop the onion and garlic cloves. This step is preparation for sautéing."
        }
      },
      {
        "id": "saute-onion-garlic-shakshuka-with-tomatoes-and-herbs",
        "en": {
          "title": "Sauté onion and garlic",
          "description": "Heat the olive oil in a skillet over medium heat. Add the chopped onion and garlic, season with salt, pepper, and spices, and sauté until softened, about 3 minutes."
        }
      },
      {
        "id": "grate-tomatoes-add-shakshuka-with-tomatoes-and-herbs",
        "en": {
          "title": "Grate tomatoes and add to skillet",
          "description": "Grate the tomatoes on a coarse grater directly into the skillet with the sautéed vegetables. Stir well to combine."
        }
      },
      {
        "id": "crack-eggs-shakshuka-with-tomatoes-and-herbs",
        "en": {
          "title": "Crack eggs into the sauce",
          "description": "Carefully crack the eggs into the skillet, placing them directly onto the tomato sauce. Try not to break the yolks."
        }
      },
      {
        "id": "chop-feta-place-shakshuka-with-tomatoes-and-herbs",
        "en": {
          "title": "Chop feta and arrange over eggs",
          "description": "Cut the feta cheese into small cubes and scatter them evenly over the eggs."
        }
      },
      {
        "id": "cover-simmer-shakshuka-with-tomatoes-and-herbs",
        "en": {
          "title": "Cover and simmer",
          "description": "Cover the skillet with a lid and reduce the heat to low. Let the shakshuka simmer for 10 minutes, until the eggs are cooked to your liking."
        }
      },
      {
        "id": "chop-herbs-garnish-shakshuka-with-tomatoes-and-herbs",
        "en": {
          "title": "Chop herbs and garnish",
          "description": "Finely chop the fresh herbs and lettuce leaves. Sprinkle the mixture over the finished shakshuka before serving."
        }
      }
