    "newCookingSteps": [
      {
        "id": "mix-marinade-grilled-chicken-air-fryer",
        "en": {
          "title": "Mix the marinade",
          "description": "In a small bowl, combine soy sauce, mustard, and salt. Stir until well mixed. Add pepper if desired."
        }
      },
      {
        "id": "coat-and-marinate-chicken-grilled-chicken-air-fryer",
        "en": {
          "title": "Coat and marinate the chicken",
          "description": "Brush the marinade all over the chicken, including the inside. Place the chicken in a resealable bag, pour in any remaining marinade, seal, and refrigerate for about 12 hours. Occasionally turn the bag to redistribute the marinade."
        }
      },
      {
        "id": "place-chicken-in-air-fryer-grilled-chicken-air-fryer",
        "en": {
          "title": "Place chicken in air fryer",
          "description": "Remove the chicken from the bag and place it in the air fryer basket or a baking dish suitable for the oven."
        }
      },
      {
        "id": "bake-chicken-1-grilled-chicken-air-fryer",
        "en": {
          "title": "Bake the first side",
          "description": "Preheat the air fryer or oven to 160°C (320°F). Bake the chicken for 15 minutes."
        }
      },
      {
        "id": "turn-chicken-1-grilled-chicken-air-fryer",
        "en": {
          "title": "Turn the chicken and brush",
          "description": "Carefully turn the chicken over. Brush with some of the remaining marinade from the bag."
        }
      },
      {
        "id": "bake-chicken-2-grilled-chicken-air-fryer",
        "en": {
          "title": "Bake the second side",
          "description": "Bake for another 15 minutes at 160°C."
        }
      },
      {
        "id": "turn-chicken-2-grilled-chicken-air-fryer",
        "en": {
          "title": "Turn and brush again",
          "description": "Turn the chicken over once more and brush with marinade."
        }
      },
      {
        "id": "bake-chicken-3-grilled-chicken-air-fryer",
        "en": {
          "title": "Bake the third side",
          "description": "Bake for 15 minutes."
        }
      },
      {
        "id": "turn-chicken-3-grilled-chicken-air-fryer",
        "en": {
          "title": "Turn and brush one last time",
          "description": "Turn the chicken over and brush with any remaining marinade."
        }
      },
      {
        "id": "bake-chicken-4-grilled-chicken-air-fryer",
        "en": {
          "title": "Bake the final side",
          "description": "Bake for a final 15 minutes until the chicken is golden and cooked through. Internal temperature should reach 74°C (165°F) in the thickest part."
        }
      }
    ],
