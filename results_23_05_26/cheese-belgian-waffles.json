    "newCookingSteps": [
      {
        "id": "combine-wet-ingredients-cheese-belgian-waffles",
        "en": {
          "title": "Combine milk, eggs, and salt",
          "description": "In a bowl, combine the milk and eggs. Add salt and beat until smooth."
        }
      },
      {
        "id": "add-dry-ingredients-cheese-belgian-waffles",
        "en": {
          "title": "Add baking powder, coriander, and flour",
          "description": "Sprinkle baking powder and ground coriander into the egg-milk mixture. Gradually add the flour, stirring constantly to avoid lumps. Mix until a thick batter forms."
        }
      },
      {
        "id": "add-oil-and-beat-cheese-belgian-waffles",
        "en": {
          "title": "Add oil and beat",
          "description": "Pour in the refined sunflower oil. Beat the batter on low speed for 30 seconds until smooth and well combined."
        }
      },
      {
        "id": "add-grated-cheese-cheese-belgian-waffles",
        "en": {
          "title": "Grate cheese and fold into batter",
          "description": "Grate the hard cheese on a fine grater. Add the grated cheese to the batter and mix thoroughly. The batter should be thick enough to hold a groove when you drag a spoon through it. Adjust consistency by adding more cheese or flour if needed."
        }
      },
      {
        "id": "cook-waffles-cheese-belgian-waffles",
        "en": {
          "title": "Cook the waffles",
          "description": "Preheat your waffle iron and lightly grease it with vegetable oil. Spoon a small amount of batter onto the center of the plate, close the lid, and cook for 4-5 minutes until golden brown and crispy."
        }
      }
