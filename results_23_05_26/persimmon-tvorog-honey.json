        "id": "warm-honey-persimmon-tvorog-honey",
        "en": {
          "title": "Warm honey in microwave",
          "description": "Heat the honey in the microwave in short 10-second bursts, stirring in between. Do not let it boil; just melt it. Then set aside to cool."
        }
      },
      {
        "id": "cool-honey-persimmon-tvorog-honey",
        "en": {
          "title": "Let honey cool",
          "description": "Allow the warmed honey to cool down completely before using."
        }
      },
      {
        "id": "strain-tvorog-persimmon-tvorog-honey",
        "en": {
          "title": "Strain the tvorog",
          "description": "Press the tvorog through a fine sieve to make it smooth and creamy."
        }
      },
      {
        "id": "mix-tvorog-persimmon-tvorog-honey",
        "en": {
          "title": "Mix tvorog with sugar and sour cream",
          "description": "Combine the strained tvorog with 2 tablespoons of sugar and the sour cream. Stir until homogeneous."
        }
      },
      {
        "id": "divide-tvorog-persimmon-tvorog-honey",
        "en": {
          "title": "Divide mixture into bowls",
          "description": "Spoon the tvorog mixture into individual serving bowls or ramekins."
        }
      },
      {
        "id": "refrigerate-tvorog-persimmon-tvorog-honey",
        "en": {
          "title": "Chill the tvorog mixture",
          "description": "Place the bowls in the refrigerator to chill for at least 5 minutes."
        }
      },
      {
        "id": "cut-persimmon-persimmon-tvorog-honey",
        "en": {
          "title": "Cut persimmon into wedges",
          "description": "Slice the persimmon into small wedges and remove any seeds."
        }
      },
      {
        "id": "melt-sugar-persimmon-tvorog-honey",
        "en": {
          "title": "Melt sugar in pan",
          "description": "Sprinkle the remaining 2 tablespoons of sugar into a non‑stick frying pan and set over low heat. Wait until the sugar melts into a golden liquid, without stirring too much."
        }
      },
      {
        "id": "caramelize-persimmon-persimmon-tvorog-honey",
        "en": {
          "title": "Caramelize persimmon wedges",
          "description": "Add the persimmon wedges to the melted sugar. Fry over low heat, turning occasionally, until they are lightly caramelized. Transfer to a plate and let cool."
        }
      },
      {
        "id": "cool-persimmon-persimmon-tvorog-honey",
        "en": {
          "title": "Cool caramelized persimmon",
          "description": "Allow the persimmon wedges to cool completely so they firm up."
        }
      },
