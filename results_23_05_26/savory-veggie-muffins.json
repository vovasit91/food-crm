    "newCookingSteps": [
      {
        "id": "blanch-vegetables-savory-veggie-muffins",
        "en": {
          "title": "Blanch the vegetables",
          "description": "Bring 1-1.5 liters of water to a boil in a pot. Add half of the salt, then add the frozen vegetable mix. Boil for 2-3 minutes, then drain and rinse with cold water."
        }
      },
      {
        "id": "heat-kefir-savory-veggie-muffins",
        "en": {
          "title": "Heat the kefir",
          "description": "Pour the kefir into a microwave-safe bowl and heat it for 40-50 seconds until warm."
        }
      },
      {
        "id": "mix-dough-savory-veggie-muffins",
        "en": {
          "title": "Mix the dough",
          "description": "Add the remaining salt and baking powder to the warm kefir and whisk until frothy. In a separate bowl, mash the cottage cheese with the eggs. Pour in the kefir mixture and stir well. Add the flour and mix until a thick dough forms."
        }
      },
      {
        "id": "prepare-vegetables-savory-veggie-muffins",
        "en": {
          "title": "Prepare and combine the vegetables",
          "description": "Pat the blanched vegetables dry with paper towels. Cut any large pieces into 1 cm cubes. Add the vegetables, smoked paprika, black pepper, and ground coriander to the dough. Gently mix until evenly combined."
        }
      },
      {
        "id": "preheat-oven-savory-veggie-muffins",
        "en": {
          "title": "Preheat the oven",
          "description": "Preheat your oven to 180°C (350°F)."
        }
      },
      {
        "id": "bake-muffins-savory-veggie-muffins",
        "en": {
          "title": "Bake the muffins",
          "description": "Grease muffin tins with vegetable oil. Divide the dough evenly among the tins. Bake for 30-35 minutes until golden and a toothpick inserted comes out clean."
        }
      }
    ],
