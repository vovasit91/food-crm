    "newCookingSteps": [
      {
        "id": "cut-fish-vegetables-cod-envelopes",
        "en": {
          "title": "Cut fish and vegetables",
          "description": "Cut the cod fillet into 6 pieces about 7–8 cm long. Slice the onion into thin rings and cut the tomato into rounds 2–3 mm thick."
        }
      },
      {
        "id": "cut-lavash-cod-envelopes",
        "en": {
          "title": "Cut the lavash",
          "description": "Cut the lavash sheets into 6 strips, making each strip about 3–4 cm wider than the cod pieces."
        }
      },
      {
        "id": "layer-onion-cod-cod-envelopes",
        "en": {
          "title": "Layer onion and cod on lavash",
          "description": "Place onion rings on each lavash strip. Put a cod piece on top and season evenly with salt and black pepper."
        }
      },
      {
        "id": "make-sauce-cod-envelopes",
        "en": {
          "title": "Make the sauce",
          "description": "In a bowl, combine the sour cream and mayonnaise and mix well."
        }
      },
      {
        "id": "fill-envelopes-cod-envelopes",
        "en": {
          "title": "Fill and fold the envelopes",
          "description": "Brush each cod piece with 1 tablespoon of the sauce, then top with tomato slices. Fold the lavash strips over the filling to form envelopes."
        }
      },
      {
        "id": "preheat-oven-cod-envelopes",
        "en": {
          "title": "Preheat the oven",
          "description": "Preheat your oven to 180°C."
        }
      },
      {
        "id": "prepare-dish-cod-envelopes",
        "en": {
          "title": "Prepare the baking dish",
          "description": "Grease a baking dish with 1 tablespoon of sunflower oil. Place the envelopes tightly in the dish, brush them with the remaining oil, and pour the remaining sauce over the top."
        }
      },
      {
        "id": "bake-envelopes-cod-envelopes",
        "en": {
          "title": "Bake the envelopes",
          "description": "Bake the cod envelopes in the preheated oven at 180°C for 25–30 minutes until the fish is cooked through and the lavash is golden."
        }
      }
    ],
