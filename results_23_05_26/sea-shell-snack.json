    "newCookingSteps": [
      {
        "id": "roll-pastry-sea-shell-snack",
        "en": {
          "title": "Roll out the pastry",
          "description": "Dust your work surface with flour and roll the puff pastry into a 5 mm thick sheet."
        }
      },
      {
        "id": "cut-pastry-circles-sea-shell-snack",
        "en": {
          "title": "Cut out circles",
          "description": "Use a cookie cutter to cut 9 identical circles from the pastry sheet."
        }
      },
      {
        "id": "fold-pastry-circles-sea-shell-snack",
        "en": {
          "title": "Fold the circles",
          "description": "Fold one edge of each circle toward the center to create a small pillow shape."
        }
      },
      {
        "id": "score-pastry-circles-sea-shell-snack",
        "en": {
          "title": "Score the folded edge",
          "description": "Use the back of a knife to make crosswise lines on the folded part of each circle."
        }
      },
      {
        "id": "place-and-brush-pastry-sea-shell-snack",
        "en": {
          "title": "Arrange and brush with egg",
          "description": "Place the pastry shells on a parchment-lined baking sheet and brush them with beaten egg."
        }
      },
      {
        "id": "bake-pastry-shells-sea-shell-snack",
        "en": {
          "title": "Bake the pastry shells",
          "description": "Bake in a preheated oven at 180°C for 15–20 minutes until golden. Then remove and let cool completely."
        }
      },
      {
        "id": "dice-pickles-sea-shell-snack",
        "en": {
          "title": "Dice the pickled cucumbers",
          "description": "Finely dice the pickled cucumbers into small cubes."
        }
      },
      {
        "id": "mix-tuna-filling-sea-shell-snack",
        "en": {
          "title": "Mix the tuna filling",
          "description": "Combine the diced pickles with canned tuna, add mayonnaise, salt, and pepper, and mix everything thoroughly."
        }
      },
      {
        "id": "boil-quail-eggs-sea-shell-snack",
        "en": {
          "title": "Boil the quail eggs",
          "description": "Place the quail eggs in a pot of cold water, bring to a boil over medium heat, and cook for 4–5 minutes. Do not overcook."
        }
      },
      {
        "id": "cool-and-peel-quail-eggs-sea-shell-snack",
        "en": {
          "title": "Cool and peel the eggs",
          "description": "Transfer the boiled eggs to ice water, let them cool, then peel carefully."
        }
      },
      {
        "id": "cut-pastry-shells-sea-shell-snack",
        "en": {
          "title": "Cut the pastry shells",
          "description": "Slice each baked pastry shell lengthwise, leaving 1–2 cm attached to create an opening."
        }
      },
      {
        "id": "fill-pastry-shells-sea-shell-snack",
        "en": {
          "title": "Fill and top the shells",
          "description": "Spoon the tuna mixture into each shell, spread it evenly, and place a peeled quail egg on top."
        }
      }
    ],
