    "newCookingSteps": [
      {
        "id": "activate-yeast-lemon-bread",
        "en": {
          "title": "Activate the yeast",
          "description": "Dissolve the dry yeast, 2 tablespoons of flour, and 1 teaspoon of sugar in warm water. Let it stand in a warm place for 15 minutes until the yeast activates."
        }
      },
      {
        "id": "add-wet-ingredients-lemon-bread",
        "en": {
          "title": "Add wet ingredients",
          "description": "Add sour cream and butter to the sponge. Crack in 1 egg, then add salt, 50 g sugar, and vanilla extract. Mix well."
        }
      },
      {
        "id": "mix-dough-lemon-bread",
        "en": {
          "title": "Mix the dough",
          "description": "Add the flour and mix with a mixer until smooth. Cover the bowl with plastic wrap and let rise for 1.5 hours."
        }
      },
      {
        "id": "let-dough-rise-lemon-bread",
        "en": {
          "title": "Let the dough rise",
          "description": "Allow the dough to rise in a warm place for 1.5 hours until doubled in size."
        }
      },
      {
        "id": "prepare-filling-lemon-bread",
        "en": {
          "title": "Prepare the filling",
          "description": "In a separate bowl, combine sour cream with the remaining sugar and 2 tablespoons of flour. Stir in the lemon juice and mix well."
        }
      },
      {
        "id": "roll-dough-lemon-bread",
        "en": {
          "title": "Roll out the dough",
          "description": "Lay a sheet of parchment paper dusted with 3 tablespoons of flour. Roll the dough into a rectangle about 25 by 35 cm."
        }
      },
      {
        "id": "spread-lemon-honey-lemon-bread",
        "en": {
          "title": "Spread lemon honey",
          "description": "Visually divide the dough into three parts. Spread the central third with grated lemon mixed with honey."
        }
      },
      {
        "id": "spread-cream-cut-strips-lemon-bread",
        "en": {
          "title": "Spread cream and cut strips",
          "description": "Evenly spread the lemon cream over the sour cream mixture. Cut the free dough sections into 1 cm wide strips, perpendicular to the filling, ensuring an equal number on each side."
        }
      },
      {
        "id": "braid-dough-lemon-bread",
        "en": {
          "title": "Braid the dough",
          "description": "Weave the strips into a braid over the filling. Transfer the braid with parchment to a baking sheet, cover with a towel, and let rise for 50 minutes."
        }
      },
      {
        "id": "let-shaped-dough-rise-lemon-bread",
        "en": {
          "title": "Let the shaped dough rise",
          "description": "Allow the braided bread to rest and rise for 50 minutes in a warm place."
        }
      },
      {
        "id": "preheat-oven-lemon-bread",
        "en": {
          "title": "Preheat the oven",
          "description": "Preheat your oven to 190°C (375°F) in preparation for baking."
        }
      },
      {
        "id": "brush-egg-sprinkle-lemon-bread",
        "en": {
          "title": "Brush with egg and sprinkle",
          "description": "Brush the risen dough with the remaining beaten egg and sprinkle with decorative sprinkles."
        }
      },
      {
        "id": "bake-bread-lemon-bread",
        "en": {
          "title": "Bake the bread",
          "description": "Bake the bread in the preheated oven for 25-30 minutes until golden brown. Allow to cool before slicing."
        }
      }
    ],
