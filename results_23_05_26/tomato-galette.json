    "newCookingSteps": [
      {
        "id": "roll-pastry-tomato-galette",
        "en": {
          "title": "Roll out the pastry",
          "description": "Roll out the puff pastry into a thin sheet. Trim uneven edges. Line a baking tray with parchment. Fold the edges to form a small rim. Prick the pastry with a fork in several places to prevent puffing."
        }
      },
      {
        "id": "freeze-dough-tomato-galette",
        "en": {
          "title": "Freeze the dough with weights",
          "description": "Cover the dough with another sheet of parchment. Pour dry beans or peas onto the paper to act as weights. Place the tray in the freezer for 15 minutes."
        }
      },
      {
        "id": "prepare-baking-tomatoes-tomato-galette",
        "en": {
          "title": "Prepare tomatoes for baking",
          "description": "Slice the tomatoes intended for baking into 5 mm rounds. Arrange them on a second baking tray. Top with thyme sprigs. Crush garlic cloves with a knife and scatter over the tomatoes. Season with salt, pepper, and drizzle with olive oil."
        }
      },
      {
        "id": "preheat-oven-tomato-galette",
        "en": {
          "title": "Preheat the oven",
          "description": "Preheat your oven to 200°C (400°F)."
        }
      },
      {
        "id": "bake-pastry-tomatoes-tomato-galette",
        "en": {
          "title": "Bake the pastry and tomatoes",
          "description": "Place the tray with the pastry and the tray with the tomatoes in the oven. Bake for 20 minutes."
        }
      },
      {
        "id": "cool-pastry-tomato-galette",
        "en": {
          "title": "Cool the pastry and tomatoes",
          "description": "Remove both trays from the oven and let them cool completely. Once cool, carefully remove the parchment with beans from the pastry."
        }
      },
      {
        "id": "blend-ricotta-cream-tomato-galette",
        "en": {
          "title": "Blend the ricotta cream",
          "description": "In a blender, combine ricotta, sour cream, roasted garlic cloves, basil leaves, salt, and pepper. Blend until smooth."
        }
      },
      {
        "id": "marinate-fresh-tomatoes-tomato-galette",
        "en": {
          "title": "Marinate fresh tomatoes",
          "description": "Slice the remaining fresh tomatoes into 5 mm rounds. Halve the cherry tomatoes. Place them in a bowl, season with salt and pepper, and let sit for 15 minutes to release juices. Then drain the liquid and pat the tomatoes dry with paper towels."
        }
      },
      {
        "id": "assemble-galette-tomato-galette",
        "en": {
          "title": "Assemble the galette",
          "description": "Spread the ricotta cream over the cooled pastry base. First arrange the baked tomatoes on top, then the fresh tomatoes. Sprinkle with pepper. Garnish with thinly sliced basil leaves."
        }
      }
    ],
