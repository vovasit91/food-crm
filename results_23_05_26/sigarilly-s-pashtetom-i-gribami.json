        "en": {
          "title": "Cut the phyllo dough",
          "description": "Cut a strip of phyllo dough 15 cm wide and 17 cm long. Keep the remaining dough covered with a damp towel to prevent drying."
        }
      },
      {
        "id": "cover-phyllo-sigarilly-s-pashtetom-i-gribami",
        "en": {
          "title": "Cover remaining phyllo",
          "description": "Cover the unused phyllo with a damp kitchen towel to keep it moist."
        }
      },
      {
        "id": "separate-sheets-sigarilly-s-pashtetom-i-gribami",
        "en": {
          "title": "Separate three sheets",
          "description": "Gently separate three sheets of phyllo from the cut strip."
        }
      },
      {
        "id": "layer-phyllo-sigarilly-s-pashtetom-i-gribami",
        "en": {
          "title": "Layer the phyllo",
          "description": "Brush the first sheet with oil, cover with the second sheet, brush again, and place the third sheet on top."
        }
      },
      {
        "id": "fill-phyllo-sigarilly-s-pashtetom-i-gribami",
        "en": {
          "title": "Fill the phyllo",
          "description": "Place the mushroom-pâté filling in the center of the layered phyllo, leaving 1–2 cm of space around the edges."
        }
      },
      {
        "id": "roll-sigarilla-sigarilly-s-pashtetom-i-gribami",
        "en": {
          "title": "Roll the sigarilla",
          "description": "Fold in the edges and roll the phyllo tightly into a cigar shape."
        }
      },
      {
        "id": "repeat-assembly-sigarilly-s-pashtetom-i-gribami",
        "en": {
          "title": "Repeat with remaining dough",
          "description": "Repeat the layering, filling, and rolling process with the remaining phyllo dough and filling."
        }
      },
      {
        "id": "preheat-oven-sigarilly-s-pashtetom-i-gribami",
        "en": {
          "title": "Preheat the oven",
          "description": "Preheat your oven to 180°C (350°F)."
        }
      },
      {
        "id": "arrange-sigarillas-sigarilly-s-pashtetom-i-gribami",
        "en": {
          "title": "Arrange on baking sheet",
          "description": "Place the rolled sigarillas on a baking tray lined with parchment paper."
        }
      },
      {
        "id": "brush-egg-sigarilly-s-pashtetom-i-gribami",
        "en": {
          "title": "Brush with egg",
          "description": "Brush the tops of the sigarillas with beaten egg."
        }
      },
      {
        "id": "sprinkle-sesame-sigarilly-s-pashtetom-i-gribami",
        "en": {
          "title": "Sprinkle sesame seeds",
          "description": "Sprinkle sesame seeds over the egg-washed sigarillas."
