    "newCookingSteps": [
      {
        "id": "preheat-oven-cauliflower-toasts",
        "en": {
          "title": "Preheat the oven",
          "description": "Preheat the oven to 200°C (400°F)."
        }
      },
      {
        "id": "season-cauliflower-cauliflower-toasts",
        "en": {
          "title": "Season the cauliflower",
          "description": "Arrange the cauliflower florets on a baking sheet lined with parchment. Sprinkle with salt, red pepper (or chili), and black pepper. Drizzle with olive oil."
        }
      },
      {
        "id": "bake-cauliflower-cauliflower-toasts",
        "en": {
          "title": "Bake the cauliflower",
          "description": "Bake the cauliflower in the preheated oven for 30 minutes, turning the florets twice during baking, until tender and lightly browned."
        }
      },
      {
        "id": "cool-cauliflower-cauliflower-toasts",
        "en": {
          "title": "Cool and break the cauliflower",
          "description": "Remove the cauliflower from the oven and let it cool slightly. Then break the florets into smaller pieces."
        }
      },
      {
        "id": "mix-filling-cauliflower-toasts",
        "en": {
          "title": "Prepare the filling",
          "description": "Grate two-thirds of the Parmesan cheese. Slice the prosciutto into thin strips. In a bowl, combine the cooled cauliflower, grated Parmesan, prosciutto, and mascarpone. Season with salt, pepper, and nutmeg, and mix well."
        }
      },
      {
        "id": "toast-bread-cauliflower-toasts",
        "en": {
          "title": "Toast the bread",
          "description": "Toast the bread slices in a dry skillet or toaster until golden brown on both sides."
        }
      },
      {
        "id": "bake-toasts-cauliflower-toasts",
        "en": {
          "title": "Bake the toasts",
          "description": "Spread the filling thickly on each toast. Sprinkle with paprika. Return to the oven and bake for 3-4 minutes at 200°C, until the toasts are golden and heated through."
        }
      },
      {
        "id": "prepare-garnish-cauliflower-toasts",
        "en": {
          "title": "Prepare the garnish",
          "description": "Grate the remaining Parmesan into fine crumbs. Finely chop the chives. Sprinkle over the baked toasts before serving."
        }
      }
    ],
