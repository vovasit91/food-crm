    "newCookingSteps": [
      {
        "id": "mix-semolina-sour-cream-sour-cream-semolina-cake",
        "en": {
          "title": "Mix semolina with sour cream",
          "description": "In a bowl, combine the semolina and sour cream. Stir well until fully incorporated."
        }
      },
      {
        "id": "soak-semolina-sour-cream-semolina-cake",
        "en": {
          "title": "Let the semolina soak",
          "description": "Allow the semolina to sit in the sour cream for 15–20 minutes. During this time, the semolina will absorb the liquid and swell."
        }
      },
      {
        "id": "melt-butter-sour-cream-semolina-cake",
        "en": {
          "title": "Melt the butter",
          "description": "Place the butter in a microwave-safe bowl. Melt it in the microwave in 2–3 intervals of 20–30 seconds each, until fully melted."
        }
      },
      {
        "id": "preheat-oven-sour-cream-semolina-cake",
        "en": {
          "title": "Preheat the oven",
          "description": "Set your oven to preheat to 180°C (350°F). This ensures it is ready when you need to bake the cake."
        }
      },
      {
        "id": "beat-eggs-mixture-sour-cream-semolina-cake",
        "en": {
          "title": "Beat eggs with condensed milk and salt",
          "description": "Crack the eggs into a deep bowl. Add the condensed milk and salt. Beat with a mixer on medium speed for 2–3 minutes until the mixture is fluffy and homogeneous."
        }
      },
      {
        "id": "combine-dough-sour-cream-semolina-cake",
        "en": {
          "title": "Combine all ingredients into a dough",
          "description": "Add the flour and baking powder to the egg mixture. Then add the melted butter and the soaked semolina. Mix with a mixer until smooth and well combined."
        }
      },
      {
        "id": "bake-cake-sour-cream-semolina-cake",
        "en": {
          "title": "Bake the cake",
          "description": "Pour the batter into a greased or parchment-lined baking pan. Smooth the top. Bake in the preheated oven at 180°C for 40–45 minutes until the top is caramel-brown and a toothpick inserted comes out clean."
        }
      },
      {
        "id": "cool-cake-sour-cream-semolina-cake",
        "en": {
          "title": "Cool and serve",
          "description": "Let the cake cool in the pan for a few minutes, then carefully transfer it to a serving plate. Allow it to cool completely before slicing, or serve warm."
        }
      }
