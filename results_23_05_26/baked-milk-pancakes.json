    "newCookingSteps": [
      {
        "id": "melt-butter-baked-milk-pancakes",
        "en": {
          "title": "Melt the butter",
          "description": "Place the butter in a microwave-safe bowl and melt it in short bursts until fully melted. Set aside to cool."
        }
      },
      {
        "id": "cool-butter-baked-milk-pancakes",
        "en": {
          "title": "Cool the butter",
          "description": "Let the melted butter cool to room temperature so it doesn't cook the eggs."
        }
      },
      {
        "id": "heat-milk-baked-milk-pancakes",
        "en": {
          "title": "Warm the baked milk",
          "description": "Gently warm the baked milk in a microwave or on the stove until it is warm to the touch but not boiling."
        }
      },
      {
        "id": "separate-eggs-baked-milk-pancakes",
        "en": {
          "title": "Separate egg yolks and whites",
          "description": "Carefully separate the egg whites from the yolks, ensuring no yolk gets into the whites."
        }
      },
      {
        "id": "whisk-yolks-with-sugar-baked-milk-pancakes",
        "en": {
          "title": "Whisk yolks with sugar",
          "description": "Combine the egg yolks with 2 tablespoons of sugar and whisk vigorously until the mixture becomes pale and fluffy, about 3-4 minutes."
        }
      },
      {
        "id": "combine-yolks-butter-milk-baked-milk-pancakes",
        "en": {
          "title": "Combine yolk mixture with butter and milk",
          "description": "Pour the cooled butter and warmed milk into the yolk mixture. Mix with a blender on low speed until well combined."
        }
      },
      {
        "id": "mix-flour-baking-powder-baked-milk-pancakes",
        "en": {
          "title": "Mix flour and baking powder",
          "description": "In a separate bowl, whisk together the flour and baking powder to ensure even distribution."
        }
      },
      {
        "id": "add-dry-to-wet-baked-milk-pancakes",
        "en": {
          "title": "Add dry ingredients to wet",
          "description": "Gradually add the flour mixture to the egg mixture, stirring gently until just combined. Do not overmix."
        }
      },
      {
        "id": "whip-egg-whites-sugar-baked-milk-pancakes",
        "en": {
          "title": "Whip egg whites with sugar",
          "description": "Place the egg whites in a clean, dry blender bowl. Add the remaining sugar and whip on low speed, gradually increasing, until stiff peaks form. The whites should hold their shape."
        }
      },
      {
        "id": "fold-egg-whites-into-batter-baked-milk-pancakes",
        "en": {
          "title": "Fold egg whites into batter",
          "description": "Gently fold the whipped egg whites into the batter using a spatula. Use an up-and-down motion to keep the batter airy. The batter should be slightly thicker than regular pancake batter."
        }
      },
      {
        "id": "heat-pan-baked-milk-pancakes",
        "en": {
          "title": "Heat a non-stick pan",
          "description": "Place a non-stick frying pan over low heat and let it warm up for about 2 minutes."
        }
      },
      {
        "id": "cook-first-side-baked-milk-pancakes",
        "en": {
          "title": "Cook the first side of the pancake",
          "description": "Pour about half a ladleful of batter into the pan to form a round pancake. Cook on low heat until bubbles appear on the surface and the edges look set, about 2-4 minutes."
        }
      },
      {
        "id": "flip-and-cook-second-side-baked-milk-pancakes",
        "en": {
          "title": "Flip and cook the second side",
          "description": "Carefully flip the pancake with a spatula and cook for another 1-2 minutes until golden brown. Transfer to a plate."
        }
      },
      {
        "id": "cook-remaining-pancakes-baked-milk-pancakes",
        "en": {
          "title": "Cook the remaining pancakes",
          "description": "Repeat the process with the remaining batter, cooking each pancake for 2-4 minutes on the first side and 1-2 minutes on the second side. Stack them as you go."
        }
      }
    ],
