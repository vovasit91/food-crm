    "newCookingSteps": [
      {
        "id": "prepare-batter-egg-crepes-with-mince",
        "en": {
          "title": "Prepare the batter",
          "description": "Crack the eggs into a bowl and add the milk. Sprinkle in the salt and pepper. Whisk until smooth and uniform."
        }
      },
      {
        "id": "fry-crepes-egg-crepes-with-mince",
        "en": {
          "title": "Fry the egg crepes",
          "description": "Heat the vegetable oil in a frying pan over medium heat. Pour a thin layer of the egg mixture into the pan, swirling to cover the bottom. Cook until lightly golden on both sides. Transfer to a plate and repeat with the remaining batter to make about 7 crepes."
        }
      },
      {
        "id": "prepare-filling-egg-crepes-with-mince",
        "en": {
          "title": "Prepare the minced filling",
          "description": "Grate the onion on a coarse grater. Add it to the ground chicken along with the salt, dried basil, mince seasoning, and chopped fresh parsley. Mix thoroughly until all the spices are evenly distributed."
        }
      },
      {
        "id": "prepare-sauce-egg-crepes-with-mince",
        "en": {
          "title": "Prepare the sour cream sauce",
          "description": "In a bowl, combine the sour cream with salt and pepper. Press the garlic cloves through a press into the bowl. Finely chop the dill and add it. Stir until smooth."
        }
      },
      {
        "id": "divide-and-spread-mince-egg-crepes-with-mince",
        "en": {
          "title": "Divide and spread the mince",
          "description": "Divide the prepared mince mixture and the sour cream sauce among the egg crepes. Spread the mince evenly over each crepe."
        }
      },
      {
        "id": "spread-cream-egg-crepes-with-mince",
        "en": {
          "title": "Spread the cream layer",
          "description": "Spread a thin layer of the sour cream sauce over the mince on each crepe."
        }
      },
      {
        "id": "grate-cheese-and-sprinkle-egg-crepes-with-mince",
        "en": {
          "title": "Grate and sprinkle the cheese",
          "description": "Grate the hard cheese and sprinkle it evenly over the filling on each crepe."
        }
      },
      {
        "id": "roll-crepes-egg-crepes-with-mince",
        "en": {
          "title": "Roll the crepes into rolls",
          "description": "Fold the right and left edges of each crepe inward to keep the filling inside, then tightly roll the crepe into a log. Repeat for all crepes."
        }
      },
      {
        "id": "bake-crepes-egg-crepes-with-mince",
        "en": {
          "title": "Bake the rolls",
          "description": "Line a baking dish with parchment paper and place the rolled crepes in it. Brush them with a little extra sour cream. Bake at 180°C (350°F) for 35–40 minutes until golden and heated through."
        }
      }
    ],
