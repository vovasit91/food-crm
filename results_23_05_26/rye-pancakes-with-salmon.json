    "newCookingSteps": [
      {
        "id": "mix-dry-ingredients-rye-pancakes-with-salmon",
        "en": {
          "title": "Mix the dry ingredients",
          "description": "In a bowl, combine the rye flour, wheat flour, and baking soda. Stir them together with a whisk or spoon until evenly distributed."
        }
      },
      {
        "id": "heat-kefir-rye-pancakes-with-salmon",
        "en": {
          "title": "Warm the kefir",
          "description": "Place the kefir in a microwave-safe bowl and heat it on high for about 30 seconds until it is just warm to the touch. Do not let it boil."
        }
      },
      {
        "id": "whisk-eggs-sugar-kefir-oil-rye-pancakes-with-salmon",
        "en": {
          "title": "Whisk eggs, sugar, kefir, and oil",
          "description": "In a separate bowl, crack the eggs and add the sugar. Whisk until the sugar is completely dissolved. Then pour in the warmed kefir and the vegetable oil and whisk again until smooth."
        }
      },
      {
        "id": "add-dry-mixture-gradually-rye-pancakes-with-salmon",
        "en": {
          "title": "Gradually add the dry mixture",
          "description": "Slowly sift or sprinkle the dry flour mixture into the wet ingredients while whisking continuously. Make sure there are no lumps. The batter should be thick and smooth, about the consistency of sour cream."
        }
      },
      {
        "id": "add-hot-water-rye-pancakes-with-salmon",
        "en": {
          "title": "Add hot water and mix",
          "description": "Pour hot (not boiling) water into the batter and stir quickly. The batter will thin out slightly."
        }
      },
      {
        "id": "rest-batter-rye-pancakes-with-salmon",
        "en": {
          "title": "Rest the batter",
          "description": "Let the batter stand at room temperature for 10 minutes. This allows the gluten to relax and the baking soda to activate."
        }
      },
      {
        "id": "heat-pan-rye-pancakes-with-salmon",
        "en": {
          "title": "Heat the pan",
          "description": "Place a non-stick frying pan over medium heat and let it warm up for about 2 minutes before adding the batter."
        }
      },
      {
        "id": "fry-pancakes-rye-pancakes-with-salmon",
        "en": {
          "title": "Fry the pancakes",
          "description": "Pour about three-quarters of a ladle of batter into the hot pan and tilt to spread it into a thin, even circle. Cook for 1–2 minutes per side until golden brown. Repeat with the remaining batter, stacking the finished pancakes on a plate."
        }
      },
      {
        "id": "slice-salmon-rye-pancakes-with-salmon",
        "en": {
          "title": "Slice the salmon",
          "description": "Cut the red fish (salmon) into thin, even slices. Set aside."
        }
      },
      {
        "id": "assemble-pancakes-rye-pancakes-with-salmon",
        "en": {
          "title": "Assemble the pancakes",
          "description": "Spread a generous layer of cream cheese over each pancake. Place a few slices of salmon near one edge, then roll the pancake tightly into a log. Serve immediately or cut into pieces."
        }
      }
    ],
