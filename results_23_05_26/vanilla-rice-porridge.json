    "newCookingSteps": [
      {
        "id": "heat-milk-cream-vanilla-rice-porridge",
        "en": {
          "title": "Heat milk and cream for custard",
          "description": "Combine the cream and milk for the custard in a small saucepan. Place over low heat and warm until steam starts to rise. Remove from heat."
        }
      },
      {
        "id": "whisk-yolks-vanilla-rice-porridge",
        "en": {
          "title": "Whisk egg yolks with sugar and temper",
          "description": "In a bowl, whisk the egg yolks with 1 tablespoon of sugar until well combined. Gradually add about 100 ml of the hot milk mixture, whisking constantly to temper the yolks."
        }
      },
      {
        "id": "cook-custard-vanilla-rice-porridge",
        "en": {
          "title": "Cook the custard until thickened",
          "description": "Pour the egg mixture back into the saucepan with the remaining milk and cream. Place over low heat and cook, stirring gently, until the custard thickens enough to coat the back of a spoon."
        }
      },
      {
        "id": "strain-custard-vanilla-rice-porridge",
        "en": {
          "title": "Strain and cover the custard",
          "description": "Pass the custard through a fine-mesh sieve into a clean bowl. Press plastic wrap directly onto the surface of the custard (contact method) and set aside."
        }
      },
      {
        "id": "combine-rice-ingredients-vanilla-rice-porridge",
        "en": {
          "title": "Combine rice and remaining ingredients",
          "description": "Place the rice in a heavy-bottomed pot. Add the milk, cream, sugar, and vanilla essence. Stir everything together thoroughly."
        }
      },
      {
        "id": "bring-to-boil-vanilla-rice-porridge",
        "en": {
          "title": "Bring the rice mixture to a boil",
          "description": "Set the pot over medium heat and bring to a boil, stirring constantly to prevent the rice from sticking."
        }
      },
      {
        "id": "simmer-rice-vanilla-rice-porridge",
        "en": {
          "title": "Simmer the rice until creamy",
          "description": "Reduce the heat to the lowest setting and simmer gently for 30–35 minutes, stirring occasionally, until the rice is soft and the mixture is creamy. About 5 minutes before the end of cooking, add a pinch of salt and stir."
        }
      }
    ],
