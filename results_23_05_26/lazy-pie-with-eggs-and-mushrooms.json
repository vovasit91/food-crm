        }
      },
      {
        "id": "transfer-filling-lazy-pie-with-eggs-and-mushrooms",
        "en": {
          "title": "Transfer filling",
          "description": "Transfer the cooked onion and mushrooms to a plate."
        }
      },
      {
        "id": "whisk-eggs-cream-lazy-pie-with-eggs-and-mushrooms",
        "en": {
          "title": "Whisk eggs and cream",
          "description": "In a separate bowl, whisk together the eggs, cream, salt, and pepper until well combined."
        }
      },
      {
        "id": "cook-omelet-lazy-pie-with-eggs-and-mushrooms",
        "en": {
          "title": "Cook omelet",
          "description": "Pour the egg mixture into the hot skillet and cook covered over medium heat for 3-4 minutes until set. Be careful not to overcook."
        }
      },
      {
        "id": "combine-filling-lazy-pie-with-eggs-and-mushrooms",
        "en": {
          "title": "Combine filling",
          "description": "Transfer the cooked omelet to the plate with mushrooms and mix everything together thoroughly."
        }
      },
      {
        "id": "mix-wet-dough-lazy-pie-with-eggs-and-mushrooms",
        "en": {
          "title": "Mix wet dough ingredients",
          "description": "In a clean bowl, combine the eggs, mayonnaise, sour cream, and vodka. Whisk until smooth."
        }
      },
      {
        "id": "add-dry-to-dough-lazy-pie-with-eggs-and-mushrooms",
        "en": {
          "title": "Add dry ingredients",
          "description": "Sift in the flour and baking powder, then stir until the batter is smooth and lump-free. The dough should be runny but slightly thick, like pancake batter."
        }
      },
      {
        "id": "grease-pan-lazy-pie-with-eggs-and-mushrooms",
        "en": {
          "title": "Grease baking dish",
          "description": "Grease a baking dish with the remaining vegetable oil."
        }
      },
      {
        "id": "pour-dough-and-top-lazy-pie-with-eggs-and-mushrooms",
        "en": {
          "title": "Assemble the pie",
          "description": "Pour the batter into the prepared dish. Evenly distribute the mushroom-omelet filling on top and sprinkle with grated cheese."
        }
      },
      {
        "id": "bake-pie-lazy-pie-with-eggs-and-mushrooms",
        "en": {
          "title": "Bake the pie",
