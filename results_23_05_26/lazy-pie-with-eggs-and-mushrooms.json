        "en": {
          "title": "Heat oil",
          "description": "Heat 1 tablespoon of vegetable oil in a skillet over medium heat."
        }
      },
      {
        "id": "fry-onion-lazy-pie-with-eggs-and-mushrooms",
        "en": {
          "title": "Fry onion",
          "description": "Add the chopped onion and sauté until soft and translucent."
        }
      },
      {
        "id": "add-mushrooms-and-cook-lazy-pie-with-eggs-and-mushrooms",
        "en": {
          "title": "Add mushrooms and cook",
