    "newCookingSteps": [
      {
        "id": "boil-egg-avocado-sandwiches-breakfast",
        "en": {
          "title": "Boil the egg",
          "description": "Place the egg in a small saucepan, cover with cold water, and bring to a boil. Boil for exactly 10 minutes from the moment the water starts boiling."
        }
      },
      {
        "id": "cool-peel-egg-avocado-sandwiches-breakfast",
        "en": {
          "title": "Cool and peel the egg",
          "description": "Transfer the boiled egg to a bowl of ice water and let it cool completely. Once cool, peel off the shell and set aside."
        }
      },
      {
        "id": "toast-bread-avocado-sandwiches-breakfast",
        "en": {
          "title": "Toast the bread",
          "description": "Heat a dry skillet over medium heat. Toast the bread slices on both sides until golden brown, about 2 minutes per side. Alternatively, you can use a toaster."
        }
      },
      {
        "id": "chop-prepare-ingredients-avocado-sandwiches-breakfast",
        "en": {
          "title": "Chop and prepare the filling ingredients",
          "description": "Finely chop the crab sticks. Cut the cherry tomatoes into quarters. Mash the boiled egg with a fork until crumbly."
        }
      },
      {
        "id": "mix-filling-avocado-sandwiches-breakfast",
        "en": {
          "title": "Mix the filling",
          "description": "In a bowl, combine the chopped crab sticks, cherry tomatoes, and mashed egg. Add the cream cheese and stir until well combined."
        }
      },
      {
        "id": "mash-avocado-spread-avocado-sandwiches-breakfast",
        "en": {
          "title": "Mash avocado and spread on toast",
          "description": "Scoop the avocado flesh into a bowl and mash it with a fork until smooth. Spread the mashed avocado evenly over each toasted bread slice."
        }
      },
      {
        "id": "assemble-sandwiches-avocado-sandwiches-breakfast",
        "en": {
          "title": "Assemble the sandwiches",
          "description": "Spoon the egg and crab mixture onto the avocado-covered toasts. Sprinkle with freshly ground black pepper to taste."
        }
      }
    ],
