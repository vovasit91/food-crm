    "newCookingSteps": [
      {
        "id": "melt-butter-and-fry-spinach-green-oven-omelette",
        "en": {
          "title": "Melt butter and fry spinach",
          "description": "Melt half the butter in a frying pan over medium heat. Add the spinach and cook for 3 minutes until wilted."
        }
      },
      {
        "id": "chop-spinach-green-oven-omelette",
        "en": {
          "title": "Chop the spinach",
          "description": "Transfer the cooked spinach to a plate and chop it finely with a knife."
        }
      },
      {
        "id": "cut-bread-green-oven-omelette",
        "en": {
          "title": "Cut the bread into cubes",
          "description": "Remove crusts from the bread slices and cut the soft part into small cubes of about 2x2 cm."
        }
      },
      {
        "id": "grate-cheese-and-garlic-green-oven-omelette",
        "en": {
          "title": "Grate cheese and garlic",
          "description": "Finely grate the hard cheese and garlic clove."
        }
      },
      {
        "id": "whisk-eggs-green-oven-omelette",
        "en": {
          "title": "Whisk eggs with cream and spices",
          "description": "In a bowl, whisk together the eggs, cream, salt, pepper, and paprika until smooth."
        }
      },
      {
        "id": "combine-mixture-green-oven-omelette",
        "en": {
          "title": "Add spinach, garlic, and cheese to eggs",
          "description": "Add the chopped spinach, grated garlic, and cheese to the egg mixture. Stir well to combine."
        }
      },
      {
        "id": "pour-over-bread-and-mix-green-oven-omelette",
        "en": {
          "title": "Pour egg mixture over bread",
          "description": "Pour the egg mixture over the bread cubes and mix gently to ensure all pieces are coated."
        }
      },
      {
        "id": "soak-bread-green-oven-omelette",
        "en": {
          "title": "Let the bread soak",
          "description": "Let the bread soak in the egg mixture for 15 minutes so it absorbs the liquid."
        }
      },
      {
        "id": "grease-baking-dish-green-oven-omelette",
        "en": {
          "title": "Grease the baking dish",
          "description": "Use the remaining butter to grease a baking dish."
        }
      },
      {
        "id": "transfer-to-dish-green-oven-omelette",
        "en": {
          "title": "Transfer soaked bread to dish",
          "description": "Transfer the soaked bread and any remaining mixture into the greased baking dish."
        }
      },
      {
        "id": "bake-green-oven-omelette",
        "en": {
          "title": "Bake in preheated oven",
          "description": "Preheat the oven to 180°C. Bake the omelette for 15 minutes until golden and set."
        }
      }
    ],
