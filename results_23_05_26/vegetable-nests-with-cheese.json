        "en": {
          "title": "Shred the vegetables",
          "description": "Shred the zucchini, carrots, and potatoes into thin strips using a Korean carrot grater or a vegetable peeler with serrated blades."
        }
      },
      {
        "id": "salt-and-squeeze-vegetables-vegetable-nests-with-cheese",
        "en": {
          "title": "Salt and squeeze the vegetables",
          "description": "Transfer the shredded vegetables to a bowl, sprinkle with salt, and mix well. Let them rest for 10 minutes to release moisture. Then thoroughly squeeze out the liquid and transfer to another bowl."
        }
      },
      {
        "id": "mix-batter-vegetable-nests-with-cheese",
        "en": {
          "title": "Mix the batter",
          "description": "Add flour, eggs, salt, and pepper to the squeezed vegetables. Stir until well combined."
        }
      },
      {
        "id": "form-nests-vegetable-nests-with-cheese",
        "en": {
          "title": "Form the nests",
          "description": "Place the vegetable mixture onto a baking sheet lined with parchment paper, shaping it into small fist-sized nests."
        }
      },
      {
        "id": "bake-vegetable-nests-with-cheese",
        "en": {
          "title": "Bake the nests",
          "description": "Grate the cheese and fill the indentations in the nests. Optionally, place a cherry tomato in the center. Bake in the oven at 170°C for 30 minutes."
        }
      }
