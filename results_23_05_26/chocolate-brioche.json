    "newCookingSteps": [
      {
        "id": "crumble-yeast-chocolate-brioche",
        "en": {
          "title": "Crumble the yeast",
          "description": "Crumble fresh yeast into a deep bowl. Add milk, eggs, sour cream, and powdered sugar. Mix with a whisk or mixer until smooth."
        }
      },
      {
        "id": "add-flour-knead-chocolate-brioche",
        "en": {
          "title": "Knead the dough",
          "description": "Add about two-thirds of the flour and start mixing with a spoon, then with your hands. After 2–3 minutes, add salt and gradually add the remaining flour. Transfer the dough to the work surface and knead for 15–20 minutes, stretching it away from you, folding back, and turning. The dough should be elastic and not sticky."
        }
      },
      {
        "id": "add-chocolate-chocolate-brioche",
        "en": {
          "title": "Fold in chocolate",
          "description": "Add 80 g of chocolate pieces to the dough and knead briefly to distribute them evenly."
        }
      },
      {
        "id": "first-rise-chocolate-brioche",
        "en": {
          "title": "Let the dough rise",
          "description": "Shape the dough into a ball, place it in a lightly oiled bowl, cover with a damp towel, and leave in a warm place for 1.5 to 3 hours, until doubled in volume."
        }
      },
      {
        "id": "punch-and-shape-chocolate-brioche",
        "en": {
          "title": "Punch down and shape",
          "description": "Punch down the risen dough. Divide it into 12 equal pieces, shape each into a ball, and place them tightly in a greased baking pan."
        }
      },
      {
        "id": "second-rise-chocolate-brioche",
        "en": {
          "title": "Second proof",
          "description": "Sprinkle the remaining chocolate pieces over the dough balls, gently pressing them in. Cover with a towel and let rise for 1 to 1.5 hours."
        }
      },
      {
        "id": "preheat-oven-chocolate-brioche",
        "en": {
          "title": "Preheat the oven",
          "description": "Preheat your oven to 160°C (320°F)."
        }
      },
      {
        "id": "bake-chocolate-brioche",
        "en": {
          "title": "Bake the brioche",
          "description": "Bake the brioche for 25–30 minutes, until golden brown and cooked through. Serve warm or at room temperature."
        }
      }
    ],
