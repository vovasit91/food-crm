      },
      {
        "id": "cook-in-double-boiler-chocolate-cheese",
        "en": {
          "title": "Cook the mixture in a double boiler",
          "description": "Transfer the blended mixture to a heatproof bowl. Place it over a pot of simmering water to create a double boiler. Stir continuously until all lumps dissolve, about 10–15 minutes."
        }
      },
      {
        "id": "cool-mixture-chocolate-cheese",
