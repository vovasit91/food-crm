    "newCookingSteps": [
      {
        "id": "mix-dry-ingredients-turkish-cake",
        "en": {
          "title": "Mix dry ingredients",
          "description": "In a bowl, combine flour, baking powder, orange zest, and raisins. Stir until evenly distributed."
        }
      },
      {
        "id": "cream-butter-sugar-turkish-cake",
        "en": {
          "title": "Cream butter and sugar",
          "description": "In a separate bowl, beat the softened butter with half of the sugar until light and fluffy."
        }
      },
      {
        "id": "beat-egg-yolks-turkish-cake",
        "en": {
          "title": "Beat egg yolks with sugar",
          "description": "Separate the eggs. Beat the yolks with the remaining sugar until thick and pale."
        }
      },
      {
        "id": "combine-wet-and-flour-turkish-cake",
        "en": {
          "title": "Combine wet and dry mixtures",
          "description": "Add the yogurt and the butter mixture to the beaten yolks. Mix well, then gradually add the flour mixture, stirring until a smooth batter forms."
        }
      },
      {
        "id": "beat-egg-whites-turkish-cake",
        "en": {
          "title": "Beat egg whites to stiff peaks",
          "description": "In a clean bowl, beat the egg whites with lemon juice using a mixer until stiff peaks form."
        }
      },
      {
        "id": "fold-egg-whites-turkish-cake",
        "en": {
          "title": "Fold in egg whites",
          "description": "Gently fold the beaten egg whites into the batter using a spatula until just combined. Be careful not to deflate the mixture."
        }
      },
      {
        "id": "prepare-pan-and-preheat-turkish-cake",
        "en": {
          "title": "Prepare pan and preheat oven",
          "description": "Preheat the oven to 180°C (350°F). Grease a cake pan with butter and sprinkle sesame seeds evenly over the inside to coat."
        }
      },
      {
        "id": "bake-cake-turkish-cake",
        "en": {
          "title": "Bake the cake",
          "description": "Pour the batter into the prepared pan and smooth the top. Bake at 180°C for 15 minutes, then reduce the temperature to 160°C (325°F) and bake for another 45 minutes, until a toothpick inserted in the center comes out clean."
        }
      }
    ],
