    "newCookingSteps": [
      {
        "id": "mix-filling-orange-sochniki",
        "en": {
          "title": "Mix the filling",
          "description": "In a bowl, combine tvorog, sugar, sour cream, orange zest, and one egg yolk. Stir until smooth and homogeneous."
        }
      },
      {
        "id": "cream-butter-and-sugar-orange-sochniki",
        "en": {
          "title": "Cream butter and powdered sugar",
          "description": "In another bowl, rub the softened butter with the powdered sugar until light and fluffy."
        }
      },
      {
        "id": "add-egg-orange-sochniki",
        "en": {
          "title": "Add the egg",
          "description": "Add the whole egg to the butter mixture and mix well."
        }
      },
      {
        "id": "add-dry-ingredients-orange-sochniki",
        "en": {
          "title": "Add dry ingredients",
          "description": "Sift together the flour and baking powder, then add to the butter mixture along with a pinch of salt. Mix briefly."
        }
      },
      {
        "id": "knead-dough-orange-sochniki",
        "en": {
          "title": "Knead the dough",
          "description": "Knead the mixture until a smooth, uniform dough forms. Do not overwork it."
        }
      },
      {
        "id": "divide-dough-orange-sochniki",
        "en": {
          "title": "Divide the dough",
          "description": "Divide the dough into 8 equal pieces and shape each into a ball."
        }
      },
      {
        "id": "roll-fill-and-shape-pastries-orange-sochniki",
        "en": {
          "title": "Roll, fill, and shape the pastries",
          "description": "On a lightly floured surface, roll each dough ball into a circle about 3–4 mm thick. Place one-eighth of the filling on one half of the circle, then fold the other half over to form a half‑moon. Press the edges to seal. Repeat with remaining dough and filling. Transfer the shaped pastries to a parchment‑lined baking tray."
        }
      },
      {
        "id": "preheat-oven-orange-sochniki",
        "en": {
          "title": "Preheat the oven",
          "description": "Preheat your oven to 200°C (400°F)."
        }
      },
      {
        "id": "make-egg-wash-and-brush-orange-sochniki",
        "en": {
          "title": "Make egg wash and brush the pastries",
          "description": "Whisk the remaining egg yolk with the water. Using a pastry brush, lightly coat the tops of the pastries with the egg wash."
        }
      },
      {
        "id": "bake-sochniki-orange-sochniki",
        "en": {
          "title": "Bake the sochniki",
          "description": "Bake the pastries in the preheated oven for 20–25 minutes until golden brown. Remove from the oven and let cool slightly before serving."
        }
      }
    ],
