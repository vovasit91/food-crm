    "newCookingSteps": [
      {
        "id": "mix-filling-sandwiches-with-canned-salmon",
        "en": {
          "title": "Mix the fish filling",
          "description": "Place the canned salmon in a bowl and mash it with a fork. Squeeze the lemon juice over it. Add 2 tablespoons of mayonnaise, soy sauce, ginger, and sugar. Mix everything well."
        }
      },
      {
        "id": "chop-vegetables-sandwiches-with-canned-salmon",
        "en": {
          "title": "Chop the vegetables",
          "description": "Finely chop the celery stalk and green onions. Add them to the fish mixture and stir again."
        }
      },
      {
        "id": "make-wasabi-spread-sandwiches-with-canned-salmon",
        "en": {
          "title": "Make the wasabi spread",
          "description": "In a clean bowl, mix the remaining mayonnaise with the wasabi until smooth."
        }
      },
      {
        "id": "toast-bread-sandwiches-with-canned-salmon",
        "en": {
          "title": "Toast the bread",
          "description": "Heat a dry frying pan over medium heat. Brush the bread slices with vegetable oil. Toast them for 1–2 minutes per side until golden brown. Remove from the pan."
        }
      },
      {
        "id": "assemble-sandwiches-sandwiches-with-canned-salmon",
        "en": {
          "title": "Assemble the sandwiches",
          "description": "Spread the wasabi mayonnaise on one side of all bread slices. Place a lettuce leaf on 4 slices. Divide the fish mixture evenly among them. Cover with the remaining bread slices, spread side down."
        }
      }
    ],
