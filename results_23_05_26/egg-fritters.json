        "en": {
          "title": "Boil the egg",
          "description": "Boil one egg in water until hard-boiled, about 10 minutes. Then cool it under cold water, peel, and finely chop."
        }
      },
      {
        "id": "mash-tvorog-egg-fritters",
        "en": {
          "title": "Mash the tvorog",
          "description": "In a bowl, mash the tvorog (cottage cheese) with a fork. Add the chopped boiled egg and mix."
        }
      },
      {
        "id": "grate-cheese-egg-fritters",
        "en": {
          "title": "Grate cheese and add flour",
          "description": "Grate the hard cheese on a fine grater. Add it to the bowl along with the flour."
        }
      },
      {
        "id": "mix-batter-egg-fritters",
        "en": {
          "title": "Prepare the batter",
          "description": "Finely chop the green onion and add it to the mixture. Crack the remaining raw egg into the bowl, add salt, and mix everything thoroughly until well combined."
        }
      },
      {
        "id": "fry-fritters-egg-fritters",
        "en": {
          "title": "Fry the fritters",
          "description": "Heat vegetable oil in a frying pan over medium heat. Shape the mixture into small patties and fry them on both sides until golden brown and cooked through."
        }
      }
