    "newCookingSteps": [
      {
        "id": "chop-vegetables-vegetable-crepes",
        "en": {
          "title": "Chop the vegetables",
          "description": "Dice the zucchini and eggplant into medium cubes. Finely dice the onion and bell pepper."
        }
      },
      {
        "id": "grate-and-chop-vegetable-crepes",
        "en": {
          "title": "Grate and chop",
          "description": "Coarsely grate the mozzarella. Finely chop the dill and garlic."
        }
      },
      {
        "id": "coat-vegetables-vegetable-crepes",
        "en": {
          "title": "Coat vegetables with flour",
          "description": "Sprinkle flour over the diced zucchini and eggplant. Toss to coat evenly."
        }
      },
      {
        "id": "fry-coated-vegetables-vegetable-crepes",
        "en": {
          "title": "Fry the coated vegetables",
          "description": "Heat oil in a skillet over medium heat. Add the floured zucchini and eggplant and fry until golden brown. Transfer to a plate."
        }
      },
      {
        "id": "saute-onion-vegetable-crepes",
        "en": {
          "title": "Sauté the onion",
          "description": "Add the diced onion to the same skillet and cook over medium heat until translucent, stirring occasionally."
        }
      },
      {
        "id": "fry-bell-pepper-vegetable-crepes",
        "en": {
          "title": "Fry the bell pepper",
          "description": "Add the diced bell pepper to the skillet with the onion. Continue cooking until the pepper is soft."
        }
      },
      {
        "id": "combine-filling-vegetable-crepes",
        "en": {
          "title": "Combine the filling",
          "description": "Return the fried zucchini and eggplant to the skillet. Add the chopped dill, garlic, half of the grated mozzarella, and salt. Mix well."
        }
      },
      {
        "id": "whisk-egg-mix-vegetable-crepes",
        "en": {
          "title": "Whisk eggs with sugar and salt",
          "description": "In a bowl, whisk the eggs together with the sugar and salt until well combined."
        }
      },
      {
        "id": "add-milk-and-flour-vegetable-crepes",
        "en": {
          "title": "Add milk and flour gradually",
          "description": "Pour half of the milk into the egg mixture. Gradually add the flour while stirring constantly to avoid lumps."
        }
      },
      {
        "id": "add-remaining-milk-oil-vegetable-crepes",
        "en": {
          "title": "Add remaining milk and oil",
          "description": "Stir in the remaining milk and the vegetable oil. Mix until the batter is smooth."
        }
      },
      {
        "id": "rest-batter-vegetable-crepes",
        "en": {
          "title": "Rest the batter",
          "description": "Let the batter sit for 5 minutes to allow the gluten to relax."
        }
      },
      {
        "id": "fry-pancakes-vegetable-crepes",
        "en": {
          "title": "Fry the pancakes",
          "description": "Heat a non-stick skillet over medium-high heat with a little oil. Pour a ladleful of batter and swirl to coat the pan. Cook until golden on both sides. Repeat with remaining batter."
        }
      },
      {
        "id": "fill-and-roll-pancakes-vegetable-crepes",
        "en": {
          "title": "Fill and roll the pancakes",
          "description": "Place about 2 tablespoons of the vegetable filling on one edge of each pancake. Roll it up like a tight roll or envelope."
        }
      },
      {
        "id": "make-sauce-vegetable-crepes",
        "en": {
          "title": "Make the sauce",
          "description": "In a small bowl, combine sour cream and ketchup. Stir in the remaining grated mozzarella. Mix well."
        }
      }
    ],
