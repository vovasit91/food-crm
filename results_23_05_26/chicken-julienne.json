    "newCookingSteps": [
      {
        "id": "cut-chicken-chicken-julienne",
        "en": {
          "title": "Cut the chicken",
          "description": "Take the pre-boiled chicken breast and cut it into small, bite-sized pieces. Set aside."
        }
      },
      {
        "id": "chop-onion-mushrooms-chicken-julienne",
        "en": {
          "title": "Chop onion and mushrooms",
          "description": "Peel and finely chop the onion. Clean the mushrooms and slice them thinly."
        }
      },
      {
        "id": "saute-onion-chicken-julienne",
        "en": {
          "title": "Sauté the onion",
          "description": "Melt a knob of butter in a frying pan over medium heat. Add the chopped onion and cook until translucent, about 5 minutes."
        }
      },
      {
        "id": "add-mushrooms-chicken-julienne",
        "en": {
          "title": "Add mushrooms",
          "description": "Add the sliced mushrooms to the pan with the onion. Cook, stirring occasionally, until the mushrooms have softened and released their moisture, about 5 minutes."
        }
      },
      {
        "id": "add-chicken-chicken-julienne",
        "en": {
          "title": "Add chicken",
          "description": "Add the cut chicken pieces to the pan. Stir well to combine with the onion and mushrooms, then remove from heat."
        }
      },
      {
        "id": "melt-butter-chicken-julienne",
        "en": {
          "title": "Melt butter for sauce",
          "description": "In a separate small pan, melt a generous piece of butter over low heat."
        }
      },
      {
        "id": "fry-flour-chicken-julienne",
        "en": {
          "title": "Fry the flour",
          "description": "Add the flour to the melted butter and stir continuously. Cook until the mixture turns a light golden color, about 3 minutes. Be careful not to burn it."
        }
      },
      {
        "id": "simmer-sauce-chicken-julienne",
        "en": {
          "title": "Simmer the sauce",
          "description": "Slowly pour in the milk while whisking constantly to avoid lumps. Add your chosen spices (salt, pepper, nutmeg). Continue to simmer over low heat, stirring gently, until the sauce thickens, about 5 minutes."
        }
      },
      {
        "id": "assemble-filling-chicken-julienne",
        "en": {
          "title": "Distribute the filling",
          "description": "Divide the chicken and mushroom mixture evenly among individual ovenproof molds or a single baking dish."
        }
      },
      {
        "id": "pour-sauce-chicken-julienne",
        "en": {
          "title": "Pour the sauce",
          "description": "Spoon the prepared white sauce over the filling in each mold, covering it completely."
        }
      },
      {
        "id": "sprinkle-cheese-chicken-julienne",
        "en": {
          "title": "Sprinkle with cheese",
          "description": "Grate the hard cheese and generously sprinkle it over the sauced filling."
        }
      },
      {
        "id": "bake-chicken-julienne",
        "en": {
          "title": "Bake the julienne",
          "description": "Preheat your oven to 200°C (400°F). Place the filled molds on a baking tray and bake for 20 minutes, until the cheese is melted and golden brown. Serve hot."
        }
      }
    ],
