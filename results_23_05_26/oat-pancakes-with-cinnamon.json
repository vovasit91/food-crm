    "newCookingSteps": [
      {
        "id": "grind-oats-oat-pancakes-with-cinnamon",
        "en": {
          "title": "Grind the oats",
          "description": "Place the oat flakes into a blender and grind for 2–3 minutes until you get a fine flour."
        }
      },
      {
        "id": "beat-eggs-oat-pancakes-with-cinnamon",
        "en": {
          "title": "Beat the eggs with sugar and salt",
          "description": "Crack the eggs into a bowl, add sugar, salt, and baking powder. Beat with a mixer on medium speed until fluffy and homogeneous."
        }
      },
      {
        "id": "mix-batter-oat-pancakes-with-cinnamon",
        "en": {
          "title": "Add milk, oat flour, and cinnamon",
          "description": "While mixing on low speed, pour in the milk, then add the ground oats and cinnamon. Mix until smooth. Finally add the sunflower oil and stir briefly."
        }
      },
      {
        "id": "heat-pan-oat-pancakes-with-cinnamon",
        "en": {
          "title": "Heat the frying pan with oil",
          "description": "Heat a frying pan with sunflower oil over medium heat. Pour the batter by tablespoonfuls to form round pancakes about 7–9 cm in diameter and 1 cm thick."
        }
      },
      {
        "id": "fry-pancakes-oat-pancakes-with-cinnamon",
        "en": {
          "title": "Fry the pancakes",
          "description": "Reduce the heat to low. Fry the pancakes for 1–2 minutes until bubbles appear on the surface, then flip and fry for another 1–2 minutes until golden brown. Transfer to a plate and repeat with remaining batter."
        }
      }
    ],
