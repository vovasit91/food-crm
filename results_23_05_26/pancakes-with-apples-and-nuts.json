    "newCookingSteps": [
      {
        "id": "whisk-eggs-sugar-salt-pancakes-with-apples-and-nuts",
        "en": {
          "title": "Whisk eggs with salt and sugar",
          "description": "Break the eggs into a deep bowl, add salt and 1 tablespoon of sugar. Whisk with a hand whisk until light foam and sugar dissolve."
        }
      },
      {
        "id": "heat-milk-pancakes-with-apples-and-nuts",
        "en": {
          "title": "Heat the milk",
          "description": "Heat the milk to 40°C, which is just above body temperature. Do not boil."
        }
      },
      {
        "id": "combine-milk-eggs-pancakes-with-apples-and-nuts",
        "en": {
          "title": "Add milk to eggs",
          "description": "Pour the warm milk into the egg mixture and whisk again until combined."
        }
      },
      {
        "id": "sift-flour-soda-pancakes-with-apples-and-nuts",
        "en": {
          "title": "Sift dry ingredients into batter",
          "description": "Sift the flour and baking soda through a sieve into the liquid ingredients. Mix until smooth and no lumps remain."
        }
      },
      {
        "id": "add-oil-batter-pancakes-with-apples-and-nuts",
        "en": {
          "title": "Add oil to the batter",
          "description": "Pour the vegetable oil into the batter and mix well until incorporated."
        }
      },
      {
        "id": "rest-batter-pancakes-with-apples-and-nuts",
        "en": {
          "title": "Let the batter rest",
          "description": "Set the batter aside for 20 minutes. This allows the gluten to swell so the pancakes won't tear when flipped."
        }
      },
      {
        "id": "peel-chop-apples-pancakes-with-apples-and-nuts",
        "en": {
          "title": "Peel and dice apples",
          "description": "Peel the apples, remove the core, and cut them into small cubes."
        }
      },
      {
        "id": "melt-sugar-caramel-pancakes-with-apples-and-nuts",
        "en": {
          "title": "Melt sugar into caramel",
          "description": "Pour the remaining sugar into a dry small saucepan with a thick bottom. Heat over medium heat until the sugar melts and turns into a golden caramel."
        }
      },
      {
        "id": "make-apple-caramel-pancakes-with-apples-and-nuts",
        "en": {
          "title": "Cook apples in caramel sauce",
          "description": "Add the heavy cream and butter to the caramel and stir. Then add the diced apples and cook for 5 minutes, stirring gently, until the apples are coated and softened."
        }
      },
      {
        "id": "add-walnuts-pancakes-with-apples-and-nuts",
        "en": {
          "title": "Add chopped walnuts",
          "description": "Chop the walnuts and add them to the apple caramel. Stir to combine."
        }
      },
      {
        "id": "cook-pancakes-pancakes-with-apples-and-nuts",
        "en": {
          "title": "Cook all pancakes",
          "description": "Heat a pancake pan over medium heat, grease it with vegetable oil if needed. Pour in a ladleful of batter and cook each pancake until golden on both sides. Stack the cooked pancakes on a plate."
        }
      },
      {
        "id": "fill-roll-pancakes-pancakes-with-apples-and-nuts",
        "en": {
          "title": "Fill and roll pancakes",
          "description": "Place a portion of the apple-nut filling onto each pancake and roll it into a tube. Repeat for all pancakes."
        }
      }
    ],
