    "newCookingSteps": [
      {
        "id": "slice-leek-green-shakshuka",
        "en": {
          "title": "Slice the leek",
          "description": "Slice the white part of the leek into half rings."
        }
      },
      {
        "id": "chop-green-onion-and-dill-green-shakshuka",
        "en": {
          "title": "Chop green onion and dill",
          "description": "Finely chop the green onion and dill."
        }
      },
      {
        "id": "press-garlic-green-shakshuka",
        "en": {
          "title": "Press the garlic",
          "description": "Press the garlic cloves through a garlic press."
        }
      },
      {
        "id": "crumble-feta-green-shakshuka",
        "en": {
          "title": "Crumble the feta",
          "description": "Crumble the feta cheese with a fork."
        }
      },
      {
        "id": "saute-leek-green-shakshuka",
        "en": {
          "title": "Sauté the leek",
          "description": "In a skillet, melt butter over medium heat. Add the sliced leek, salt, and sauté, stirring, for 5–7 minutes until soft and translucent. Stir in the khmeli-suneli."
        }
      },
      {
        "id": "saute-garlic-green-shakshuka",
        "en": {
          "title": "Sauté the garlic",
          "description": "Add the pressed garlic and sauté, stirring, for about 1 minute until fragrant."
        }
      },
      {
        "id": "cook-greens-green-shakshuka",
        "en": {
          "title": "Cook the greens",
          "description": "Reduce the heat. Add the chopped green onion and spinach. Cook, stirring gently, for 2–3 minutes until the spinach wilts."
        }
      },
      {
        "id": "add-sour-cream-and-feta-green-shakshuka",
        "en": {
          "title": "Add sour cream and feta",
          "description": "Add the sour cream, half of the feta, and half of the dill. Stir well and heat for 1 minute. Level the surface and make 4 indentations with a spoon."
        }
      },
      {
        "id": "cook-eggs-green-shakshuka",
        "en": {
          "title": "Cook the eggs",
          "description": "Carefully crack one egg into each indentation. Reduce the heat to low, cover the skillet, and cook for 5–7 minutes until the whites are set but the yolks are still runny."
        }
      },
      {
        "id": "finish-and-serve-green-shakshuka",
        "en": {
          "title": "Finish and serve",
          "description": "Remove the skillet from heat. Season the eggs with salt and pepper. Sprinkle with the remaining dill and feta."
        }
      }
    ],
