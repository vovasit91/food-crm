    "newCookingSteps": [
      {
        "id": "grate-carrot-millet-porridge-carrot-cake",
        "en": {
          "title": "Grate the carrot",
          "description": "Grate the carrot on the large holes of a box grater. Set aside."
        }
      },
      {
        "id": "prep-apple-millet-porridge-carrot-cake",
        "en": {
          "title": "Prepare the apple",
          "description": "Core the apple, peel it, and cut the flesh into small cubes. Set aside."
        }
      },
      {
        "id": "combine-ingredients-millet-porridge-carrot-cake",
        "en": {
          "title": "Combine ingredients in a pot",
          "description": "Place the millet in a small heavy-bottomed saucepan. Add the grated carrot, milk, sugar, and ground spices (cinnamon, nutmeg, cloves). Stir to combine."
        }
      },
      {
        "id": "bring-to-boil-millet-porridge-carrot-cake",
        "en": {
          "title": "Bring the mixture to a boil",
          "description": "Set the saucepan over medium heat. Bring the mixture to a boil, stirring occasionally to prevent sticking."
        }
      },
      {
        "id": "simmer-10-min-millet-porridge-carrot-cake",
        "en": {
          "title": "Simmer for 10 minutes",
          "description": "Once boiling, reduce the heat to low, cover the saucepan, and let it simmer gently for 10 minutes."
        }
      },
      {
        "id": "add-apple-millet-porridge-carrot-cake",
        "en": {
          "title": "Add the diced apple",
          "description": "Uncover the pot and add the diced apple. Stir it into the porridge."
        }
      },
      {
        "id": "cook-until-absorbed-millet-porridge-carrot-cake",
        "en": {
          "title": "Cook until milk is absorbed",
          "description": "Continue cooking over low heat, uncovered, until all the milk has been absorbed by the millet. This will take about 15–20 minutes. Stir occasionally."
        }
      },
      {
        "id": "rest-porridge-millet-porridge-carrot-cake",
        "en": {
          "title": "Let the porridge rest",
          "description": "Remove the saucepan from the heat. Cover it again and let the porridge stand for 10 minutes. This allows the flavors to meld together."
        }
      }
    ],
