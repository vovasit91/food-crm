    "newCookingSteps": [
      {
        "id": "beat-eggs-raffaello-style-crepes",
        "en": {
          "title": "Beat eggs with sugar and salt",
          "description": "In a bowl, beat the eggs with sugar and salt until the mixture becomes light and fluffy."
        }
      },
      {
        "id": "add-flour-milk-raffaello-style-crepes",
        "en": {
          "title": "Add flour and milk gradually",
          "description": "Slowly sift in the flour while mixing, then pour in the milk in small batches, stirring constantly to avoid lumps."
        }
      },
      {
        "id": "let-batter-rest-raffaello-style-crepes",
        "en": {
          "title": "Add boiling water and oil, then rest the batter",
          "description": "Bring the water to a boil and pour it into the batter. Add the vegetable oil and mix until smooth. Let the batter rest for 10 minutes."
        }
      },
      {
        "id": "fry-crepes-raffaello-style-crepes",
        "en": {
          "title": "Fry the crepes",
          "description": "Heat a well-greased frying pan over medium-high heat. Pour a ladleful of batter and swirl to coat. Cook until golden on both sides. Stack the finished crepes on a plate."
        }
      },
      {
        "id": "make-filling-raffaello-style-crepes",
        "en": {
          "title": "Make the filling",
          "description": "In a separate bowl, mix the tvorog with the condensed milk until well combined."
        }
      },
      {
        "id": "add-coconut-vanilla-raffaello-style-crepes",
        "en": {
          "title": "Add coconut and vanilla sugar",
          "description": "Stir in the coconut flakes and vanilla sugar into the tvorog mixture. Mix thoroughly."
        }
      },
      {
        "id": "spread-filling-raffaello-style-crepes",
        "en": {
          "title": "Spread the filling on each crepe",
          "description": "Place a generous layer of the filling onto each crepe, spreading evenly."
        }
      },
      {
        "id": "roll-crepes-raffaello-style-crepes",
        "en": {
          "title": "Fold and roll the crepes",
          "description": "Fold the two opposite edges of each crepe inward to secure the filling, then roll tightly into a compact log. Arrange the rolled crepes on a serving plate."
        }
      }
    ],
