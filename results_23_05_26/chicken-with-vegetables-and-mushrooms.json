    "newCookingSteps": [
      {
        "id": "cut-chicken-chicken-with-vegetables-and-mushrooms",
        "en": {
          "title": "Cut the chicken into large pieces",
          "description": "Cut the chicken into large pieces, approximately 2-3 inches."
        }
      },
      {
        "id": "cut-carrot-for-marinade-chicken-with-vegetables-and-mushrooms",
        "en": {
          "title": "Cut half the carrot into strips",
          "description": "Cut the carrot into thick strips or small sticks for the marinade."
        }
      },
      {
        "id": "combine-marinade-chicken-with-vegetables-and-mushrooms",
        "en": {
          "title": "Combine the marinade ingredients",
          "description": "Place the chicken pieces, carrot, garlic clove, parsley bunch, thyme sprig, bay leaf, and allspice in a bowl. Pour in the wine."
        }
      },
      {
        "id": "marinate-chicken-chicken-with-vegetables-and-mushrooms",
        "en": {
          "title": "Marinate the chicken",
          "description": "Cover the bowl and refrigerate for 8 hours to allow the flavors to meld."
        }
      },
      {
        "id": "cut-vegetables-and-bacon-chicken-with-vegetables-and-mushrooms",
        "en": {
          "title": "Prepare the vegetables and bacon",
          "description": "Cut the remaining carrot into rounds, slice the mushrooms, and dice the bacon."
        }
      },
      {
        "id": "fry-bacon-chicken-with-vegetables-and-mushrooms",
        "en": {
          "title": "Fry the bacon",
          "description": "Place a dry frying pan over heat and fry the bacon for about 5 minutes until crispy. Transfer to a dish."
        }
      },
      {
        "id": "fry-mushrooms-chicken-with-vegetables-and-mushrooms",
        "en": {
          "title": "Fry the mushrooms",
          "description": "Add 2 tablespoons of oil to the pan and fry the mushrooms for 5-6 minutes. Transfer to the dish with bacon."
        }
      },
      {
        "id": "fry-carrots-chicken-with-vegetables-and-mushrooms",
        "en": {
          "title": "Fry the carrots",
          "description": "Add another 2 tablespoons of oil and fry the carrot rounds for 5 minutes. Transfer to the dish with bacon and mushrooms."
        }
      },
      {
        "id": "coat-chicken-with-flour-chicken-with-vegetables-and-mushrooms",
        "en": {
          "title": "Coat the chicken with flour",
          "description": "Remove the chicken from the marinade, pat dry, and dredge each piece in flour, shaking off excess."
        }
      },
      {
        "id": "fry-chicken-until-golden-chicken-with-vegetables-and-mushrooms",
        "en": {
          "title": "Fry the chicken until golden",
          "description": "Fry the floured chicken pieces in the remaining oil until golden brown on all sides, about 10 minutes."
        }
      },
      {
        "id": "combine-and-heat-chicken-with-vegetables-and-mushrooms",
        "en": {
          "title": "Combine and heat the ingredients",
          "description": "Add the cooked bacon, mushrooms, and carrots to the pan with the chicken. Season with salt and pepper, and heat over low heat for a few minutes to blend flavors."
        }
      },
      {
        "id": "add-marinade-and-boil-chicken-with-vegetables-and-mushrooms",
        "en": {
          "title": "Add the marinade and bring to a boil",
          "description": "Strain the reserved marinade and pour half of it into the pan. Bring to a boil."
        }
      },
      {
        "id": "simmer-chicken-chicken-with-vegetables-and-mushrooms",
        "en": {
          "title": "Simmer the chicken",
          "description": "Cover the pan with a lid and let the chicken simmer on low heat for 1 hour, until tender and well-flavored."
        }
      }
