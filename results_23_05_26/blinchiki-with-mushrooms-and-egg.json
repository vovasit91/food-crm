    "newCookingSteps": [
      {
        "id": "whisk-eggs-blinchiki-with-mushrooms-and-egg",
        "en": {
          "title": "Whisk eggs with sugar and salt",
          "description": "Whisk together eggs, sugar, and salt until the sugar and salt are dissolved and the mixture is homogeneous. Do not whip to foam; just combine until smooth."
        }
      },
      {
        "id": "add-half-milk-blinchiki-with-mushrooms-and-egg",
        "en": {
          "title": "Add half the milk",
          "description": "Pour half of the milk into the egg mixture and whisk until combined."
        }
      },
      {
        "id": "add-flour-blinchiki-with-mushrooms-and-egg",
        "en": {
          "title": "Add flour gradually",
          "description": "Sift the flour into the mixture in small portions, stirring vigorously to avoid lumps. Continue until all flour is incorporated."
        }
      },
      {
        "id": "rest-batter-blinchiki-with-mushrooms-and-egg",
        "en": {
          "title": "Add remaining milk and oil, rest batter",
          "description": "Gradually add the remaining milk and then the vegetable oil. Mix until you have a thin batter resembling heavy cream. Let the batter rest for 5 minutes to allow the gluten to relax."
        }
      },
      {
        "id": "cook-crepe-first-side-blinchiki-with-mushrooms-and-egg",
        "en": {
          "title": "Cook first side of crepes",
          "description": "Heat a non-stick pan over high heat. Pour a small amount of batter into the pan and swirl to spread it thinly across the bottom. Cook until the top is set and no longer sticky, about 1 minute per crepe. Repeat for the remaining batter."
        }
      },
      {
        "id": "cook-crepe-second-side-blinchiki-with-mushrooms-and-egg",
        "en": {
          "title": "Flip and cook second side",
          "description": "Carefully flip the crepe and cook the other side until golden brown. Remove to a plate. Repeat for all crepes."
        }
      },
      {
        "id": "boil-eggs-blinchiki-with-mushrooms-and-egg",
        "en": {
          "title": "Boil eggs",
          "description": "Place the eggs in a saucepan and cover with cold water. Bring to a boil, then reduce to a simmer and cook for 10 minutes. Transfer to cold water, cool, then peel."
        }
      },
      {
        "id": "chop-mushrooms-onion-blinchiki-with-mushrooms-and-egg",
        "en": {
          "title": "Chop mushrooms and onion",
          "description": "Finely dice the mushrooms and onion into small cubes."
        }
      },
      {
        "id": "saute-mushrooms-onion-blinchiki-with-mushrooms-and-egg",
        "en": {
          "title": "Sauté mushrooms and onion",
          "description": "Heat oil in a skillet over medium heat. Add the mushrooms and onion and sauté, stirring occasionally, until softened, about 6-8 minutes. Season with salt and pepper."
        }
      },
      {
        "id": "add-green-onion-blinchiki-with-mushrooms-and-egg",
        "en": {
          "title": "Add green onion and finish",
          "description": "Add the chopped green onion to the skillet and cook for another 2 minutes. Remove from heat and let cool slightly."
        }
      },
      {
        "id": "chop-eggs-mix-filling-blinchiki-with-mushrooms-and-egg",
        "en": {
          "title": "Chop eggs and combine with filling",
          "description": "Chop the peeled hard-boiled eggs into small pieces. Mix them into the cooled mushroom mixture."
        }
      },
      {
        "id": "fill-roll-crepes-blinchiki-with-mushrooms-and-egg",
        "en": {
          "title": "Fill and roll crepes",
          "description": "Place 1-2 tablespoons of filling along the edge of each crepe. Fold the sides over the filling, then roll the crepe into a tight roll."
        }
      },
      {
        "id": "reheat-crepes-blinchiki-with-mushrooms-and-egg",
        "en": {
          "title": "Reheat crepes in dry pan",
          "description": "Heat a dry non-stick pan over medium heat. Place the rolled crepes seam-side down and cook for 2-3 minutes per side until heated through and lightly crispy. Serve warm."
        }
      }
    ],
