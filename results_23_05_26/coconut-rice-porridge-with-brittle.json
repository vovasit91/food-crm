    "newCookingSteps": [
      {
        "id": "heat-caramel-coconut-rice-porridge-with-brittle",
        "en": {
          "title": "Heat the caramel mixture",
          "description": "Combine the sugar, honey, salt, and water in a heavy-bottomed saucepan. Place over medium-low heat and stir until the mixture comes to a boil."
        }
      },
      {
        "id": "boil-caramel-coconut-rice-porridge-with-brittle",
        "en": {
          "title": "Boil the caramel",
          "description": "Once the mixture boils and starts to foam, reduce the heat to low. Cook, without stirring, for 30 minutes until it turns a bright amber color."
        }
      },
      {
        "id": "grease-tray-coconut-rice-porridge-with-brittle",
        "en": {
          "title": "Grease the baking tray",
          "description": "Grease a baking tray lined with parchment paper with 5 g of butter."
        }
      },
      {
        "id": "add-nuts-to-caramel-coconut-rice-porridge-with-brittle",
        "en": {
          "title": "Add nuts to caramel",
          "description": "Add the nuts, seeds, and remaining 15 g of butter to the caramel. Stir to combine, then pour onto the prepared baking tray and spread evenly. Allow to cool, then refrigerate for 1 hour."
        }
      },
      {
        "id": "cut-brittle-coconut-rice-porridge-with-brittle",
        "en": {
          "title": "Cut the brittle",
          "description": "Cut the cooled brittle into squares or break it into pieces arbitrarily."
        }
      },
      {
        "id": "boil-rice-water-coconut-rice-porridge-with-brittle",
        "en": {
          "title": "Boil water and cook rice",
          "description": "In a saucepan, bring 100 ml of water to a boil over medium heat. Add the rice and cook until the water is fully absorbed."
        }
      },
      {
        "id": "cook-rice-porridge-coconut-rice-porridge-with-brittle",
        "en": {
          "title": "Cook the rice porridge",
          "description": "Pour in the coconut milk, add salt and sugar. Reduce the heat to low and cook for 15–20 minutes, stirring occasionally, until the porridge reaches the desired consistency."
        }
      },
      {
        "id": "rest-rice-porridge-coconut-rice-porridge-with-brittle",
        "en": {
          "title": "Rest the porridge",
          "description": "Cover the saucepan with a lid, remove from heat, and let it rest for 20 minutes."
        }
      }
    ],
