    "newCookingSteps": [
      {
        "id": "prepare-chicken-stuffed-chicken-with-vegetables",
        "en": {
          "title": "Prepare the chicken",
          "description": "Place the chicken breast side up. Gently separate the skin from the breast with your hands. Cut the breast away from the back using a knife, being careful not to tear the skin. Remove the meat from the carcass, debone it, and cut it into cubes about 1 cm."
        }
      },
      {
        "id": "marinate-chicken-stuffed-chicken-with-vegetables",
        "en": {
          "title": "Marinate the chicken",
          "description": "In a bowl, mix mayonnaise, ⅓ teaspoon of salt, and chicken seasoning. Place the chicken carcass in a baking dish and spread the marinade inside and out. Let it marinate while you prepare the filling."
        }
      },
      {
        "id": "assemble-lavash-roll-stuffed-chicken-with-vegetables",
        "en": {
          "title": "Assemble the lavash roll",
          "description": "Spread a sheet of lavash on the table. Arrange the chicken cubes on it and sprinkle with ⅓ teaspoon of salt. Spread the frozen vegetable mix evenly over the chicken. Slice mushrooms thinly and place on top. Cut the cheese into slices and cover the mushrooms. Roll the lavash tightly into a log."
        }
      },
      {
        "id": "preheat-oven-stuffed-chicken-with-vegetables",
        "en": {
          "title": "Preheat the oven",
          "description": "Preheat your oven to 200°C (400°F)."
        }
      },
      {
        "id": "stuff-chicken-stuffed-chicken-with-vegetables",
        "en": {
          "title": "Stuff the chicken",
          "description": "Cut the lavash log into 3–4 pieces. Stuff these pieces tightly into the cavity of the chicken, under the skin of the breast."
        }
      },
      {
        "id": "secure-opening-stuffed-chicken-with-vegetables",
        "en": {
          "title": "Secure the opening",
          "description": "Close the opening in the carcass with the ends of the skin. Fasten with toothpicks or skewers."
        }
      },
      {
        "id": "bake-chicken-stuffed-chicken-with-vegetables",
        "en": {
          "title": "Bake the chicken",
          "description": "Place the chicken in the preheated oven and bake for 40–50 minutes until golden and cooked through."
        }
      },
      {
        "id": "boil-potatoes-stuffed-chicken-with-vegetables",
        "en": {
          "title": "Boil the potatoes",
          "description": "Cut the potatoes into 3–4 pieces each. Place in a saucepan, cover with water, and bring to a boil over high heat. Add ⅓ teaspoon of salt, reduce the heat to medium, and cook for 10–15 minutes until half-done. Drain and let cool."
        }
      },
      {
        "id": "slice-pumpkin-stuffed-chicken-with-vegetables",
        "en": {
          "title": "Slice the pumpkin",
          "description": "Cut the pumpkin into slices about 1–1.5 cm thick."
        }
      },
      {
        "id": "add-vegetables-and-bake-stuffed-chicken-with-vegetables",
        "en": {
          "title": "Add vegetables and finish baking",
          "description": "Remove the almost-done chicken from the oven. Arrange the boiled potatoes and pumpkin slices around the chicken. Drizzle with vegetable oil. Return to the oven and bake for another 10–15 minutes until the chicken is nicely browned and the vegetables are tender."
        }
      }
    ],
