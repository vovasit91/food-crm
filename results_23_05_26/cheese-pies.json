    "newCookingSteps": [
      {
        "id": "combine-wet-cheese-pies",
        "en": {
          "title": "Combine the wet ingredients",
          "description": "In a large bowl, combine warm milk, water, egg, 3 tablespoons of vegetable oil, sour cream, and sugar. Stir until homogeneous."
        }
      },
      {
        "id": "add-dry-cheese-pies",
        "en": {
          "title": "Add the dry ingredients",
          "description": "Add about half of the sifted flour (300 g), along with the salt and yeast. Mix until no lumps remain."
        }
      },
      {
        "id": "knead-dough-cheese-pies",
        "en": {
          "title": "Knead the dough",
          "description": "Start kneading the dough on a lightly floured surface, gradually adding the remaining flour. Knead for at least 10 minutes until the dough is smooth, elastic, and no longer sticky."
        }
      },
      {
        "id": "rise-dough-cheese-pies",
        "en": {
          "title": "Let the dough rise",
          "description": "Shape the dough into a ball, place it in a bowl greased with the remaining oil, cover with a towel or plastic wrap, and set in a warm place for 1 to 1.5 hours until doubled in volume."
        }
      },
      {
        "id": "punch-dough-cheese-pies",
        "en": {
          "title": "Punch down the dough",
          "description": "Punch down the risen dough and turn it out onto a work surface. Divide it into 12 equal pieces."
        }
      },
      {
        "id": "grate-cheese-cheese-pies",
        "en": {
          "title": "Grate the cheese",
          "description": "If not already done, grate the cheese on a coarse grater."
        }
      },
      {
        "id": "shape-pies-cheese-pies",
        "en": {
          "title": "Shape the pies",
          "description": "Roll each piece of dough into a round disc about 3–4 mm thick. Place some grated cheese in the center. Pinch the edges firmly to seal, then gently flatten with your palm to distribute the cheese. Repeat for all pieces."
        }
      },
      {
        "id": "make-syrup-cheese-pies",
        "en": {
          "title": "Prepare the sugar syrup",
          "description": "Mix hot water with sugar to make a syrup."
        }
      },
      {
        "id": "dip-pies-cheese-pies",
        "en": {
          "title": "Coat the pies with syrup and sesame",
          "description": "Dip each pie in the syrup, then roll in sesame seeds to coat. Place seam-side down on a baking tray. Using a sharp knife, make 2–3 shallow diagonal cuts on top of each pie."
        }
      },
      {
        "id": "proof-pies-cheese-pies",
        "en": {
          "title": "Proof the pies",
          "description": "Place the pies in a warm spot and let them proof for 15–20 minutes."
        }
      },
      {
        "id": "preheat-oven-cheese-pies",
        "en": {
          "title": "Preheat the oven",
          "description": "Preheat the oven to 180°C (350°F)."
        }
      },
      {
        "id": "bake-pies-cheese-pies",
        "en": {
          "title": "Bake the pies",
          "description": "Bake the pies in the preheated oven for 20–25 minutes, until golden brown."
        }
      }
    ],
