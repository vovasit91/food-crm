    "newCookingSteps": [
      {
        "id": "melt-butter-pancake-boats-caramelized-pear",
        "en": {
          "title": "Melt the butter",
          "description": "Melt the butter for the dough in a microwave or bain-marie. If using microwave, heat in 15-20 second bursts, stirring after each, until fully melted."
        }
      },
      {
        "id": "mix-dry-wet-pancake-boats-caramelized-pear",
        "en": {
          "title": "Mix dry and wet ingredients",
          "description": "In a bowl, combine sifted wheat and buckwheat flour with a pinch of salt. Make a well in the center, crack in the eggs and pour in slightly warm milk. Whisk until smooth."
        }
      },
      {
        "id": "add-beer-pancake-boats-caramelized-pear",
        "en": {
          "title": "Add beer and adjust consistency",
          "description": "Pour in the light beer and whisk the batter. Adjust the consistency with a little extra liquid if needed — it should be like thin sour cream."
        }
      },
      {
        "id": "add-butter-dough-pancake-boats-caramelized-pear",
        "en": {
          "title": "Add melted butter",
          "description": "Add the cooled melted butter to the batter and stir until incorporated."
        }
      },
      {
        "id": "rest-batter-pancake-boats-caramelized-pear",
        "en": {
          "title": "Rest the batter",
          "description": "Cover the bowl with a kitchen towel and let the batter rest at room temperature for 1 hour. This allows the flours to hydrate and the gluten to relax."
        }
      },
      {
        "id": "peel-dice-pears-pancake-boats-caramelized-pear",
        "en": {
          "title": "Peel and dice pears",
          "description": "Peel the pears, remove the cores, and cut the flesh into small cubes about 1-1.5 cm in size."
        }
      },
      {
        "id": "saute-pears-pancake-boats-caramelized-pear",
        "en": {
          "title": "Sauté pears in butter",
          "description": "In a saucepan, melt the remaining butter over medium heat. Add the diced pears and sauté for 5 minutes, stirring occasionally."
        }
      },
      {
        "id": "caramelize-pears-pancake-boats-caramelized-pear",
        "en": {
          "title": "Caramelize pears with sugar and cinnamon",
          "description": "Sprinkle the cane sugar and ground cinnamon over the pears. Cook for 2-3 minutes, stirring, until the sugar dissolves and a caramel forms."
        }
      },
      {
        "id": "add-lemon-zest-pancake-boats-caramelized-pear",
        "en": {
          "title": "Add lemon juice and zest",
          "description": "Pour in the lemon juice, add the lemon zest, stir once, and remove the pan from the heat."
        }
      },
      {
        "id": "cool-filling-pancake-boats-caramelized-pear",
        "en": {
          "title": "Cool the filling completely",
          "description": "Let the pear filling cool entirely to room temperature before using. This prevents the pancakes from getting soggy."
        }
      },
      {
        "id": "fry-pancakes-pancake-boats-caramelized-pear",
        "en": {
          "title": "Fry thin pancakes",
          "description": "Heat a non-stick pan over medium heat and lightly grease with vegetable oil. Pour a thin layer of batter and cook small pancakes about 10-12 cm in diameter until golden on both sides."
        }
      },
      {
        "id": "fill-pancakes-pancake-boats-caramelized-pear",
        "en": {
          "title": "Fill pancakes with pear mixture",
          "description": "Place 1.5-2 tablespoons of cooled pear filling on half of each pancake. Fold the other half over to form a half-moon shape."
        }
      },
      {
        "id": "skewer-pancakes-pancake-boats-caramelized-pear",
        "en": {
          "title": "Skewer to create boat shape",
          "description": "Insert a skewer about 0.5 cm from the curved edge of the folded pancake, threading it in an accordion pattern to secure and lift the edge, creating a boat shape. Repeat with the remaining pancakes."
        }
      }
    ],
