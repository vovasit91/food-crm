    "newCookingSteps": [
      {
        "id": "mix-dry-ingredients-cheeseburger-pizza",
        "en": {
          "title": "Mix dry ingredients",
          "description": "In a bowl, combine half of the flour with sugar, salt, and yeast. Pour in warm water and 2 tablespoons of olive oil, then stir until well mixed."
        }
      },
      {
        "id": "knead-dough-cheeseburger-pizza",
        "en": {
          "title": "Knead the dough",
          "description": "Gradually add the remaining flour and knead by hand until you have a smooth, soft, and non-sticky dough. This should take about 10 minutes."
        }
      },
      {
        "id": "rest-dough-cheeseburger-pizza",
        "en": {
          "title": "Let the dough rest",
          "description": "Wrap the dough in plastic wrap and leave it in a warm place for 30 minutes to rise and relax."
        }
      },
      {
        "id": "prepare-vegetables-cheeseburger-pizza",
        "en": {
          "title": "Prepare the toppings",
          "description": "Grate the mozzarella coarsely. Slice the onion into rings, and cut the tomato and pickles into thin rounds."
        }
      },
      {
        "id": "heat-oil-cheeseburger-pizza",
        "en": {
          "title": "Heat the oil",
          "description": "Pour 2 tablespoons of olive oil into a frying pan and place over medium heat until shimmering."
        }
      },
      {
        "id": "fry-beef-cheeseburger-pizza",
        "en": {
          "title": "Fry the beef",
          "description": "Add the ground beef to the hot pan and cook, breaking up any lumps with a spatula, until the meat is browned and cooked through. This should take about 8 minutes."
        }
      },
      {
        "id": "season-beef-cheeseburger-pizza",
        "en": {
          "title": "Season the beef",
          "description": "Sprinkle the beef with salt, pepper, oregano, and mustard. Stir to combine, then remove the pan from the heat."
        }
      },
      {
        "id": "shape-dough-and-rest-cheeseburger-pizza",
        "en": {
          "title": "Shape and rest the dough",
          "description": "Punch down the risen dough, shape it into a ball, and dust lightly with millet flour. Let it rest for another 20 minutes at room temperature."
        }
      },
      {
        "id": "roll-dough-cheeseburger-pizza",
        "en": {
          "title": "Roll out the dough",
          "description": "On a floured surface, roll the dough into a round disc about 30 cm in diameter. Transfer it to a baking sheet lined with parchment paper."
        }
      },
      {
        "id": "brush-oil-ketchup-cheeseburger-pizza",
        "en": {
          "title": "Brush oil and spread ketchup",
          "description": "Brush the surface of the dough with the remaining olive oil, then spread ketchup evenly over the oil."
        }
      },
      {
        "id": "add-processed-cheese-cheeseburger-pizza",
        "en": {
          "title": "Add processed cheese",
          "description": "Tear the processed cheese slices into small pieces and scatter them over the ketchup layer."
        }
      },
      {
        "id": "add-beef-and-onion-cheeseburger-pizza",
        "en": {
          "title": "Add beef and onions",
          "description": "Spread the cooked beef evenly over the cheese, then arrange the onion rings on top of the meat."
        }
      },
      {
        "id": "top-with-mozzarella-veggies-cheeseburger-pizza",
        "en": {
          "title": "Top with mozzarella and vegetables",
          "description": "Sprinkle the grated mozzarella over the pizza, then place the cucumber rounds and tomato slices on top."
        }
      },
      {
        "id": "preheat-oven-cheeseburger-pizza",
        "en": {
          "title": "Preheat the oven",
          "description": "Set your oven to 200°C (400°F) and allow it to fully preheat. This takes about 10 minutes."
        }
      },
      {
        "id": "bake-pizza-cheeseburger-pizza",
        "en": {
          "title": "Bake the pizza",
          "description": "Place the pizza in the preheated oven and bake for 8–9 minutes, until the cheese is melted and bubbly and the crust is golden. Serve hot."
        }
      }
    ],
