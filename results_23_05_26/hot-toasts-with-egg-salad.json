    "newCookingSteps": [
      {
        "id": "boil-eggs-hot-toasts-with-egg-salad",
        "en": {
          "title": "Boil the eggs",
          "description": "Place eggs in a saucepan, cover with cold water, and bring to a boil. Cook for exactly 10 minutes from the moment the water starts boiling. Transfer the eggs to ice water to cool, then peel and dice them finely."
        }
      },
      {
        "id": "chop-parsley-and-mix-egg-salad-hot-toasts-with-egg-salad",
        "en": {
          "title": "Make the egg salad",
          "description": "Finely chop the parsley and add it to the diced eggs. Season with salt and black pepper to taste. Add mayonnaise and stir until well combined."
        }
      },
      {
        "id": "fry-bread-and-assemble-hot-toasts-with-egg-salad",
        "en": {
          "title": "Toast the bread and assemble",
          "description": "Toast the bread slices in a dry frying pan over medium heat until golden brown on both sides. Transfer the slices to a baking sheet lined with parchment paper. Spread the egg salad evenly over each slice."
        }
      },
      {
        "id": "preheat-oven-hot-toasts-with-egg-salad",
        "en": {
          "title": "Preheat the oven",
          "description": "Preheat your oven to 200°C (400°F)."
        }
      },
      {
        "id": "bake-toasts-hot-toasts-with-egg-salad",
        "en": {
          "title": "Bake the toasts",
          "description": "Place a slice of cheese on top of each toast, pressing lightly. Bake in the preheated oven for 7–10 minutes, or until the cheese is melted and golden. Serve immediately."
        }
      }
