        "id": "mix-dry-ingredients-scones-with-bacon-and-apple",
        "en": {
          "title": "Mix dry ingredients",
          "description": "In a large bowl, combine the flour, baking powder, sugar, salt, and black pepper."
        }
      },
      {
        "id": "cut-butter-into-flour-scones-with-bacon-and-apple",
        "en": {
          "title": "Cut butter into flour",
          "description": "Grate the cold butter into the dry mixture and use forks or a pastry cutter to work it into the flour until the mixture resembles coarse crumbs."
        }
      },
      {
        "id": "mix-wet-and-dry-scones-with-bacon-and-apple",
        "en": {
          "title": "Mix wet and dry ingredients",
          "description": "Add the diced apple, bacon, grated cheese, chopped rosemary, and heavy cream to the bowl. Stir a few times until the dough comes together into a ball. Do not overmix."
        }
      },
      {
        "id": "roll-dough-scones-with-bacon-and-apple",
        "en": {
          "title": "Roll out the dough",
          "description": "Transfer the dough to a lightly floured surface and roll it out to a thickness of 2 cm (about 3/4 inch)."
        }
      },
