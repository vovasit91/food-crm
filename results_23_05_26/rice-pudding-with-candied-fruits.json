    "newCookingSteps": [
      {
        "id": "bring-water-to-boil-rice-pudding-with-candied-fruits",
        "en": {
          "title": "Bring water to a boil",
          "description": "Fill a large pot with water, add a pinch of salt, and bring to a boil over high heat."
        }
      },
      {
        "id": "add-rice-and-boil-rice-pudding-with-candied-fruits",
        "en": {
          "title": "Add rice and boil",
          "description": "Add the rice to the boiling water and cook for 10 minutes, stirring occasionally."
        }
      },
      {
        "id": "drain-rice-rice-pudding-with-candied-fruits",
        "en": {
          "title": "Drain the rice",
          "description": "Pour the rice into a colander and let the water drain completely."
        }
      },
      {
        "id": "return-rice-add-milk-rice-pudding-with-candied-fruits",
        "en": {
          "title": "Return rice and add milk",
          "description": "Return the drained rice to the pot and pour in the milk."
        }
      },
      {
        "id": "simmer-rice-milk-low-heat-rice-pudding-with-candied-fruits",
        "en": {
          "title": "Simmer rice with milk",
          "description": "Place the pot on the stove and cook over low heat for 15 minutes, stirring frequently. Allow to cool slightly."
        }
      },
      {
        "id": "cool-rice-mixture-slightly-rice-pudding-with-candied-fruits",
        "en": {
          "title": "Cool the rice mixture slightly",
          "description": "Let the rice mixture sit for a few minutes until it is warm but not hot."
        }
      },
      {
        "id": "separate-eggs-rice-pudding-with-candied-fruits",
        "en": {
          "title": "Separate eggs",
          "description": "Crack the eggs and separate the yolks from the whites. Place whites in a clean bowl and yolks in another."
        }
      },
      {
        "id": "whisk-yolks-sugar-vanilla-rice-pudding-with-candied-fruits",
        "en": {
          "title": "Whisk yolks with sugar and vanilla",
          "description": "Add sugar and vanilla to the yolks and whisk until smooth and pale."
        }
      },
      {
        "id": "mix-yolk-mixture-into-rice-rice-pudding-with-candied-fruits",
        "en": {
          "title": "Mix yolk mixture into rice",
          "description": "Pour the yolk mixture into the cooled rice and stir gently to combine. Ensure the rice is not hot to prevent the yolks from curdling."
        }
      },
      {
        "id": "whip-egg-whites-rice-pudding-with-candied-fruits",
        "en": {
          "title": "Whip egg whites",
          "description": "In a clean bowl, whip the egg whites until stiff peaks form."
        }
      },
      {
        "id": "cut-butter-into-cubes-rice-pudding-with-candied-fruits",
        "en": {
          "title": "Cut butter into cubes",
          "description": "Cut the butter into small cubes."
        }
      },
      {
        "id": "chop-candied-fruits-rice-pudding-with-candied-fruits",
        "en": {
          "title": "Chop candied fruits",
          "description": "If the candied fruits are large, chop them into smaller pieces."
        }
      },
      {
        "id": "add-butter-candied-fruits-rice-pudding-with-candied-fruits",
        "en": {
          "title": "Add butter and candied fruits",
          "description": "Add the butter cubes and chopped candied fruits to the rice mixture and stir to combine."
        }
      },
      {
        "id": "fold-in-whites-rice-pudding-with-candied-fruits",
        "en": {
          "title": "Fold in whipped egg whites",
          "description": "Gently fold the whipped egg whites into the pudding mixture until just combined. Be careful not to deflate the whites."
        }
      },
      {
        "id": "grease-dish-with-butter-rice-pudding-with-candied-fruits",
        "en": {
          "title": "Grease baking dish with butter",
          "description": "Grease a baking dish with the remaining butter and sprinkle with breadcrumbs."
        }
      },
      {
        "id": "fill-dish-with-mixture-rice-pudding-with-candied-fruits",
        "en": {
          "title": "Fill the dish with pudding mixture",
          "description": "Pour the pudding mixture into the prepared baking dish and spread evenly."
        }
      },
      {
        "id": "bake-pudding-at-180c-rice-pudding-with-candied-fruits",
        "en": {
          "title": "Bake the pudding",
          "description": "Preheat the oven to 180°C. Bake the pudding for 35 minutes until set and golden. Let cool before serving."
        }
      },
      {
        "id": "cool-pudding-rice-pudding-with-candied-fruits",
        "en": {
          "title": "Cool the pudding",
          "description": "Allow the pudding to cool completely before serving. Optionally, refrigerate for a firmer texture."
        }
      }
