    "newCookingSteps": [
      {
        "id": "heat-coconut-milk-rice-porridge-bounty",
        "en": {
          "title": "Heat the coconut milk with sugar and salt",
          "description": "Pour the coconut milk into a saucepan. Add sugar and a pinch of salt. Place the saucepan over medium heat and stir occasionally until the mixture comes to a boil."
        }
      },
      {
        "id": "cook-rice-flakes-rice-porridge-bounty",
        "en": {
          "title": "Cook the rice flakes and coconut",
          "description": "Add the rice flakes and coconut flakes to the boiling milk. Stir constantly and cook for 1–2 minutes until the porridge thickens slightly."
        }
      },
      {
        "id": "let-porridge-rest-rice-porridge-bounty",
        "en": {
          "title": "Let the porridge rest",
          "description": "Remove the saucepan from the heat. Cover with a lid and let it stand for 5 minutes to allow the flavors to meld and the porridge to become creamy."
        }
      },
      {
        "id": "make-chocolate-glaze-rice-porridge-bounty",
        "en": {
          "title": "Make the chocolate glaze",
          "description": "Break the dark chocolate into small pieces and place in a microwave-safe bowl. Add the light cream. Heat in the microwave in 10–15 second bursts, stirring after each burst, until the chocolate is completely melted and the mixture is smooth and glossy."
        }
      }
