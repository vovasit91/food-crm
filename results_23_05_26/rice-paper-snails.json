    "newCookingSteps": [
      {
        "id": "mash-tvorog-rice-paper-snails",
        "en": {
          "title": "Mash the tvorog",
          "description": "Place the tvorog in a bowl and mash it with a fork until smooth."
        }
      },
      {
        "id": "add-egg-mix-rice-paper-snails",
        "en": {
          "title": "Add egg and seasonings",
          "description": "Crack the egg into the mashed tvorog, add salt and dried basil, then mix thoroughly until combined."
        }
      },
      {
        "id": "grate-cheese-rice-paper-snails",
        "en": {
          "title": "Grate the cheese",
          "description": "Grate the hard cheese on a fine grater."
        }
      },
      {
        "id": "chop-spinach-onion-rice-paper-snails",
        "en": {
          "title": "Chop spinach and green onion",
          "description": "Finely chop the spinach and green onion."
        }
      },
      {
        "id": "dice-bell-pepper-rice-paper-snails",
        "en": {
          "title": "Dice the bell pepper",
          "description": "Cut the red bell pepper into small squares."
        }
      },
      {
        "id": "combine-filling-rice-paper-snails",
        "en": {
          "title": "Combine all filling ingredients",
          "description": "Add the grated cheese, chopped spinach, green onion, and diced bell pepper to the tvorog mixture. Stir until evenly distributed."
        }
      },
      {
        "id": "pour-water-container-rice-paper-snails",
        "en": {
          "title": "Prepare water for softening rice paper",
          "description": "Pour water into a wide container or deep plate."
        }
      },
      {
        "id": "dip-first-sheet-rice-paper-snails",
        "en": {
          "title": "Dip first rice paper sheet",
          "description": "Immerse one sheet of rice paper in water for 5–10 seconds until it softens, then place it on a cutting board."
        }
      },
      {
        "id": "dip-second-sheet-overlap-rice-paper-snails",
        "en": {
          "title": "Add second sheet and overlap",
          "description": "Dip a second sheet of rice paper and place it slightly overlapping the first sheet to form a larger rectangle."
        }
      },
      {
        "id": "place-filling-on-sheet-rice-paper-snails",
        "en": {
          "title": "Portion the filling",
          "description": "Place one-fifth of the filling along the edge of the combined rice paper sheet."
        }
      },
      {
        "id": "roll-tightly-rice-paper-snails",
        "en": {
          "title": "Roll tightly",
          "description": "Roll the rice paper over the filling, pressing gently to form a tight log."
        }
      },
      {
        "id": "shape-snail-and-transfer-rice-paper-snails",
        "en": {
          "title": "Shape into snails and transfer to baking sheet",
          "description": "Coil the rolled log into a spiral (snail shape), pinch the edge to seal, and place on a parchment-covered baking sheet. Repeat for all remaining rolls."
        }
      },
      {
        "id": "brush-with-yolk-rice-paper-snails",
        "en": {
          "title": "Brush with egg yolk",
          "description": "Beat the egg yolk and brush it over the tops of the snails for a golden finish."
        }
      },
      {
        "id": "preheat-oven-rice-paper-snails",
        "en": {
          "title": "Preheat the oven",
          "description": "Preheat your oven to 200°C (400°F)."
        }
      },
      {
        "id": "bake-rice-paper-snails",
        "en": {
          "title": "Bake until crispy",
          "description": "Bake the snails in the preheated oven for 20–25 minutes, until the rice paper is golden and crispy."
        }
      }
