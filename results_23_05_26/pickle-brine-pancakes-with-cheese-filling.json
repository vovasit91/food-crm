        "en": {
          "title": "Beat eggs",
          "description": "Beat the eggs with a whisk or mixer until smooth and frothy."
        }
      },
      {
        "id": "add-brine-butter-to-eggs-pickle-brine-pancakes-with-cheese-filling",
        "en": {
          "title": "Add brine and butter to eggs",
          "description": "Add half of the pickle brine (125 ml) and melted butter to the beaten eggs. Mix until combined."
        }
      },
      {
        "id": "add-dry-to-wet-pickle-brine-pancakes-with-cheese-filling",
        "en": {
          "title": "Add dry ingredients to wet mixture",
          "description": "Gradually add the dry ingredient mixture to the egg mixture, stirring until smooth."
        }
      },
      {
        "id": "add-remaining-brine-pickle-brine-pancakes-with-cheese-filling",
        "en": {
          "title": "Add remaining brine",
          "description": "Pour in the remaining 125 ml of pickle brine and mix until the batter is smooth and thin."
        }
      },
      {
        "id": "heat-pan-pickle-brine-pancakes-with-cheese-filling",
        "en": {
          "title": "Heat the pan",
          "description": "Place a non-stick frying pan over high heat, then reduce to medium. Lightly oil the pan with a brush and remove excess oil with a paper towel."
        }
      },
      {
        "id": "fry-pancakes-pickle-brine-pancakes-with-cheese-filling",
        "en": {
          "title": "Fry pancakes",
          "description": "Pour a ladleful of batter into the pan and swirl to spread. Cook until the edges are golden brown, then flip and cook the other side. Repeat with remaining batter."
        }
      },
      {
        "id": "butter-pancakes-pickle-brine-pancakes-with-cheese-filling",
        "en": {
          "title": "Butter the pancakes",
          "description": "Brush each cooked pancake with melted butter."
        }
      },
      {
        "id": "mix-filling-pickle-brine-pancakes-with-cheese-filling",
        "en": {
          "title": "Mix the cheese filling",
          "description": "In a bowl, combine mozzarella, cream cheese, minced garlic, chopped parsley, and a pinch of salt. Mix until smooth."
        }
      },
      {
        "id": "fill-pancakes-pickle-brine-pancakes-with-cheese-filling",
        "en": {
          "title": "Fill and fold pancakes",
          "description": "Place about 50–60 g of filling in the center of each pancake. Fold the sides over to form an envelope shape."
        }
      }
