    "newCookingSteps": [
      {
        "id": "activate-yeast-poppy-accordion-bread",
        "en": {
          "title": "Activate the yeast",
          "description": "Warm 35 ml of milk in a microwave-safe bowl for about 1 minute until lukewarm. Stir in 1 g of yeast, 8 g of sugar, and 20 g of flour. Mix well and let sit for 5–10 minutes until frothy."
        }
      },
      {
        "id": "mix-dough-poppy-accordion-bread",
        "en": {
          "title": "Mix the dough",
          "description": "Crack the egg into the yeast mixture, add the remaining 14 g of sugar, water, and softened butter. Stir thoroughly until combined."
        }
      },
      {
        "id": "knead-dough-poppy-accordion-bread",
        "en": {
          "title": "Knead the dough",
          "description": "Add salt and the remaining 40 g of flour little by little while mixing. Knead into a smooth, soft dough."
        }
      },
      {
        "id": "first-rise-poppy-accordion-bread",
        "en": {
          "title": "Let the dough rise",
          "description": "Cover the dough with a clean towel and leave it in a warm place for 1–1.5 hours, or until it has doubled in volume."
        }
      },
      {
        "id": "heat-poppy-seeds-poppy-accordion-bread",
        "en": {
          "title": "Heat the poppy seeds",
          "description": "Place 2 g of poppy seeds in a small heatproof bowl or saucepan, add 5 ml of milk, stir, and heat over low heat for 2–3 minutes. Remove from heat, cover, and let cool."
        }
      },
      {
        "id": "punch-down-dough-poppy-accordion-bread",
        "en": {
          "title": "Punch down the dough",
          "description": "Punch the risen dough down to release air, then let it rest in a warm place for 15 minutes."
        }
      },
      {
        "id": "make-filling-poppy-accordion-bread",
        "en": {
          "title": "Make the filling",
          "description": "In a clean bowl, combine the second egg, 28 g of cream cheese, 14 g of sugar, and orange zest. Whisk until smooth. Fold in the cooled poppy seeds and mix well."
        }
      },
      {
        "id": "roll-and-fill-dough-poppy-accordion-bread",
        "en": {
          "title": "Roll and fill the dough",
          "description": "Dust your work surface with a little flour. Roll the dough into a 40x30 cm rectangle. Spread the poppy-cream cheese filling evenly over the surface, leaving a small border."
        }
      },
      {
        "id": "cut-and-arrange-dough-poppy-accordion-bread",
        "en": {
          "title": "Cut and arrange the dough",
          "description": "Cut the filled dough into equal squares. Stand the squares vertically in a baking pan, packing them tightly from one short side to the other."
        }
      },
      {
        "id": "second-rise-and-preheat-poppy-accordion-bread",
        "en": {
          "title": "Let the bread rise and preheat the oven",
          "description": "Cover the pan with a towel and let the dough rise for 40 minutes. Meanwhile, preheat your oven to 180°C."
        }
      },
      {
        "id": "bake-bread-poppy-accordion-bread",
        "en": {
          "title": "Bake the bread",
          "description": "Place the pan in the preheated oven and bake for 35–40 minutes, until golden brown. If the bread browns too quickly, cover it loosely with foil."
        }
      }
    ],
