    "newCookingSteps": [
      {
        "id": "prepare-ingredients-crostini-mushrooms-cheese",
        "en": {
          "title": "Prepare the ingredients",
          "description": "Slice the mushrooms into 2-3 mm thick pieces. Dice the onion into 3-4 mm cubes. Cut the baguette into 7-8 mm thick slices at an angle. Finely grate the Parmesan cheese."
        }
      },
      {
        "id": "saute-mushrooms-crostini-mushrooms-cheese",
        "en": {
          "title": "Sauté the mushrooms",
          "description": "Heat 1.5 tbsp olive oil in a skillet over medium heat. Add the mushrooms and cook, stirring, for 3-4 minutes until the liquid evaporates and they are golden brown."
        }
      },
      {
        "id": "add-onion-crostini-mushrooms-cheese",
        "en": {
          "title": "Add the onion",
          "description": "Add the diced onion to the skillet and cook together for another 2-3 minutes until the onion is golden. Season with salt and freshly ground black pepper. Stir and remove from heat."
        }
      },
      {
        "id": "toast-bread-crostini-mushrooms-cheese",
        "en": {
          "title": "Toast the bread",
          "description": "Preheat the oven to 180°C (350°F). Arrange the baguette slices on a baking sheet. Drizzle with the remaining olive oil and toast for about 5 minutes until golden."
        }
      },
      {
        "id": "assemble-and-grill-crostini-mushrooms-cheese",
        "en": {
          "title": "Assemble and grill",
          "description": "Top the toasted bread slices with the sautéed mushrooms and onion. Sprinkle evenly with grated Parmesan and a little more black pepper. Set the oven to grill mode and heat the crostini for 2-3 minutes until the cheese melts."
        }
      }
    ],
