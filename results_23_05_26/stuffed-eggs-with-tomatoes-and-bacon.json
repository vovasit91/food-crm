    "newCookingSteps": [
      {
        "id": "bring-water-to-boil-stuffed-eggs-with-tomatoes-and-bacon",
        "en": {
          "title": "Bring water to a boil",
          "description": "Place the eggs in a saucepan, cover with water, and set over high heat. Bring to a boil."
        }
      },
      {
        "id": "boil-eggs-stuffed-eggs-with-tomatoes-and-bacon",
        "en": {
          "title": "Boil eggs for 10 minutes",
          "description": "Once the water is boiling, reduce heat to medium and cook the eggs for exactly 10 minutes. Set a timer."
        }
      },
      {
        "id": "fry-bacon-stuffed-eggs-with-tomatoes-and-bacon",
        "en": {
          "title": "Fry bacon until crispy",
          "description": "While the eggs cook, place bacon slices in a dry frying pan over medium-high heat. Fry until crispy, then transfer to a paper towel-lined plate."
        }
      },
      {
        "id": "cool-and-peel-eggs-stuffed-eggs-with-tomatoes-and-bacon",
        "en": {
          "title": "Cool and peel the eggs",
          "description": "Transfer the boiled eggs to a bowl of ice water. Let them cool for a couple of minutes, then peel off the shells."
        }
      },
      {
        "id": "prepare-yolk-filling-stuffed-eggs-with-tomatoes-and-bacon",
        "en": {
          "title": "Prepare the yolk filling",
          "description": "Slice each egg in half lengthwise and remove the yolks. Mash the yolks with a fork in a bowl, then stir in mayonnaise, mustard, dried garlic, salt, and black pepper until smooth."
        }
      },
      {
        "id": "fill-egg-whites-stuffed-eggs-with-tomatoes-and-bacon",
        "en": {
          "title": "Fill the egg whites",
          "description": "Spoon the yolk mixture back into the cavities of the egg white halves, filling them evenly."
        }
      },
      {
        "id": "assemble-stuffed-eggs-stuffed-eggs-with-tomatoes-and-bacon",
        "en": {
          "title": "Assemble the stuffed eggs",
          "description": "Place a lettuce leaf on half of the filled egg halves. Top with a thin slice of tomato and a piece of bacon. Cover with the remaining egg halves and secure each mini sandwich with a toothpick."
        }
      }
    ],
