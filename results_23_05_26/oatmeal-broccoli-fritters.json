    "newCookingSteps": [
      {
        "id": "soak-oats-oatmeal-broccoli-fritters",
        "en": {
          "title": "Soak the oats",
          "description": "Place the rolled oats in a small bowl and pour boiling water over them until they are covered by about 1 cm. Let them soak for 30–40 minutes until softened and cooled."
        }
      },
      {
        "id": "thaw-and-boil-broccoli-oatmeal-broccoli-fritters",
        "en": {
          "title": "Thaw and boil the broccoli",
          "description": "Pour hot water over the broccoli and let it sit for 3 minutes to thaw. Then transfer to a small pot, add water and salt, and boil for 5 minutes."
        }
      },
      {
        "id": "drain-chop-blend-oatmeal-broccoli-fritters",
        "en": {
          "title": "Drain, chop and blend",
          "description": "Drain the broccoli in a colander and let it cool. Peel and roughly chop the onion. Transfer the broccoli and onion to a blender and pulse until finely chopped into a vegetable crumb."
        }
      },
      {
        "id": "combine-and-mix-oatmeal-broccoli-fritters",
        "en": {
          "title": "Combine and mix",
          "description": "Add the soaked oats to the broccoli-onion mixture, crack in the egg, crumble the brynza cheese with your hands, and season with salt and pepper. Mix thoroughly."
        }
      },
      {
        "id": "fry-fritters-oatmeal-broccoli-fritters",
        "en": {
          "title": "Fry the fritters",
          "description": "Heat vegetable oil in a frying pan over medium heat. Drop spoonfuls of the batter into the pan, shaping them into small fritters. Fry for 3 minutes on each side until golden brown."
        }
      }
    ],
