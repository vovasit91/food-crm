          "title": "Mix oat flakes into egg whites",
          "description": "Sprinkle the oat flakes over the egg whites and stir gently until combined."
        }
      },
      {
        "id": "mash-banana-strawberry-oat-pancake-with-banana",
        "en": {
          "title": "Mash half a banana",
          "description": "Take half of the banana and mash it with a fork until smooth. Add it to the oat mixture."
        }
      },
      {
        "id": "add-milk-whisk-strawberry-oat-pancake-with-banana",
        "en": {
          "title": "Add milk and whisk",
          "description": "Pour in the milk and whisk with a hand whisk or mixer until the batter is smooth and homogeneous."
        }
      },
      {
        "id": "add-spices-strawberry-oat-pancake-with-banana",
        "en": {
          "title": "Add cinnamon and vanilla",
          "description": "Add the ground cinnamon and vanilla. Mix well to incorporate the spices evenly."
        }
      },
      {
        "id": "rest-batter-strawberry-oat-pancake-with-banana",
        "en": {
          "title": "Let batter rest for 10 minutes",
          "description": "Allow the batter to sit at room temperature for 10 minutes. This lets the oats absorb the liquid and swell, creating a better texture."
        }
      },
      {
        "id": "heat-pan-strawberry-oat-pancake-with-banana",
        "en": {
          "title": "Heat and oil the pan",
          "description": "Set a non-stick frying pan over medium heat. Lightly grease the pan with vegetable oil."
        }
      },
      {
        "id": "pour-batter-strawberry-oat-pancake-with-banana",
        "en": {
          "title": "Pour batter into pan",
          "description": "Pour all the batter into the hot pan and spread it evenly to form one large pancake."
        }
      },
      {
        "id": "cook-first-side-strawberry-oat-pancake-with-banana",
        "en": {
          "title": "Cook first side for 3–4 minutes",
          "description": "Cook the pancake over medium heat for 3 to 4 minutes until the bottom is golden brown. Do not move it while cooking."
        }
      },
      {
        "id": "flip-pancake-strawberry-oat-pancake-with-banana",
        "en": {
          "title": "Flip the pancake",
          "description": "Lightly spray or brush the top of the pancake with a little oil. Carefully flip it over with a spatula."
        }
      },
      {
        "id": "cook-second-side-strawberry-oat-pancake-with-banana",
        "en": {
          "title": "Cook second side for 1–2 minutes",
          "description": "Continue cooking the second side for 1 to 2 minutes until it turns golden brown as well."
        }
      },
      {
        "id": "transfer-to-plate-strawberry-oat-pancake-with-banana",
        "en": {
