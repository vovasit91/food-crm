      {
        "id": "prep-vegetables-egg-cheese-toasts-air-fryer",
        "en": {
          "title": "Prepare the vegetables, cheese, and ham",
          "description": "Dice the bell pepper into 5–6 mm cubes. Finely chop the green onion. Grate the cheese on the large holes of a grater. Cut the ham into strips about 3–4 mm thick."
        }
      },
      {
        "id": "whisk-eggs-egg-cheese-toasts-air-fryer",
        "en": {
          "title": "Whisk the eggs with spices",
          "description": "Crack the eggs into a bowl. Add the salt, black pepper, and chili flakes. Whisk everything together well with a whisk."
        }
      },
      {
        "id": "mix-filling-egg-cheese-toasts-air-fryer",
        "en": {
          "title": "Mix the filling",
          "description": "Add the chopped green onion, bell pepper, ham, and grated cheese to the egg mixture. Stir everything together thoroughly with a spatula."
        }
      },
      {
        "id": "make-indentations-egg-cheese-toasts-air-fryer",
        "en": {
          "title": "Make indentations in the bread",
          "description": "Use the bottom of a glass to press small wells into each slice of bread."
        }
      },
      {
        "id": "fill-bread-egg-cheese-toasts-air-fryer",
        "en": {
          "title": "Fill the bread indentations",
          "description": "Spoon the egg-cheese mixture into the indentations, distributing it evenly."
        }
      },
      {
        "id": "bake-egg-cheese-toasts-air-fryer",
        "en": {
          "title": "Bake in the air fryer",
          "description": "Place the filled bread slices on parchment paper in the air fryer basket. Set the air fryer to 180°C and bake for 10 minutes."
        }
      },
      {
        "id": "cool-and-serve-egg-cheese-toasts-air-fryer",
