    "newCookingSteps": [
      {
        "id": "beat-eggs-blini-rolls-with-pate",
        "en": {
          "title": "Beat eggs with sugar and salt",
          "description": "Crack the eggs into a deep bowl, add sugar and a pinch of salt. Whisk until homogeneous and the sugar is completely dissolved."
        }
      },
      {
        "id": "heat-milk-blini-rolls-with-pate",
        "en": {
          "title": "Heat milk in microwave",
          "description": "Warm the milk in the microwave for 15-20 seconds until it is warm but not hot."
        }
      },
      {
        "id": "add-milk-oil-blini-rolls-with-pate",
        "en": {
          "title": "Add milk and oil to egg mixture",
          "description": "Add the warm milk and 1 tablespoon of vegetable oil to the eggs and mix again."
        }
      },
      {
        "id": "add-flour-blini-rolls-with-pate",
        "en": {
          "title": "Gradually add flour",
          "description": "Sift in the flour in small portions, mixing well after each addition until the batter resembles heavy cream."
        }
      },
      {
        "id": "rest-batter-blini-rolls-with-pate",
        "en": {
          "title": "Let batter rest",
          "description": "Leave the batter to rest at room temperature for 20-30 minutes."
        }
      },
      {
        "id": "heat-pan-pour-batter-blini-rolls-with-pate",
        "en": {
          "title": "Heat pan and pour batter",
          "description": "Heat a crepe pan over medium heat, grease it with the remaining oil. Pour about half a ladle of batter and quickly tilt the pan to spread it evenly."
        }
      },
      {
        "id": "fry-pancakes-blini-rolls-with-pate",
        "en": {
          "title": "Fry pancakes",
          "description": "Cook each pancake for about 1 minute until the edges start to brown, then flip and cook the other side for another minute until golden. Repeat for all batter."
        }
      },
      {
        "id": "assemble-rolls-blini-rolls-with-pate",
        "en": {
          "title": "Assemble and roll",
          "description": "Spread each pancake with a thin layer of pâté and roll tightly. Slice into bite-sized pieces and secure with skewers."
        }
      }
    ],
