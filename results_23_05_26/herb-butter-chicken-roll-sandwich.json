          "title": "Preheat the oven",
          "description": "Set your oven to preheat to 180°C. This will take about 10 minutes."
        }
      },
      {
        "id": "mix-herb-butter-herb-butter-chicken-roll-sandwich",
        "en": {
          "title": "Make the herb butter",
          "description": "In a bowl, combine soft butter with pressed garlic and finely chopped dill. Mix until smooth and well combined."
        }
      },
      {
        "id": "cut-and-spread-ciabatta-herb-butter-chicken-roll-sandwich",
        "en": {
          "title": "Cut and spread the ciabatta",
          "description": "Slice the ciabatta in half lengthwise. Spread the herb butter evenly on the cut sides of both halves."
        }
      },
      {
        "id": "bake-ciabatta-herb-butter-chicken-roll-sandwich",
        "en": {
          "title": "Bake the ciabatta",
          "description": "Place the ciabatta halves on a baking tray, buttered side up. Bake at 180°C for 10–12 minutes, until the edges are golden and crispy."
        }
      },
      {
        "id": "cool-ciabatta-herb-butter-chicken-roll-sandwich",
        "en": {
          "title": "Cool the ciabatta slightly",
          "description": "Remove the baked ciabatta from the oven and let it cool for a few minutes so it's easier to handle."
        }
      },
      {
        "id": "prepare-avocado-and-tomato-herb-butter-chicken-roll-sandwich",
        "en": {
          "title": "Prepare the avocado and tomato",
          "description": "Peel and pit the avocado, then slice it into 3–4 mm thick pieces. Slice the tomato into rounds of the same thickness."
        }
      },
      {
        "id": "assemble-bottom-layer-herb-butter-chicken-roll-sandwich",
        "en": {
          "title": "Assemble the bottom layer",
          "description": "On the bottom half of the ciabatta, place the lettuce leaves. Top with the tomato slices, then arrange the avocado slices on top."
        }
      },
      {
        "id": "add-chicken-roll-and-top-herb-butter-chicken-roll-sandwich",
        "en": {
          "title": "Add chicken roll and top",
          "description": "Place slices of chicken roll over the avocado. Cover with the top half of the ciabatta and press down gently."
        }
      }
