        "id": "mix-eggs-salt-kindergarten-omelette",
        "en": {
          "title": "Mix eggs with salt",
          "description": "Crack the eggs into a deep bowl. Add salt and stir gently with a fork or whisk, without beating to a foam."
        }
      },
      {
        "id": "add-milk-kindergarten-omelette",
        "en": {
          "title": "Add milk and mix",
          "description": "Pour the milk into the egg mixture and stir gently until combined. Avoid vigorous beating."
        }
      },
      {
        "id": "grease-dish-kindergarten-omelette",
        "en": {
          "title": "Grease the baking dish",
          "description": "Choose a heatproof dish with high sides. Use about 15g of the butter to generously grease the dish."
        }
      },
      {
        "id": "pour-mixture-kindergarten-omelette",
        "en": {
          "title": "Pour mixture into dish",
          "description": "Carefully pour the egg-milk mixture into the greased dish. The height of the omelette will depend on the size of the dish."
        }
      },
      {
        "id": "preheat-oven-kindergarten-omelette",
        "en": {
          "title": "Preheat oven to 200°C",
          "description": "Preheat your oven to 200°C (400°F). Make sure the oven is fully heated before baking."
        }
      },
      {
        "id": "bake-omelette-kindergarten-omelette",
        "en": {
          "title": "Bake the omelette",
          "description": "Place the dish in the preheated oven and bake for 15–20 minutes until set and golden. Do not open the oven during baking."
        }
      },
      {
        "id": "rest-omelette-kindergarten-omelette",
        "en": {
          "title": "Let the omelette rest in the oven",
          "description": "Turn off the oven and leave the dish inside for 5–7 minutes. This helps the omelette stay fluffy."
        }
      },
      {
        "id": "finish-omelette-kindergarten-omelette",
        "en": {
          "title": "Brush with butter and cut",
          "description": "Remove the omelette from the oven. Brush the top with the remaining 5g of butter. Let it cool slightly, then cut into squares to serve."
        }
      }
