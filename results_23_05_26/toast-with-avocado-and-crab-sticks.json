        "en": {
          "title": "Toast the bread",
          "description": "Heat a skillet over medium heat and toast the bread slices on both sides until golden and crispy, about 1–2 minutes per side. Transfer to a plate."
        }
      },
      {
        "id": "boil-egg-toast-with-avocado-and-crab-sticks",
        "en": {
          "title": "Boil the egg",
          "description": "Place the egg in a small pot, cover with water, and bring to a boil. Cook for about 10 minutes for a hard-boiled egg. Drain and cool under cold water."
        }
      },
      {
        "id": "chop-crab-sticks-and-tomatoes-toast-with-avocado-and-crab-sticks",
        "en": {
          "title": "Chop crab sticks and tomatoes",
          "description": "Remove crab sticks from packaging and chop into small pieces. Cut cherry tomatoes into quarters."
        }
      },
      {
        "id": "mash-egg-toast-with-avocado-and-crab-sticks",
        "en": {
          "title": "Mash the boiled egg",
          "description": "Peel the boiled egg and mash it with a fork until finely crumbled."
        }
      },
      {
        "id": "mix-filling-toast-with-avocado-and-crab-sticks",
        "en": {
          "title": "Mix the filling",
          "description": "In a bowl, combine the chopped crab sticks, quartered tomatoes, and mashed egg. Add cream cheese and stir until well combined."
        }
      },
      {
        "id": "mash-avocado-toast-with-avocado-and-crab-sticks",
        "en": {
          "title": "Mash the avocado",
          "description": "Transfer the avocado halves to a small bowl and mash with a fork until smooth. Season with salt to taste and mix."
        }
      },
      {
        "id": "assemble-toast-with-avocado-and-crab-sticks",
        "en": {
          "title": "Assemble the toasts",
          "description": "Spread the mashed avocado onto each toasted bread slice. Top with the crab stick filling. For extra heat, sprinkle with black pepper."
        }
      }
