    "newCookingSteps": [
      {
        "id": "combine-dry-ingredients-cheese-buns-parmesan-onion",
        "en": {
          "title": "Combine dry ingredients",
          "description": "In a bowl, combine the flour, baking powder, softened butter, sugar, and salt. Mix them together."
        }
      },
      {
        "id": "reserve-flour-cheese-buns-parmesan-onion",
        "en": {
          "title": "Reserve flour for dusting",
          "description": "Set aside 2 tablespoons of the flour mixture to use later for dusting the work surface."
        }
      },
      {
        "id": "rub-into-crumbs-cheese-buns-parmesan-onion",
        "en": {
          "title": "Rub mixture into crumbs",
          "description": "Use your hands to rub the mixture until it forms fine crumbs. This helps distribute the butter evenly."
        }
      },
      {
        "id": "chop-green-onion-cheese-buns-parmesan-onion",
        "en": {
          "title": "Chop green onion",
          "description": "Finely chop the green onion. Set aside."
        }
      },
      {
        "id": "grate-cheeses-cheese-buns-parmesan-onion",
        "en": {
          "title": "Grate cheeses",
          "description": "Coarsely grate the parmesan and maasdam cheeses. Use the large holes of a box grater."
        }
      },
      {
        "id": "add-onion-and-cheese-cheese-buns-parmesan-onion",
        "en": {
          "title": "Add onion and cheese to crumbs",
          "description": "Add the chopped green onion, all of the maasdam, and half of the parmesan to the crumb mixture."
        }
      },
      {
        "id": "mix-mixture-cheese-buns-parmesan-onion",
        "en": {
          "title": "Mix well",
          "description": "Stir everything together until the onion and cheese are evenly distributed throughout the crumbs."
        }
      },
      {
        "id": "add-milk-and-water-cheese-buns-parmesan-onion",
        "en": {
          "title": "Add milk and water",
          "description": "Pour the milk and 125 ml of water into the dry ingredients. Start mixing with a spoon."
        }
      },
      {
        "id": "knead-dough-cheese-buns-parmesan-onion",
        "en": {
          "title": "Knead the dough",
          "description": "Continue kneading the dough, first with a spoon and then with your hands, until it is soft and no longer sticks to your hands. The dough should be smooth and elastic."
        }
      },
      {
        "id": "dust-surface-cheese-buns-parmesan-onion",
        "en": {
          "title": "Dust work surface",
          "description": "Sprinkle the reserved flour onto your work surface to prevent sticking."
        }
      },
      {
        "id": "place-dough-cheese-buns-parmesan-onion",
        "en": {
          "title": "Place dough on surface",
          "description": "Transfer the kneaded dough onto the floured surface."
        }
      },
      {
        "id": "divide-dough-cheese-buns-parmesan-onion",
        "en": {
          "title": "Divide dough into portions",
          "description": "Use a culinary ring or a wide-mouthed glass to divide the dough into 5 equal parts. Each piece will become a bun."
        }
      },
      {
        "id": "preheat-oven-cheese-buns-parmesan-onion",
        "en": {
          "title": "Preheat the oven",
          "description": "Preheat your oven to 180°C (350°F) so it is ready for baking."
        }
      },
      {
        "id": "place-buns-on-sheet-cheese-buns-parmesan-onion",
        "en": {
          "title": "Place buns on baking sheet",
          "description": "Arrange the dough portions on a baking sheet, leaving some space between them."
        }
      },
      {
        "id": "grease-sheet-cheese-buns-parmesan-onion",
        "en": {
          "title": "Grease the baking sheet if needed",
          "description": "If desired, lightly brush the baking sheet with olive oil to prevent sticking."
        }
      },
      {
        "id": "sprinkle-parmesan-cheese-buns-parmesan-onion",
        "en": {
          "title": "Sprinkle with remaining parmesan",
          "description": "Sprinkle the remaining parmesan cheese over the tops of the buns."
        }
      },
      {
        "id": "bake-buns-cheese-buns-parmesan-onion",
        "en": {
          "title": "Bake the buns",
          "description": "Place the baking sheet in the preheated oven and bake for 15 minutes, until the buns are golden and cooked through."
        }
      },
      {
        "id": "cool-buns-cheese-buns-parmesan-onion",
        "en": {
          "title": "Cool the buns",
          "description": "Remove the buns from the oven and let them cool on a wire rack for 10–15 minutes before serving."
        }
      }
