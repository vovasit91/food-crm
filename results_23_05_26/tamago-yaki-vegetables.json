    "newCookingSteps": [
      {
        "id": "beat-eggs-tamago-yaki-vegetables",
        "en": {
          "title": "Beat the eggs",
          "description": "Crack the eggs into a bowl and beat them with a fork for 1–2 minutes until well combined."
        }
      },
      {
        "id": "prepare-vegetable-mixture-tamago-yaki-vegetables",
        "en": {
          "title": "Prepare vegetables and mix",
          "description": "Finely grate the carrot and chop the green onion. Add them to the beaten eggs and mix well. Season with salt and pepper."
        }
      },
      {
        "id": "heat-pan-and-pour-first-layer-tamago-yaki-vegetables",
        "en": {
          "title": "Heat the pan and pour first layer",
          "description": "Preheat a crepe pan over medium heat. Lightly grease it with vegetable oil. Pour a thin layer of the egg mixture and tilt the pan to spread it evenly."
        }
      },
      {
        "id": "roll-first-layer-tamago-yaki-vegetables",
        "en": {
          "title": "Roll the first layer",
          "description": "When the eggs start to set and are no longer runny on the bottom, use a spatula to lift one edge and roll the omelet into a log, leaving 2–3 cm of the free edge."
        }
      },
      {
        "id": "cook-remaining-layers-tamago-yaki-vegetables",
        "en": {
          "title": "Cook and roll remaining layers",
          "description": "Grease the exposed part of the pan again. Pour in a portion of the remaining egg mixture, spreading it to connect with the rolled part. Cook for 1–2 minutes, then roll it up. Repeat until all mixture is used."
        }
      },
      {
        "id": "slice-tamago-yaki-vegetables",
        "en": {
          "title": "Slice the tamagoyaki",
          "description": "Carefully transfer the rolled omelet to a cutting board and slice into bite-sized pieces. Serve warm or at room temperature."
        }
      }
    ],
