    "newCookingSteps": [
      {
        "id": "fry-seafood-paella-with-seafood-and-chicken",
        "en": {
          "title": "Fry the seafood",
          "description": "Heat the olive oil in a large skillet. Add the frozen seafood mixture and fry until the excess liquid evaporates, about 5 minutes."
        }
      },
      {
        "id": "add-wine-simmer-seafood-paella-with-seafood-and-chicken",
        "en": {
          "title": "Add white wine and simmer",
          "description": "Pour the white wine over the seafood. Simmer until the wine has completely evaporated."
        }
      },
      {
        "id": "fry-chicken-paella-with-seafood-and-chicken",
        "en": {
          "title": "Fry the chicken",
          "description": "In a separate skillet, heat oil and fry the chicken fillet until golden brown. Season with salt."
        }
      },
      {
        "id": "transfer-chicken-paella-with-seafood-and-chicken",
        "en": {
          "title": "Transfer the chicken",
          "description": "Remove the chicken from the skillet and set it aside on a plate."
        }
      },
      {
        "id": "fry-onion-garlic-paella-with-seafood-and-chicken",
        "en": {
          "title": "Fry onion and garlic",
          "description": "In the same skillet, fry the chopped onion and garlic until fragrant, about 2 minutes."
        }
      },
      {
        "id": "fry-vegetables-paella-with-seafood-and-chicken",
        "en": {
          "title": "Fry the vegetables",
          "description": "Add the diced bell pepper and tomatoes to the skillet. Cook over medium heat, stirring occasionally, for 7–10 minutes until softened."
        }
      },
      {
        "id": "add-rice-paella-with-seafood-and-chicken",
        "en": {
          "title": "Add rice and fry",
          "description": "Add the round-grain rice to the vegetables. Stir well and continue frying for 2–3 minutes to coat the rice with oil."
        }
      },
      {
        "id": "add-proteins-paella-with-seafood-and-chicken",
        "en": {
          "title": "Add the chicken and seafood",
          "description": "Return the cooked chicken and seafood to the skillet, distributing them evenly among the rice."
        }
      },
      {
        "id": "add-water-season-paella-with-seafood-and-chicken",
        "en": {
          "title": "Add water and season",
          "description": "Pour the water into the skillet. Season with salt, black pepper, and saffron. Stir gently to combine."
        }
      },
      {
        "id": "simmer-paella-with-seafood-and-chicken",
        "en": {
          "title": "Simmer until rice is tender",
          "description": "Reduce the heat to medium and simmer the paella uncovered for 15–20 minutes, until the rice is cooked and the liquid is absorbed. Do not stir during cooking."
        }
      }
    ],
