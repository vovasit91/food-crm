    "newCookingSteps": [
      {
        "id": "add-gelatin-three-layer-milk-jelly",
        "en": {
          "title": "Add gelatin and water",
          "description": "Sprinkle the gelatin powder into a small saucepan. Pour the cool water over it and stir briefly to combine."
        }
      },
      {
        "id": "bloom-gelatin-three-layer-milk-jelly",
        "en": {
          "title": "Let gelatin bloom",
          "description": "Let the gelatin sit for 10 to 15 minutes until it has absorbed the water and become spongy. This is called blooming."
        }
      },
      {
        "id": "heat-gelatin-three-layer-milk-jelly",
        "en": {
          "title": "Heat gelatin until dissolved",
          "description": "Place the saucepan over low heat. Warm the gelatin mixture, stirring gently, for 3 to 4 minutes until it is completely dissolved. Do not let it boil."
        }
      },
      {
        "id": "prepare-chocolate-mixture-three-layer-milk-jelly",
        "en": {
          "title": "Prepare chocolate mixture",
          "description": "In a bowl, pour 100 ml of milk, add the cocoa powder and 18.75 g of sugar. Stir in half of the dissolved gelatin mixture and whisk until smooth."
        }
      },
      {
        "id": "pour-chocolate-layer-three-layer-milk-jelly",
        "en": {
          "title": "Pour chocolate layer into dishes",
          "description": "Divide the chocolate mixture among your serving dishes. Tilt each dish slightly so the layer sets at an angle."
        }
      },
      {
        "id": "chill-chocolate-layer-three-layer-milk-jelly",
        "en": {
          "title": "Chill chocolate layer",
          "description": "Place the dishes in the refrigerator for 10 to 15 minutes, keeping them tilted, until the chocolate layer is set."
        }
      },
      {
        "id": "prepare-sour-cream-mixture-three-layer-milk-jelly",
        "en": {
          "title": "Prepare sour cream mixture",
          "description": "In a clean bowl, combine the sour cream, 75 ml of milk, and the remaining sugar. Add the rest of the gelatin mixture and stir until well blended."
        }
      },
      {
        "id": "pour-sour-cream-layer-three-layer-milk-jelly",
        "en": {
          "title": "Pour sour cream layer",
          "description": "Gently pour the sour cream mixture over the set chocolate layer. Tilt the dishes in the opposite direction this time."
        }
      },
      {
        "id": "chill-sour-cream-layer-three-layer-milk-jelly",
        "en": {
          "title": "Chill sour cream layer",
          "description": "Return the dishes to the refrigerator for 10 to 15 minutes, maintaining the tilt, until the sour cream layer is firm."
        }
      },
      {
        "id": "prepare-cherry-mixture-three-layer-milk-jelly",
        "en": {
          "title": "Prepare cherry mixture",
          "description": "In another bowl, combine the cherry juice, the remaining milk, and any leftover gelatin mixture. Stir until all crystals have dissolved completely."
        }
      },
      {
        "id": "pour-cherry-layer-three-layer-milk-jelly",
        "en": {
          "title": "Pour cherry layer",
          "description": "Carefully pour the cherry mixture over the two set layers in each dish."
        }
      },
      {
        "id": "chill-cherry-layer-three-layer-milk-jelly",
        "en": {
          "title": "Chill until fully set",
          "description": "Place the dishes in the refrigerator and let them chill for 2 to 3 hours until the jelly is completely firm."
        }
      }
    ],
