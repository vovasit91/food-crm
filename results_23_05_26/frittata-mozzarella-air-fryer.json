      },
      {
        "id": "grate-cheese-frittata-mozzarella-air-fryer",
        "en": {
          "title": "Grate the hard cheese",
          "description": "Coarsely grate the hard cheese and set aside."
        }
      },
      {
        "id": "crack-eggs-frittata-mozzarella-air-fryer",
        "en": {
          "title": "Crack the eggs into the air fryer container",
          "description": "Carefully crack the eggs onto a piece of parchment paper in the air fryer container, being careful not to break the yolks. Season with salt and black pepper."
        }
      },
      {
        "id": "assemble-frittata-mozzarella-air-fryer",
        "en": {
          "title": "Assemble the frittata",
          "description": "Arrange the broccoli florets, cherry tomato halves, and diced bell pepper on the egg whites. Distribute the mini mozzarella balls in the gaps. Sprinkle the grated cheese evenly over everything."
        }
      },
      {
        "id": "cook-frittata-mozzarella-air-fryer",
        "en": {
          "title": "Cook the frittata in the air fryer",
          "description": "Set the air fryer to 180°C in the 'Vegetables' mode and the timer to 20 minutes. Place the container inside and wait until the frittata is fully cooked."
        }
      },
      {
        "id": "serve-frittata-mozzarella-air-fryer",
        "en": {
          "title": "Serve the frittata",
          "description": "Transfer the frittata to a serving plate and cut it into portions."
