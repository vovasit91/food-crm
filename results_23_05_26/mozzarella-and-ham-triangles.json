    "newCookingSteps": [
      {
        "id": "prep-ingredients-mozzarella-and-ham-triangles",
        "en": {
          "title": "Trim crusts and slice cheese and ham",
          "description": "Cut the crusts off the bread slices. Slice the mozzarella and ham into 3-4 mm thick slices."
        }
      },
      {
        "id": "assemble-sandwiches-mozzarella-and-ham-triangles",
        "en": {
          "title": "Assemble the sandwiches",
          "description": "Place half of the mozzarella slices on 4 bread slices. Evenly distribute the ham slices on top. Cover with the remaining mozzarella, then top with the remaining 4 bread slices."
        }
      },
      {
        "id": "prepare-coating-mozzarella-and-ham-triangles",
        "en": {
          "title": "Prepare the coating station",
          "description": "In a bowl, crack the eggs, add salt and pepper, and whisk until combined. Pour the milk into a separate bowl. Place the flour in another bowl."
        }
      },
      {
        "id": "coat-sandwiches-mozzarella-and-ham-triangles",
        "en": {
          "title": "Coat the sandwiches",
          "description": "One by one, dip each assembled sandwich completely in milk, then coat in flour, and finally dip in the egg mixture, ensuring even coverage."
        }
      },
      {
        "id": "heat-oil-mozzarella-and-ham-triangles",
        "en": {
          "title": "Heat the oil",
          "description": "Pour the vegetable oil into a frying pan and heat it over medium heat until hot."
        }
      },
      {
        "id": "fry-sandwiches-mozzarella-and-ham-triangles",
        "en": {
          "title": "Fry the sandwiches",
          "description": "Place the coated sandwiches in the hot oil and fry for 2-3 minutes on each side, until golden brown and the cheese is melted."
        }
      }
    ],
