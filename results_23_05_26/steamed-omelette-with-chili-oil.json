    "newCookingSteps": [
      {
        "id": "slice-vegetables-steamed-omelette-with-chili-oil",
        "en": {
          "title": "Slice the vegetables",
          "description": "Slice the shallot and fresh chili into thin half-rings, and cut the garlic into thin slices."
        }
      },
      {
        "id": "heat-oil-with-spices-steamed-omelette-with-chili-oil",
        "en": {
          "title": "Heat oil and bloom spices",
          "description": "Heat the vegetable oil in a saucepan over medium heat. Add the chili flakes, smoked paprika, and cinnamon stick. Fry for 1 minute until fragrant."
        }
      },
      {
        "id": "cook-aromatics-in-oil-steamed-omelette-with-chili-oil",
        "en": {
          "title": "Cook aromatics in oil",
          "description": "Add the sliced shallot, garlic, and fresh chili to the oil. Reduce heat to low and cook for 10–15 minutes until the vegetables are golden. Stir occasionally."
        }
      },
      {
        "id": "season-and-strain-oil-steamed-omelette-with-chili-oil",
        "en": {
          "title": "Season and strain the chili oil",
          "description": "Remove the saucepan from heat. Add soy sauce and a pinch of sugar, then stir. Strain the oil through a fine sieve or cheesecloth to remove spices and fried pieces."
        }
      },
      {
        "id": "heat-broth-steamed-omelette-with-chili-oil",
        "en": {
          "title": "Heat the broth",
          "description": "Heat the chicken broth in a small saucepan until it just begins to boil."
        }
      },
      {
        "id": "whisk-eggs-steamed-omelette-with-chili-oil",
        "en": {
          "title": "Whisk the eggs",
          "description": "Crack the eggs into a bowl and whisk until homogeneous and smooth."
        }
      },
      {
        "id": "combine-broth-and-eggs-steamed-omelette-with-chili-oil",
        "en": {
          "title": "Combine broth with eggs",
          "description": "Slowly pour the hot broth into the whisked eggs in a thin stream while stirring continuously to prevent the eggs from curdling."
        }
      },
      {
        "id": "add-chili-oil-to-mixture-steamed-omelette-with-chili-oil",
        "en": {
          "title": "Add chili oil to the mixture",
          "description": "Add a portion of the prepared chili oil to the egg and broth mixture and stir gently."
        }
      },
      {
        "id": "strain-egg-mixture-steamed-omelette-with-chili-oil",
        "en": {
          "title": "Strain the egg mixture",
          "description": "Pass the mixture through a fine sieve to ensure a silky smooth texture."
        }
      },
      {
        "id": "pour-into-molds-steamed-omelette-with-chili-oil",
        "en": {
          "title": "Pour into molds",
          "description": "Divide the mixture among portion-sized molds, filling them about halfway."
        }
      },
      {
        "id": "steam-omelette-steamed-omelette-with-chili-oil",
        "en": {
          "title": "Steam the omelette",
          "description": "Place the molds in a steamer or on a rack over a pot of boiling water. Cover and steam over low heat for 12–15 minutes until the custard is set."
        }
      }
    ],
