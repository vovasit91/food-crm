    "newCookingSteps": [
      {
        "id": "prepare-banana-chocolate-oatmeal",
        "en": {
          "title": "Prepare the banana",
          "description": "Peel the banana and cut it in half crosswise. Using a fork, mash one half into a smooth puree. Set aside."
        }
      },
      {
        "id": "boil-liquid-chocolate-oatmeal",
        "en": {
          "title": "Boil water and milk",
          "description": "Pour water and milk into a saucepan. Bring to a boil over high heat."
        }
      },
      {
        "id": "cook-oats-chocolate-oatmeal",
        "en": {
          "title": "Cook the oats",
          "description": "Once the liquid boils, stir in the rolled oats. Reduce the heat to low and cook according to the package directions, stirring occasionally. About 5 minutes before the oatmeal is done, proceed to the next step."
        }
      },
      {
        "id": "add-banana-cocoa-chocolate-oatmeal",
        "en": {
          "title": "Add banana puree and cocoa",
          "description": "Add the mashed banana and cocoa powder to the oatmeal. Stir thoroughly until the cocoa is fully dissolved and the mixture is a uniform chocolate color."
        }
      },
      {
        "id": "finish-cooking-chocolate-oatmeal",
        "en": {
          "title": "Finish cooking the oatmeal",
          "description": "Continue cooking the oatmeal on low heat until it reaches your desired consistency, about 5 more minutes. Stir gently from time to time."
        }
      },
      {
        "id": "fry-banana-chocolate-oatmeal",
        "en": {
          "title": "Fry the banana slices",
          "description": "Slice the remaining banana half lengthwise. Melt butter in a frying pan over medium heat. Place the banana slices cut-side down and fry for 1–2 minutes until golden caramelized. Flip and warm for another 30 seconds."
        }
      },
      {
        "id": "serve-chocolate-oatmeal",
        "en": {
          "title": "Serve the oatmeal",
          "description": "Transfer the chocolate oatmeal to a bowl. Top with the fried banana slices, whole cashews, and fresh mint leaves."
        }
      }
