    "newCookingSteps": [
      {
        "id": "mix-sauce-tuna-sandwich-garlic-sauce",
        "en": {
          "title": "Mix the sauce",
          "description": "In a small bowl, combine mayonnaise, chili sauce, a few drops of Worcestershire sauce, and a pinch of salt and pepper. Stir until smooth."
        }
      },
      {
        "id": "prep-vegetables-tuna-sandwich-garlic-sauce",
        "en": {
          "title": "Prepare the vegetables",
          "description": "Peel the outer layer of the celery stalk using a vegetable peeler, then cut it into small cubes. Dice the tomato and shallot finely, and chop the cilantro. Transfer everything into a mixing bowl."
        }
      },
      {
        "id": "combine-filling-tuna-sandwich-garlic-sauce",
        "en": {
          "title": "Combine the filling",
          "description": "Drain the tuna and flake it with a fork. Add it to the bowl with the vegetables. Pour in the prepared sauce and mix well."
        }
      },
      {
        "id": "melt-garlic-butter-tuna-sandwich-garlic-sauce",
        "en": {
          "title": "Melt garlic butter",
          "description": "Place the butter in a microwave-safe bowl and add the pressed garlic. Microwave on high power for 15 seconds until melted."
        }
      },
      {
        "id": "cut-and-butter-bread-tuna-sandwich-garlic-sauce",
        "en": {
          "title": "Cut and butter the bread",
          "description": "Slice the ciabatta in half lengthwise, then cut each half into 2 or 4 pieces. Brush each piece with the garlic butter."
        }
      },
      {
        "id": "toast-bread-tuna-sandwich-garlic-sauce",
        "en": {
          "title": "Toast the bread",
          "description": "Brown the bread on a skillet or in the oven for about 3 minutes until golden and crisp."
        }
      },
      {
        "id": "assemble-sandwiches-tuna-sandwich-garlic-sauce",
        "en": {
          "title": "Assemble the sandwiches",
          "description": "Spoon the tuna filling onto the bottom halves of the toasted ciabatta and cover with the top halves."
        }
      }
    ],
