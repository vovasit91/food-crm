    "newCookingSteps": [
      {
        "id": "cut-chicken-chicken-roll-for-sandwiches",
        "en": {
          "title": "Cut the chicken into strips",
          "description": "Slice the chicken fillet into long strips about 2-3 cm wide. This will help the roll form easily."
        }
      },
      {
        "id": "mix-chicken-with-spices-chicken-roll-for-sandwiches",
        "en": {
          "title": "Mix chicken with spices",
          "description": "Place the chicken strips in a bowl. Add salt, black pepper, dried garlic, paprika, Italian herbs, and gelatin. Mix thoroughly until all strips are evenly coated."
        }
      },
      {
        "id": "arrange-chicken-on-sleeve-chicken-roll-for-sandwiches",
        "en": {
          "title": "Arrange chicken on baking sleeve",
          "description": "Lay out a baking sleeve on your work surface. Place the chicken strips on it, slightly overlapping, to form a sausage-like shape."
        }
      },
      {
        "id": "roll-and-wrap-chicken-roll-for-sandwiches",
        "en": {
          "title": "Roll and wrap the chicken roll",
          "description": "Roll the baking sleeve tightly around the chicken to form a compact cylinder. Then wrap it in aluminum foil, twisting the ends to seal."
        }
      },
      {
        "id": "place-roll-in-dish-chicken-roll-for-sandwiches",
        "en": {
          "title": "Place roll in baking dish with water",
          "description": "Put the wrapped roll into a baking dish. Pour cold water into the dish until it reaches halfway up the roll. This ensures even cooking."
        }
      },
      {
        "id": "bake-chicken-roll-for-sandwiches",
        "en": {
          "title": "Bake the chicken roll",
          "description": "Preheat the oven to 200°C (400°F). Bake the roll for 60–80 minutes, until fully cooked through. The internal temperature should reach 74°C (165°F)."
        }
      },
      {
        "id": "cool-chicken-roll-for-sandwiches",
        "en": {
          "title": "Cool the chicken roll completely",
          "description": "Remove the roll from the oven and let it cool completely at room temperature. This allows the gelatin to set and the roll to hold its shape when sliced."
        }
      }
    ],
