    "newCookingSteps": [
      {
        "id": "prepare-marinade-festive-chicken-with-mandarins",
        "en": {
          "title": "Prepare the marinade",
          "description": "Squeeze the juice from half of one mandarin. Mix it with soy sauce and honey. Press the garlic through a press and add it along with salt and ground black pepper. Stir thoroughly."
        }
      },
      {
        "id": "coat-chicken-festive-chicken-with-mandarins",
        "en": {
          "title": "Coat the chicken with marinade",
          "description": "Place the chicken in a large bowl and coat it with the marinade on all sides, inside and out."
        }
      },
      {
        "id": "refrigerate-chicken-festive-chicken-with-mandarins",
        "en": {
          "title": "Refrigerate the chicken",
          "description": "Transfer the chicken to the refrigerator and let it marinate for 2 hours."
        }
      },
      {
        "id": "slice-mandarins-festive-chicken-with-mandarins",
        "en": {
          "title": "Slice the mandarins",
          "description": "Cut the remaining mandarins into thin rounds."
        }
      },
      {
        "id": "assemble-chicken-bag-festive-chicken-with-mandarins",
        "en": {
          "title": "Assemble the chicken in a baking bag",
          "description": "Place the sliced mandarins in a roasting bag. Place the marinated chicken on top and seal the bag with kitchen twine or cotton string."
        }
      },
      {
        "id": "cut-vegetables-festive-chicken-with-mandarins",
        "en": {
          "title": "Cut the vegetables",
          "description": "Cut the potatoes into wedges. Halve the mushrooms."
        }
      },
      {
        "id": "assemble-vegetable-bag-festive-chicken-with-mandarins",
        "en": {
          "title": "Assemble the vegetable bag",
          "description": "Place the potatoes and mushrooms in a second roasting bag. Season with salt and pepper, then seal the bag."
        }
      },
      {
        "id": "preheat-oven-festive-chicken-with-mandarins",
        "en": {
          "title": "Preheat the oven",
          "description": "Preheat your oven to 180°C (350°F)."
        }
      },
      {
        "id": "bake-everything-festive-chicken-with-mandarins",
        "en": {
          "title": "Bake the chicken and potatoes",
          "description": "Place both roasting bags in the preheated oven. Bake for 60 minutes until the chicken is golden and the potatoes are tender. Serve hot."
        }
      }
