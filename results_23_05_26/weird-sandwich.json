    "newCookingSteps": [
      {
        "id": "cut-crusts-weird-sandwich",
        "en": {
          "title": "Cut the crusts off the bread",
          "description": "Use a sharp knife to cut off the crusts from all six slices of bread."
        }
      },
      {
        "id": "beat-egg-weird-sandwich",
        "en": {
          "title": "Beat the egg",
          "description": "Crack one egg into a bowl and beat it with a fork until the yolk and white are fully combined. Do not whisk to a froth."
        }
      },
      {
        "id": "dip-bread-weird-sandwich",
        "en": {
          "title": "Dip bread slices in egg",
          "description": "Take two slices of the bread and dip them into the beaten egg on both sides, ensuring they are fully coated. Reserve the remaining egg."
        }
      },
      {
        "id": "fry-bread-weird-sandwich",
        "en": {
          "title": "Fry the dipped bread",
          "description": "Heat a non-stick pan over high heat and fry the egg-coated bread slices for about 1 minute per side until golden brown. Set aside."
        }
      },
      {
        "id": "mix-mayo-honey-weird-sandwich",
        "en": {
          "title": "Mix mayonnaise and honey",
          "description": "In a clean bowl, combine one tablespoon of mayonnaise with one teaspoon of honey and stir until smooth."
        }
      },
      {
        "id": "spread-mixture-weird-sandwich",
        "en": {
          "title": "Spread the mixture on bread",
          "description": "Spread the mayonnaise-honey mixture on one side of each of the remaining four bread slices."
        }
      },
      {
        "id": "assemble-sandwiches-weird-sandwich",
        "en": {
          "title": "Assemble the sandwiches",
          "description": "Place two of the spread bread slices mayo-side up. Top each with two slices of ham, then place one fried bread slice on top of the ham. Add the remaining ham slices on the fried bread and cover with the remaining spread bread slices, mayo-side down."
        }
      },
      {
        "id": "mix-egg-milk-weird-sandwich",
        "en": {
          "title": "Mix leftover egg with milk",
          "description": "Add the 50 ml of milk to the leftover beaten egg and whisk until combined."
        }
      },
      {
        "id": "coat-sandwiches-weird-sandwich",
        "en": {
          "title": "Coat the sandwiches",
          "description": "Butter the top and bottom of each sandwich, then brush the buttered surfaces with the egg-milk mixture."
        }
      },
      {
        "id": "bake-sandwiches-weird-sandwich",
        "en": {
          "title": "Bake the sandwiches",
          "description": "Place the sandwiches on a parchment-lined baking sheet, sprinkle with sugar, and bake in a preheated oven at 220°C for 5 minutes until golden and caramelized."
        }
      }
    ],
