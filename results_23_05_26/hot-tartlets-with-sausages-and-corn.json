    "newCookingSteps": [
      {
        "id": "roll-dough-hot-tartlets-with-sausages-and-corn",
        "en": {
          "title": "Roll out the dough",
          "description": "Dust your work surface with flour, place the puff pastry, and roll it into two sheets about 2–3 mm thick. Cut out circles slightly larger than your tartlet molds so you can form raised edges."
        }
      },
      {
        "id": "line-molds-hot-tartlets-with-sausages-and-corn",
        "en": {
          "title": "Line the molds",
          "description": "Grease the tartlet molds evenly with vegetable oil. Place a dough circle into each mold, pressing it against the sides to form edges. Cover with a clean cloth and leave in a warm place for 30 minutes to rise."
        }
      },
      {
        "id": "proof-dough-hot-tartlets-with-sausages-and-corn",
        "en": {
          "title": "Proof the dough",
          "description": "Let the lined molds rest at room temperature, covered with a towel, for 30 minutes. This allows the dough to puff slightly before baking."
        }
      },
      {
        "id": "grate-and-chop-hot-tartlets-with-sausages-and-corn",
        "en": {
          "title": "Grate and chop filling ingredients",
          "description": "Coarsely grate the cheese. Dice the bell pepper and sausages into 4–5 mm cubes. Finely chop the green onions."
        }
      },
      {
        "id": "combine-filling-hot-tartlets-with-sausages-and-corn",
        "en": {
          "title": "Combine the filling",
          "description": "In a mixing bowl, combine the grated cheese, diced pepper and sausages, and chopped green onions. Add the canned corn and stir everything together."
        }
      },
      {
        "id": "preheat-oven-hot-tartlets-with-sausages-and-corn",
        "en": {
          "title": "Preheat the oven",
          "description": "Set your oven to 180°C (350°F) so it is hot by the time you are ready to bake."
        }
      },
      {
        "id": "make-custard-hot-tartlets-with-sausages-and-corn",
        "en": {
          "title": "Make the egg‑cream custard",
          "description": "Crack the eggs into a clean bowl and whisk lightly. Pour in the heavy cream, add the Dijon mustard, salt, and black pepper. Whisk until well combined."
        }
      },
      {
        "id": "fill-tartlets-hot-tartlets-with-sausages-and-corn",
        "en": {
          "title": "Fill the tartlet shells",
          "description": "Divide the filling mixture evenly among the proofed tartlet shells. Pour about 2 tablespoons of the egg‑cream custard into each shell, over the filling."
        }
      },
      {
        "id": "bake-tartlets-hot-tartlets-with-sausages-and-corn",
        "en": {
          "title": "Bake the tartlets",
          "description": "Place the filled tartlets in the preheated oven and bake at 180°C for 25–30 minutes, until the tops are golden and the custard is set. Let them cool slightly before serving."
        }
      }
    ],
