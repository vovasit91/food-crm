          "title": "Mix the dough",
          "description": "Add the grated cheese, rice flour, and salt to the tvorog mixture. Stir well until evenly combined."
        }
      },
      {
        "id": "divide-dough-bagels-air-fryer",
        "en": {
          "title": "Divide the dough",
          "description": "Split the tvorog dough into two equal portions."
        }
      },
      {
        "id": "shape-bagels-bagels-air-fryer",
        "en": {
          "title": "Shape the bagels",
          "description": "Roll each portion into a thick sausage. Join the ends to form a ring, pinching firmly to seal. Repeat with the second piece."
        }
      },
      {
        "id": "transfer-to-air-fryer-bagels-air-fryer",
        "en": {
          "title": "Transfer to air fryer",
          "description": "Place the shaped bagels onto a parchment-lined air fryer basket."
        }
      },
      {
        "id": "brush-with-yolk-bagels-air-fryer",
        "en": {
          "title": "Brush with yolk",
          "description": "Brush the tops of the bagels with the reserved egg yolk for a golden finish."
        }
      },
      {
        "id": "sprinkle-sesame-bagels-air-fryer",
        "en": {
          "title": "Sprinkle sesame seeds",
          "description": "Sprinkle sesame seeds (and black sesame if desired) over the bagels."
        }
      },
      {
        "id": "bake-bagels-air-fryer",
        "en": {
          "title": "Bake the bagels",
          "description": "Bake in the air fryer for 15–20 minutes until golden brown and cooked through."
        }
      },
      {
        "id": "prepare-filling-bagels-air-fryer",
        "en": {
          "title": "Prepare the filling",
          "description": "Slice the tomato and ham, and wash the spinach leaves."
        }
