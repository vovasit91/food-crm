    "newCookingSteps": [
      {
        "id": "mix-eggs-and-milk-pancakes-with-cottage-cheese-and-berries",
        "en": {
          "title": "Mix eggs and milk",
          "description": "Crack the eggs into a bowl. Add half of the milk and whisk until combined."
        }
      },
      {
        "id": "add-dry-ingredients-pancakes-with-cottage-cheese-and-berries",
        "en": {
          "title": "Add dry ingredients",
          "description": "Sift in the flour, then add salt and sugar. Mix until smooth and no lumps remain."
        }
      },
      {
        "id": "add-remaining-milk-water-pancakes-with-cottage-cheese-and-berries",
        "en": {
          "title": "Add remaining milk and water",
          "description": "Pour in the rest of the milk and the water. Stir until the batter is homogeneous."
        }
      },
      {
        "id": "add-oil-pancakes-with-cottage-cheese-and-berries",
        "en": {
          "title": "Add oil",
          "description": "Add the vegetable oil and mix well. The batter is now ready."
        }
      },
      {
        "id": "rest-batter-pancakes-with-cottage-cheese-and-berries",
        "en": {
          "title": "Rest the batter",
          "description": "Cover the bowl and let the batter rest for 30 minutes. This allows the gluten to relax for tender pancakes."
        }
      },
      {
        "id": "cook-pancakes-pancakes-with-cottage-cheese-and-berries",
        "en": {
          "title": "Cook pancakes",
          "description": "Heat a non-stick pan over medium heat with a little oil. Pour a ladleful of batter, swirl to cover the surface, and cook for 30–40 seconds per side until golden. Repeat with remaining batter."
        }
      },
      {
        "id": "stack-pancakes-pancakes-with-cottage-cheese-and-berries",
        "en": {
          "title": "Stack cooked pancakes",
          "description": "Stack the cooked pancakes on a plate and cover with a clean kitchen towel to keep them warm and moist."
        }
      },
      {
        "id": "make-filling-pancakes-with-cottage-cheese-and-berries",
        "en": {
          "title": "Make the filling",
          "description": "In a deep bowl, whip the heavy cream with powdered sugar until stiff peaks form. Reserve one-third of the whipped cream for serving. Add the cottage cheese to the remaining cream and mix until smooth."
        }
      },
      {
        "id": "assemble-pancakes-pancakes-with-cottage-cheese-and-berries",
        "en": {
          "title": "Assemble the pancakes",
          "description": "Line small bowls or a muffin tin with plastic wrap, letting the edges hang over. Place a pancake in each lined bowl. Spoon some cottage cheese filling in the center, make a small indent, and add berries or jam. Cover with more filling, then fold the pancake edges toward the center. Gather the plastic wrap and twist to seal tightly. Repeat for all pancakes."
        }
      },
      {
        "id": "refrigerate-pancakes-pancakes-with-cottage-cheese-and-berries",
        "en": {
          "title": "Chill the pancakes",
          "description": "Place the wrapped pancake bundles in the refrigerator and chill for at least 3 hours, or until firm."
        }
      },
      {
        "id": "serve-pancakes-pancakes-with-cottage-cheese-and-berries",
        "en": {
          "title": "Serve",
          "description": "Unwrap the chilled pancakes. Place a dollop of the reserved whipped cream on a plate, then set a pancake bundle on top. Serve immediately."
        }
      }
    ],
