    "newCookingSteps": [
      {
        "id": "boil-beets-vegetable-waffles-breakfast",
        "en": {
          "title": "Boil the beets",
          "description": "Place the beets in a pot of salted water and bring to a boil. Cook for 45–50 minutes until tender."
        }
      },
      {
        "id": "cool-peel-grate-beets-vegetable-waffles-breakfast",
        "en": {
          "title": "Cool, peel, and grate the beets",
          "description": "Let the beets cool slightly, then peel them. Grate the beets on a coarse grater and squeeze out excess moisture."
        }
      },
      {
        "id": "grate-celery-carrots-vegetable-waffles-breakfast",
        "en": {
          "title": "Grate celery root and carrots",
          "description": "Peel the celery root and carrots. Grate them coarsely and place each in separate bowls."
        }
      },
      {
        "id": "chop-onion-grate-cheese-vegetable-waffles-breakfast",
        "en": {
          "title": "Chop onion and grate cheese",
          "description": "Finely chop the onion. Grate the hard cheese on a fine grater. Combine them in a large clean bowl."
        }
      },
      {
        "id": "mix-batter-vegetable-waffles-breakfast",
        "en": {
          "title": "Mix the batter",
          "description": "Add the flour, milk, eggs, and salt to the bowl with onion and cheese. Stir until well combined."
        }
      },
      {
        "id": "divide-batter-vegetable-waffles-breakfast",
        "en": {
          "title": "Divide the batter",
          "description": "Divide the batter into three equal portions."
        }
      },
      {
        "id": "add-vegetables-to-batter-vegetable-waffles-breakfast",
        "en": {
          "title": "Add grated vegetables to the batter",
          "description": "Add one type of grated vegetable to each portion of batter: carrots to one, celery root to another, and beets to the third."
        }
      },
      {
        "id": "add-herbs-vegetable-waffles-breakfast",
        "en": {
          "title": "Add herbs",
          "description": "To the carrot batter, add chopped mint and thyme. To the beet batter, add chopped dill. To the celery root batter, add chopped parsley. Mix each well."
        }
      },
      {
        "id": "cook-waffles-vegetable-waffles-breakfast",
        "en": {
          "title": "Cook the waffles",
          "description": "Grease the waffle iron with vegetable oil. Spoon 2–3 tablespoons of one batter onto the iron, close, and cook for 3–4 minutes until golden. Repeat with the remaining batter."
        }
      }
    ],
