    "newCookingSteps": [
      {
        "id": "mix-kefir-cod-and-olive-boats",
        "en": {
          "title": "Mix kefir with dry ingredients and let rest",
          "description": "Pour kefir into a bowl, add salt, sugar, and baking soda. Stir and leave for 5 minutes until bubbles appear. Then pour in vegetable oil and mix again."
        }
      },
      {
        "id": "add-flour-cod-and-olive-boats",
        "en": {
          "title": "Add flour and form the dough",
          "description": "Add half of the flour to the kefir mixture and stir. Gradually add the remaining flour, gathering the dough into a ball."
        }
      },
      {
        "id": "knead-dough-cod-and-olive-boats",
        "en": {
          "title": "Knead the dough",
          "description": "Transfer the dough to a floured work surface. Knead until it stops sticking to your hands, adding more flour as needed."
        }
      },
      {
        "id": "rest-dough-cod-and-olive-boats",
        "en": {
          "title": "Let the dough rest",
          "description": "Cover the dough with a towel and leave it to rest for 25–30 minutes."
        }
      },
      {
        "id": "prep-filling-cod-and-olive-boats",
        "en": {
          "title": "Prepare the filling ingredients",
          "description": "Pat the cod dry with paper towels and cut into small cubes. Halve the cherry tomatoes, slice the olives into rounds, and finely grate the cheese."
        }
      },
      {
        "id": "shape-dough-cod-and-olive-boats",
        "en": {
          "title": "Shape the dough into boats",
          "description": "Divide the dough into portions. Roll one portion into an oval and transfer to a parchment-lined baking sheet. Fold the edges inward to form boat shapes with pointed ends."
        }
      },
      {
        "id": "assemble-boats-cod-and-olive-boats",
        "en": {
          "title": "Assemble the boats with filling",
          "description": "Spread cream cheese in the center of the boats. Top with cod, tomatoes, and olives. Lightly salt and sprinkle with grated cheese."
        }
      },
      {
        "id": "brush-and-bake-cod-and-olive-boats",
        "en": {
          "title": "Brush and bake the boats",
          "description": "Brush the dough edges with egg yolk. Bake in a preheated oven at 170°C for 20–25 minutes until golden brown."
        }
      }
    ],
