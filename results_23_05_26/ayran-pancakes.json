    "newCookingSteps": [
      {
        "id": "make-well-and-mix-ayran-pancakes",
        "en": {
          "title": "Make a well and mix",
          "description": "Sift the flour into a bowl and make a well in the center. Pour in the ayran at room temperature and stir gently to combine."
        }
      },
      {
        "id": "add-soda-salt-and-beat-ayran-pancakes",
        "en": {
          "title": "Add soda and salt and beat",
          "description": "Add the baking soda and salt to the batter. Beat with a mixer on medium speed for 2–3 minutes until smooth and homogeneous."
        }
      },
      {
        "id": "rest-batter-ayran-pancakes",
        "en": {
          "title": "Rest the batter",
          "description": "Cover the bowl with a clean cloth and let the batter rest in a warm place for 30 minutes. This allows the gluten to relax and the bubbles to form."
        }
      },
      {
        "id": "heat-pan-and-grease-ayran-pancakes",
        "en": {
          "title": "Heat and grease the pan",
          "description": "Place a frying pan over medium heat. Add a small amount of butter and let it melt, coating the pan evenly."
        }
      },
      {
        "id": "cook-pancakes-ayran-pancakes",
        "en": {
          "title": "Cook the pancakes",
          "description": "Pour about half a ladle of batter into the pan, spreading it into a thin layer. Cook for 1–2 minutes until the surface is set and bubbly. Flip and cook the other side for another 1–2 minutes. Transfer to a plate. Repeat with the remaining batter, greasing the pan with butter as needed."
        }
      }
    ],
