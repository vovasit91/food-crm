    "newCookingSteps": [
      {
        "id": "combine-brine-ingredients-baked-chicken-with-apples",
        "en": {
          "title": "Combine brine ingredients",
          "description": "Pour 2 liters of water and 4 cups of apple cider into a large pot. Add salt (reserving ½ tsp), brown sugar, and black peppercorns. Tie 2-3 sprigs of thyme with kitchen twine and add to the pot."
        }
      },
      {
        "id": "heat-brine-baked-chicken-with-apples",
        "en": {
          "title": "Heat the brine",
          "description": "Place the pot over medium heat and stir until the salt and sugar are fully dissolved, about 3-4 minutes. Do not let it boil."
        }
      },
      {
        "id": "cool-brine-and-submerge-chicken-baked-chicken-with-apples",
        "en": {
          "title": "Cool brine and submerge chicken",
          "description": "Pour 1 liter of cold water into a deep bowl, then pour the hot brine into it. Stir to cool to room temperature. Place the chicken breast-side down into the brine, pressing to fully submerge."
        }
      },
      {
        "id": "refrigerate-chicken-in-brine-baked-chicken-with-apples",
        "en": {
          "title": "Refrigerate chicken in brine",
          "description": "Cover the bowl and transfer to the refrigerator. Let the chicken marinate for 12 to 16 hours."
        }
      },
      {
        "id": "remove-and-pat-dry-chicken-baked-chicken-with-apples",
        "en": {
          "title": "Remove and pat dry chicken",
          "description": "Remove the chicken from the brine. Pat it dry thoroughly with paper towels. This helps the skin crisp later."
        }
      },
      {
        "id": "dry-chicken-at-room-temperature-baked-chicken-with-apples",
        "en": {
          "title": "Dry chicken at room temperature",
          "description": "Place the chicken on a wire rack breast-side up and let it dry at room temperature for 1 hour. This allows the skin to dry out, ensuring a crispy roast."
        }
      },
      {
        "id": "soften-butter-baked-chicken-with-apples",
        "en": {
          "title": "Let butter soften",
          "description": "Take the butter out of the refrigerator and let it sit at room temperature for 20-30 minutes until softened."
        }
      },
      {
        "id": "make-herb-butter-baked-chicken-with-apples",
        "en": {
          "title": "Make herb butter",
          "description": "In a small bowl, combine 3 tablespoons of the softened butter with finely chopped thyme and sage. Grate the zest of half an orange over the bowl. Add ½ teaspoon of salt and ground black pepper. Mix well. Set aside 1 tablespoon of this mixture for the glaze."
        }
      },
      {
        "id": "preheat-oven-baked-chicken-with-apples",
        "en": {
          "title": "Preheat oven to 180°C",
          "description": "Turn on the oven and preheat it to 180°C (350°F). This usually takes about 15 minutes."
        }
      },
      {
        "id": "prepare-aromatics-baked-chicken-with-apples",
        "en": {
          "title": "Prepare aromatics",
          "description": "Slice the onion into thick rings. Cut the orange in half; reserve one half and cut the other half into quarters. Tie 2-3 sprigs of thyme and 1 sprig of sage together with kitchen twine."
        }
      },
      {
        "id": "arrange-aromatics-in-tray-baked-chicken-with-apples",
        "en": {
          "title": "Arrange aromatics in baking tray",
          "description": "Pour olive oil and 1 cup of apple cider into a deep baking tray. Add the sliced onion, orange quarters, whole garlic cloves, and the tied herb bundle."
        }
      },
      {
        "id": "prepare-chicken-for-roasting-baked-chicken-with-apples",
        "en": {
          "title": "Prepare chicken for roasting",
          "description": "Place the wire rack with the dried chicken on top of the tray. Stuff the cavity with the reserved orange half and remaining thyme. Brush the chicken all over with the herb butter. Tuck the wing tips under the back and tie the legs together with kitchen twine."
        }
      },
      {
        "id": "first-roast-chicken-baked-chicken-with-apples",
        "en": {
          "title": "Roast chicken for 1 hour",
          "description": "Place the tray in the preheated oven and roast the chicken for 1 hour. The herbs and aromatics will infuse the meat with flavor."
        }
      },
      {
        "id": "prepare-apples-and-melt-butter-baked-chicken-with-apples",
        "en": {
          "title": "Prepare apples and melt butter",
          "description": "Halve the apples without removing the cores. Heat 1 tablespoon of butter in a microwave or small saucepan until melted."
        }
      },
      {
        "id": "arrange-apples-on-tray-baked-chicken-with-apples",
        "en": {
          "title": "Arrange apples around chicken",
          "description": "Remove the chicken from the oven. Arrange the apple halves cut-side up around the chicken on the rack. Brush the apples with the melted butter."
        }
      },
      {
        "id": "second-roast-with-apples-baked-chicken-with-apples",
        "en": {
          "title": "Roast chicken with apples",
          "description": "Return the tray to the oven and roast for another 30-40 minutes, until the apples are tender and the chicken is golden."
        }
      },
      {
        "id": "make-glaze-baked-chicken-with-apples",
        "en": {
          "title": "Make maple-cider glaze",
          "description": "In a small saucepan, bring 1½ cups of apple cider to a boil over medium heat. Cook until reduced by half. Whisk in maple syrup and the reserved herb butter. Boil for 1-2 minutes until thickened, then remove from heat."
        }
      },
      {
        "id": "first-glaze-and-roast-baked-chicken-with-apples",
        "en": {
          "title": "First glaze and roast",
          "description": "Brush half of the glaze over the chicken. Return to the oven and roast for 10 minutes."
        }
      },
      {
        "id": "second-glaze-and-final-roast-baked-chicken-with-apples",
        "en": {
          "title": "Second glaze and final roast",
          "description": "Brush the remaining glaze over the chicken. Roast for another 10-15 minutes until the chicken is cooked through and the skin is caramelized."
        }
      },
      {
        "id": "plate-chicken-and-apples-baked-chicken-with-apples",
        "en": {
          "title": "Plate chicken and apples",
          "description": "Transfer the roasted chicken and apples to a serving platter. Let rest for a few minutes before carving."
        }
      },
      {
        "id": "make-gravy-baked-chicken-with-apples",
        "en": {
          "title": "Make gravy from pan drippings",
          "description": "Collect the drippings and fat from the baking tray into a skillet. Heat over medium heat and whisk in flour until smooth. Gradually pour in 1 cup of water, stirring constantly. Bring to a boil and cook 1-2 minutes until thickened. Serve in a sauceboat."
        }
      }
    ],
