    "newCookingSteps": [
      {
        "id": "mix-batter-chickpea-frittata",
        "en": {
          "title": "Mix the batter",
          "description": "In a bowl, combine chickpea flour, turmeric, cumin, salt, and black pepper. Pour in water, stir well, and let the mixture sit for 15–20 minutes."
        }
      },
      {
        "id": "chop-vegetables-chickpea-frittata",
        "en": {
          "title": "Chop the vegetables",
          "description": "Cut the tomato into semicircular slices about 4–5 mm thick. Separate parsley leaves from stems and chop them coarsely."
        }
      },
      {
        "id": "saute-vegetables-chickpea-frittata",
        "en": {
          "title": "Sauté the vegetables",
          "description": "Heat olive oil in a skillet over medium heat. Cook the green beans, stirring, for about 2–3 minutes. Add the tomato slices and cook together, stirring occasionally, for another 2–3 minutes until the vegetables are partially tender."
        }
      },
      {
        "id": "cook-frittata-chickpea-frittata",
        "en": {
          "title": "Cook the frittata",
          "description": "Pour the chickpea batter into the skillet over the vegetables. Sprinkle the chopped parsley evenly on top. Cook for 2–3 minutes until the surface becomes matte. Flip the frittata and cook for another 2–3 minutes."
        }
      }
    ],
