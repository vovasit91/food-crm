    "newCookingSteps": [
      {
        "id": "grind-oats-air-fryer-pizza",
        "en": {
          "title": "Grind oats into flour",
          "description": "Pour the rolled oats into a blender and grind until they become a fine flour."
        }
      },
      {
        "id": "blend-dough-air-fryer-pizza",
        "en": {
          "title": "Blend dough until smooth",
          "description": "Add the tvorog, egg, and salt to the oat flour. Blend again until the mixture is smooth and sticky, similar to pancake batter."
        }
      },
      {
        "id": "cut-chicken-air-fryer-pizza",
        "en": {
          "title": "Cut and season the chicken",
          "description": "Dice the chicken breast into small cubes. Season with salt and pepper, then mix well."
        }
      },
      {
        "id": "slice-vegetables-air-fryer-pizza",
        "en": {
          "title": "Slice the vegetables",
          "description": "Cut the bell pepper into thin strips, the red onion into half-rings, and slice the mushrooms thinly."
        }
      },
      {
        "id": "spread-dough-air-fryer-pizza",
        "en": {
          "title": "Spread the dough on parchment",
          "description": "Place the sticky dough on a sheet of parchment paper and spread it into a thin, even circle."
        }
      },
      {
        "id": "add-toppings-air-fryer-pizza",
        "en": {
          "title": "Add ketchup and toppings",
          "description": "Spread a layer of ketchup over the dough. Arrange the chicken, mushrooms, bell pepper, onion, and whole cherry tomatoes on top."
        }
      },
      {
        "id": "add-mozzarella-air-fryer-pizza",
        "en": {
          "title": "Add mozzarella slices",
          "description": "Slice the mozzarella and distribute the slices evenly over the toppings."
        }
      },
      {
        "id": "bake-air-fryer-pizza",
        "en": {
          "title": "Bake in the air fryer",
          "description": "Place the parchment with the pizza into the air fryer basket. Bake at 150°C for 20 minutes until the crust is golden and the cheese is melted."
        }
      }
    ],
