    "newCookingSteps": [
      {
        "id": "peel-and-dice-apples-healthy-chocolate-dessert",
        "en": {
          "title": "Peel and dice apples",
          "description": "Peel the apples, remove the cores, and cut the flesh into small cubes."
        }
      },
      {
        "id": "cook-apples-with-water-healthy-chocolate-dessert",
        "en": {
          "title": "Cook apples with water",
          "description": "Place the apple cubes in a preheated dry frying pan, add the water, and simmer over medium heat, stirring, until the apples are soft."
        }
      },
      {
        "id": "transfer-apples-to-blender-healthy-chocolate-dessert",
        "en": {
          "title": "Transfer apples to blender",
          "description": "Transfer the cooked apples to a blender bowl, then add the sugar and cocoa powder."
        }
      },
      {
        "id": "blend-with-tvorog-and-yogurt-healthy-chocolate-dessert",
        "en": {
          "title": "Blend with tvorog and yogurt",
          "description": "Add the tvorog and Greek yogurt to the blender. Blend until the mixture is smooth and homogeneous."
        }
      },
      {
        "id": "melt-chocolate-in-microwave-healthy-chocolate-dessert",
        "en": {
          "title": "Melt chocolate in microwave",
          "description": "Break the dark chocolate into small pieces. Melt it in the microwave in 10-second bursts, stirring between each burst, until fully melted and smooth."
        }
      },
      {
        "id": "combine-chocolate-and-blend-healthy-chocolate-dessert",
        "en": {
          "title": "Combine chocolate and blend",
          "description": "Pour the melted chocolate into the apple-tvorog mixture, add a pinch of salt, and blend again until everything is well combined."
        }
      },
      {
        "id": "portion-and-chill-healthy-chocolate-dessert",
        "en": {
          "title": "Portion and chill",
          "description": "Divide the mixture into serving glasses or bowls. Refrigerate for 2–3 hours until set and chilled."
        }
      },
      {
        "id": "sprinkle-with-cocoa-healthy-chocolate-dessert",
        "en": {
          "title": "Sprinkle with cocoa",
          "description": "Once the dessert is fully chilled, sprinkle a generous layer of cocoa powder on top before serving."
        }
      }
    ],
