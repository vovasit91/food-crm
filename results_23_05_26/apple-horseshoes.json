    "newCookingSteps": [
      {
        "id": "slice-and-core-apples-apple-horseshoes",
        "en": {
          "title": "Slice and core the apples",
          "description": "Slice the apples into circles about 1 cm thick. Remove the cores from each slice, then cut them in half to create small horseshoe shapes."
        }
      },
      {
        "id": "roll-and-cut-dough-apple-horseshoes",
        "en": {
          "title": "Roll and cut the dough",
          "description": "Dust your work surface with flour. Roll out the puff pastry sheet to a thickness of 5 mm. Then cut the dough into strips about 1 cm wide."
        }
      },
      {
        "id": "wrap-apple-slices-apple-horseshoes",
        "en": {
          "title": "Wrap the apple slices with dough",
          "description": "Take each apple half and wrap it with a strip of dough, overlapping the turns slightly so that each turn partially covers the previous one."
        }
      },
      {
        "id": "apply-egg-wash-and-cinnamon-sugar-apple-horseshoes",
        "en": {
          "title": "Apply egg wash and cinnamon sugar",
          "description": "Crack an egg into a clean bowl and beat lightly with a fork. In another bowl, mix the sugar and cinnamon. Brush the wrapped apple pastries with the egg mixture and sprinkle them with the cinnamon sugar."
        }
      },
      {
        "id": "transfer-to-baking-sheet-apple-horseshoes",
        "en": {
          "title": "Transfer to baking sheet",
          "description": "Place the prepared pastries onto a baking sheet lined with parchment paper if desired."
        }
      },
      {
        "id": "bake-pastries-apple-horseshoes",
        "en": {
          "title": "Bake the pastries",
          "description": "Bake in a preheated oven at 180°C (350°F) for 15-20 minutes until golden brown and crispy."
        }
      },
      {
        "id": "cool-pastries-apple-horseshoes",
        "en": {
          "title": "Cool the pastries",
          "description": "Remove the pastries from the oven and let them cool on a wire rack for 10 minutes before serving."
        }
      }
