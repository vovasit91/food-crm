    "newCookingSteps": [
      {
        "id": "poach-trout-trout-rillette-with-olives",
        "en": {
          "title": "Poach the trout",
          "description": "Place the whole trout fillet in a saucepan and pour in the white wine. Set over medium heat and bring to a boil. Reduce heat to low, cover, and simmer for 5–7 minutes until the fish is cooked through."
        }
      },
      {
        "id": "shred-trout-trout-rillette-with-olives",
        "en": {
          "title": "Shred the trout",
          "description": "Transfer the poached trout to a plate and remove the skin. Use a fork to break the flesh into small flakes."
        }
      },
      {
        "id": "chop-olives-trout-rillette-with-olives",
        "en": {
          "title": "Chop the olives",
          "description": "Roughly chop the olives into rings."
        }
      },
      {
        "id": "melt-butter-trout-rillette-with-olives",
        "en": {
          "title": "Melt the butter",
          "description": "Place the butter in a microwave-safe bowl. Melt it in 2–3 intervals of 30–40 seconds each, then let it cool slightly."
        }
      },
      {
        "id": "saute-zest-trout-rillette-with-olives",
        "en": {
          "title": "Sauté the orange zest",
          "description": "Heat olive oil in a skillet over medium heat. Add the orange zest and sauté for about 1 minute until fragrant."
        }
      },
      {
        "id": "combine-ingredients-trout-rillette-with-olives",
        "en": {
          "title": "Combine all ingredients",
          "description": "In a large bowl, mix together the shredded trout, chopped olives, and sautéed orange zest. Pour in the melted butter, add salt and pepper, and stir until well combined."
        }
      },
      {
        "id": "chill-rillette-trout-rillette-with-olives",
        "en": {
          "title": "Chill the rillette",
          "description": "Transfer the mixture to a container or small bowl. Cover with plastic wrap and refrigerate for at least 1 hour before serving."
        }
      }
    ],
