    "newCookingSteps": [
      {
        "id": "prepare-lemons-lemon-souffle",
        "en": {
          "title": "Prepare the lemons",
          "description": "Finely grate the zest of the lemons. Cut one lemon in half, remove any seeds, and squeeze out 2 tablespoons of juice."
        }
      },
      {
        "id": "separate-and-beat-yolks-lemon-souffle",
        "en": {
          "title": "Separate eggs and beat yolks",
          "description": "Separate the egg whites from the yolks into two bowls. Add half of the sugar to the yolks and beat with a mixer until the mixture becomes pale and thick."
        }
      },
      {
        "id": "add-dry-and-milk-lemon-souffle",
        "en": {
          "title": "Add dry ingredients and milk",
          "description": "Sift in the flour and cornstarch, then pour in the milk and lemon juice. Mix on low speed until smooth and no lumps remain."
        }
      },
      {
        "id": "beat-egg-whites-lemon-souffle",
        "en": {
          "title": "Beat the egg whites",
          "description": "Start beating the egg whites at low speed, gradually increasing to high. When the whites become frothy and increase in volume, add the remaining sugar. Continue beating until stiff peaks form — the mixture should hold its shape and not fall when you turn the bowl upside down."
        }
      },
      {
        "id": "fold-egg-whites-lemon-souffle",
        "en": {
          "title": "Fold the egg whites into the batter",
          "description": "Gently transfer the beaten egg whites to the yolk mixture. Fold them in using a spatula, moving in one direction and lifting the batter from the bottom to the center, until just combined."
        }
      },
      {
        "id": "butter-and-fill-molds-lemon-souffle",
        "en": {
          "title": "Butter and fill the molds",
          "description": "Grease individual ramekins or molds with butter. Fill them with the airy soufflé mixture."
        }
      },
      {
        "id": "bake-souffle-lemon-souffle",
        "en": {
          "title": "Bake the soufflé",
          "description": "Preheat the oven to 150°C. Bake the soufflés for 30 minutes until they are puffed and golden brown on top. Serve immediately."
        }
      }
    ],
