    "newCookingSteps": [
      {
        "id": "grate-cheese-baked-eggs-bread-cheese",
        "en": {
          "title": "Grate the mozzarella",
          "description": "Take the mozzarella and grate it on a coarse grater. Set the cheese aside."
        }
      },
      {
        "id": "grease-dish-baked-eggs-bread-cheese",
        "en": {
          "title": "Grease the baking dish",
          "description": "Lightly grease a baking dish with vegetable oil. You can use a brush or a paper towel to spread the oil evenly."
        }
      },
      {
        "id": "place-bread-baked-eggs-bread-cheese",
        "en": {
          "title": "Place the bread slices",
          "description": "Arrange the bread slices in the bottom of the greased dish. If they are too large, trim them to fit snugly."
        }
      },
      {
        "id": "sprinkle-half-cheese-baked-eggs-bread-cheese",
        "en": {
          "title": "Sprinkle half the cheese",
          "description": "Sprinkle half of the grated mozzarella evenly over the bread slices."
        }
      },
      {
        "id": "crack-eggs-baked-eggs-bread-cheese",
        "en": {
          "title": "Crack the eggs on top",
          "description": "Carefully crack the eggs directly onto the cheese layer, trying not to break the yolks. Spread them so they cover the bread."
        }
      },
      {
        "id": "season-eggs-baked-eggs-bread-cheese",
        "en": {
          "title": "Season the eggs",
          "description": "Sprinkle salt and freshly ground black pepper over the eggs to taste."
        }
      },
      {
        "id": "sprinkle-remaining-cheese-baked-eggs-bread-cheese",
        "en": {
          "title": "Top with remaining cheese",
          "description": "Sprinkle the rest of the grated mozzarella over the eggs."
        }
      },
      {
        "id": "bake-casserole-baked-eggs-bread-cheese",
        "en": {
          "title": "Bake the casserole",
          "description": "Place the dish in an oven preheated to 180°C (350°F). Bake for 15–20 minutes, until the eggs are set and the cheese is melted and lightly golden."
        }
      }
    ],
