        "en": {
          "title": "Grate and squeeze zucchini",
          "description": "Coarsely grate the zucchini. Wrap it in cheesecloth or a clean kitchen towel and squeeze out excess moisture thoroughly."
        }
      },
      {
        "id": "mix-batter-zucchini-waffles-with-sausages",
        "en": {
          "title": "Mix the batter",
          "description": "In a bowl, combine the squeezed zucchini with eggs and rice flour. Add baking powder, salt, and black pepper. Mix until well combined."
        }
      },
      {
        "id": "cook-waffles-zucchini-waffles-with-sausages",
        "en": {
          "title": "Cook the waffles",
          "description": "Preheat your waffle iron. Lightly grease the surface with 1 teaspoon of vegetable oil. Pour the batter and cook for 3-4 minutes until golden and cooked through."
        }
      },
      {
        "id": "make-salad-zucchini-waffles-with-sausages",
        "en": {
          "title": "Make the salad",
          "description": "Dice the tomatoes and chop the basil. Dress with olive oil and vinegar, add salt to taste, and toss to combine."
        }
      },
      {
        "id": "fry-sausages-zucchini-waffles-with-sausages",
        "en": {
          "title": "Fry the sausages",
          "description": "Slice the sausages into rounds. Heat 1 teaspoon of vegetable oil in a frying pan over medium heat. Fry the sausage slices for 3-4 minutes until golden brown."
        }
      }
