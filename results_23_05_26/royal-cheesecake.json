    "newCookingSteps": [
      {
        "id": "melt-butter-mix-cocoa-royal-cheesecake",
        "en": {
          "title": "Melt butter and mix with cocoa",
          "description": "Place the butter in a microwave-safe bowl and melt it in the microwave or on the stove. Add the cocoa powder and stir until well combined."
        }
      },
      {
        "id": "mix-and-knead-dough-royal-cheesecake",
        "en": {
          "title": "Make the chocolate dough",
          "description": "In a separate bowl, whisk together the flour, sugar, and baking powder. Add the sour cream and the melted butter-cocoa mixture. Knead until a soft, uniform dough forms. Cover with a towel and set aside."
        }
      },
      {
        "id": "blend-filling-royal-cheesecake",
        "en": {
          "title": "Blend the curd filling",
          "description": "In a blender, combine the tvorog, eggs, cornstarch, and boiled condensed milk. Blend until smooth and homogeneous."
        }
      },
      {
        "id": "press-dough-into-dish-royal-cheesecake",
        "en": {
          "title": "Divide and press dough into dish",
          "description": "Cut off about one-third of the dough for the topping. Press the remaining dough into a baking dish, forming sides about 3 cm high."
        }
      },
      {
        "id": "spread-filling-royal-cheesecake",
        "en": {
          "title": "Spread the filling",
          "description": "Pour the curd filling over the dough base and spread evenly."
        }
      },
      {
        "id": "grate-dough-topping-royal-cheesecake",
        "en": {
          "title": "Grate dough topping",
          "description": "Grate the reserved piece of dough over the filling to create a decorative top."
        }
      },
      {
        "id": "bake-cheesecake-royal-cheesecake",
        "en": {
          "title": "Bake the cheesecake",
          "description": "Preheat the oven to 180°C. Bake the cheesecake for 40–45 minutes, until set and lightly golden. If the top browns too quickly, move the pan to a lower rack or cover with foil."
        }
      },
      {
        "id": "cool-cheesecake-royal-cheesecake",
        "en": {
          "title": "Cool the cheesecake",
          "description": "Remove the cheesecake from the oven and let it cool completely in the pan before serving."
        }
      }
    ],
