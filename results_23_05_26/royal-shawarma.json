    "newCookingSteps": [
      {
        "id": "season-chicken-royal-shawarma",
        "en": {
          "title": "Season the chicken",
          "description": "Pat the chicken breast dry with paper towels. Sprinkle with salt, khmeli-suneli, black pepper, and paprika. Rub the spices into the meat with your fingers, then drizzle with 2 tablespoons of vegetable oil."
        }
      },
      {
        "id": "fry-chicken-royal-shawarma",
        "en": {
          "title": "Fry the chicken",
          "description": "Heat a well-oiled skillet over high heat. Place the seasoned chicken in the pan and cook for 3–4 minutes per side until golden and cooked through. Transfer to a plate."
        }
      },
      {
        "id": "cut-chicken-royal-shawarma",
        "en": {
          "title": "Cut the chicken into cubes",
          "description": "Let the chicken cool slightly, then cut it into small bite-sized cubes."
        }
      },
      {
        "id": "make-sauce-royal-shawarma",
        "en": {
          "title": "Make the sauce",
          "description": "In a bowl, mix together sour cream and mayonnaise. Finely grate the hard cheese and add it to the mixture. Press or mince the garlic cloves, chop the fresh herbs, and add them along with the remaining salt and khmeli-suneli. Stir everything thoroughly."
        }
      },
      {
        "id": "cut-vegetables-royal-shawarma",
        "en": {
          "title": "Cut the vegetables",
          "description": "Slice the cucumber into thin strips and dice the tomato into small cubes."
        }
      },
      {
        "id": "layer-ingredients-royal-shawarma",
        "en": {
          "title": "Layer the ingredients on the lavash",
          "description": "Lay the thin lavash flat on your work surface. Place lettuce leaves along one edge, then top with the cubed chicken. Pour the prepared sauce over the chicken, and spread the cucumber strips, tomato cubes, and Korean-style carrots on top."
        }
      },
      {
        "id": "roll-and-bread-shawarma-royal-shawarma",
        "en": {
          "title": "Roll and bread the shawarma",
          "description": "Fold the bottom and top edges of the lavash over the filling to prevent spillage. Roll it up tightly into a compact cylinder. Beat the egg in a shallow bowl, and pour breadcrumbs onto a plate. Dip the rolled shawarma in the egg, coating all sides, then roll it in the breadcrumbs to cover evenly."
        }
      },
      {
        "id": "fry-shawarma-royal-shawarma",
        "en": {
          "title": "Fry the shawarma until golden",
          "description": "Heat 2 tablespoons of vegetable oil in a skillet over medium heat. Place the breaded shawarma in the pan and fry, turning occasionally, until the crust is golden and crispy, about 4 minutes."
        }
      }
    ],
