      },
      {
        "id": "dice-vegetables-hot-cheese-toasts",
        "en": {
          "title": "Dice the vegetables",
          "description": "Finely dice the tomato, red onion, and pickled jalapeño. Press the garlic clove through a press. Set aside."
        }
      },
      {
        "id": "mix-filling-hot-cheese-toasts",
        "en": {
          "title": "Mix the cheese filling",
          "description": "In a bowl, combine the grated hard cheese and cream cheese. Add the diced vegetables and pressed garlic. Season with salt and black pepper, then mix until homogeneous."
        }
      },
      {
        "id": "top-toasts-hot-cheese-toasts",
        "en": {
          "title": "Top the toasts",
          "description": "Spoon 2-3 tablespoons of the cheese mixture onto each toast slice. Spread evenly over the surface."
        }
      },
      {
        "id": "bake-toasts-hot-cheese-toasts",
        "en": {
          "title": "Bake the toasts",
          "description": "Place the baking sheet in the preheated oven. Bake for 10-12 minutes, until the bread edges are golden and the cheese is melted and bubbly."
        }
      }
