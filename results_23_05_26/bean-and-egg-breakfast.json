    "newCookingSteps": [
      {
        "id": "marinate-onion-bean-and-egg-breakfast",
        "en": {
          "title": "Marinate the onion in lime juice",
          "description": "Squeeze the lime juice and slice half of the red onion into half rings. Place the onion in a bowl and pour the lime juice over it. Let it marinate for 10–15 minutes."
        }
      },
      {
        "id": "saute-onion-garlic-bean-and-egg-breakfast",
        "en": {
          "title": "Sauté onion and garlic",
          "description": "Finely dice the remaining onion and the garlic. Heat olive oil in a skillet over medium heat and sauté the onion and garlic until golden, about 5–7 minutes."
        }
      },
      {
        "id": "add-tomato-paste-barbecue-bean-and-egg-breakfast",
        "en": {
          "title": "Add tomato paste and barbecue sauce",
          "description": "Stir in the tomato paste and barbecue sauce, and cook for 2 minutes while stirring."
        }
      },
      {
        "id": "add-sugar-bean-and-egg-breakfast",
        "en": {
          "title": "Add sugar",
          "description": "Sprinkle in the sugar and cook for 1 more minute, stirring to combine."
        }
      },
      {
        "id": "cook-beans-bean-and-egg-breakfast",
        "en": {
          "title": "Cook the beans",
          "description": "Add the canned white beans along with their liquid. Stir, bring to a boil, then cook over medium heat for 2 minutes until the sauce thickens to a consistency similar to Bolognese sauce."
        }
      },
      {
        "id": "cook-eggs-bean-and-egg-breakfast",
        "en": {
          "title": "Cook the eggs in the beans",
          "description": "Crack the eggs directly into the bean mixture. Cover the skillet and cook for 5 minutes, or until the eggs are set to your liking."
        }
      }
    ],
