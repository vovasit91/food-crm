    "newCookingSteps": [
      {
        "id": "beat-eggs-striped-pancakes",
        "en": {
          "title": "Beat eggs with sugar",
          "description": "In a bowl, beat the eggs and sugar together until the mixture becomes light and fluffy."
        }
      },
      {
        "id": "add-liquid-ingredients-striped-pancakes",
        "en": {
          "title": "Add salt, milk, and boiling water",
          "description": "Add a pinch of salt to the egg mixture, then pour in the milk. Continue beating while gradually adding boiling water."
        }
      },
      {
        "id": "incorporate-flour-and-oil-striped-pancakes",
        "en": {
          "title": "Incorporate flour and oil",
          "description": "Sift the flour into the batter in small portions, stirring constantly until smooth. Pour in the vegetable oil and mix again."
        }
      },
      {
        "id": "let-batter-rest-striped-pancakes",
        "en": {
          "title": "Let batter rest",
          "description": "Cover the bowl with a towel and allow the batter to rest for 7–10 minutes. This allows the gluten to relax and ensures tender pancakes."
        }
      },
      {
        "id": "prepare-chocolate-batter-striped-pancakes",
        "en": {
          "title": "Prepare chocolate batter",
          "description": "Pour about two ladles of the plain batter into a separate bowl. Add the cocoa powder and stir until fully combined. Transfer the chocolate batter into a pastry syringe or a squeeze bottle with a narrow tip."
        }
      },
      {
        "id": "cook-pancake-with-chocolate-spiral-striped-pancakes",
        "en": {
          "title": "Cook pancakes with chocolate spiral",
          "description": "Heat a non-stick frying pan over medium heat and lightly grease with oil. Pour a thin layer of plain batter into the pan, tilting to spread evenly. Immediately draw a spiral of chocolate batter starting from the center. Cook until the bottom is golden, then flip and cook the other side. Repeat with the remaining batter."
        }
      }
    ],
