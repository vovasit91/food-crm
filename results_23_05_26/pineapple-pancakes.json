    "newCookingSteps": [
      {
        "id": "prepare-batter-pineapple-pancakes",
        "en": {
          "title": "Prepare the batter",
          "description": "In a bowl, mix the protein pancake mix with water (or milk) according to package instructions. Add 2 tablespoons of agave syrup and pineapple juice, then stir until smooth."
        }
      },
      {
        "id": "rest-batter-pineapple-pancakes",
        "en": {
          "title": "Let the batter rest",
          "description": "Allow the batter to rest for 10 minutes. This helps the flavors meld and the texture improve."
        }
      },
      {
        "id": "cut-pineapple-pineapple-pancakes",
        "en": {
          "title": "Cut the pineapple into rings",
          "description": "Slice the pineapple into rings about 1 cm thick. Remove the core from each ring."
        }
      },
      {
        "id": "caramelize-pineapple-pineapple-pancakes",
        "en": {
          "title": "Caramelize the pineapple rings",
          "description": "Pour the remaining agave syrup into a hot frying pan. Add the pineapple rings and cook for 2 minutes on each side until they are golden and caramelized."
        }
      },
      {
        "id": "assemble-pancakes-pineapple-pancakes",
        "en": {
          "title": "Assemble the pancakes",
          "description": "Place a cocktail cherry in the center of each caramelized pineapple ring. Carefully pour the batter over each ring, filling it completely."
        }
      },
      {
        "id": "fry-pancakes-pineapple-pancakes",
        "en": {
          "title": "Fry the pancakes",
          "description": "Cook the pancakes over medium heat for about 3 minutes until bubbles form on the surface. Flip them and cook for another 2-3 minutes until the other side is golden brown. Serve hot."
        }
      }
    ],
