    "newCookingSteps": [
      {
        "id": "chop-vegetables-shakshuka-with-bacon",
        "en": {
          "title": "Chop the vegetables and bacon",
          "description": "Finely dice the tomatoes and bell pepper. Mince the onion and garlic. Chop the streaky bacon into small pieces."
        }
      },
      {
        "id": "fry-bacon-shakshuka-with-bacon",
        "en": {
          "title": "Fry the bacon",
          "description": "Heat a frying pan over high heat. Add the bacon and fry for 2-3 minutes until the fat renders and the bacon is crispy. Transfer the bacon to a plate lined with paper towels."
        }
      },
      {
        "id": "toast-spices-shakshuka-with-bacon",
        "en": {
          "title": "Toast the spices",
          "description": "Reduce the heat to medium. Add the paprika and cumin to the pan and stir for about 30 seconds until fragrant."
        }
      },
      {
        "id": "saute-onion-shakshuka-with-bacon",
        "en": {
          "title": "Sauté the onion",
          "description": "Add the chopped onion to the pan and cook for 3 minutes, stirring occasionally, until softened."
        }
      },
      {
        "id": "saute-garlic-shakshuka-with-bacon",
        "en": {
          "title": "Sauté the garlic",
          "description": "Add the minced garlic to the pan and cook for 1 minute until fragrant, being careful not to burn it."
        }
      },
      {
        "id": "saute-bell-pepper-shakshuka-with-bacon",
        "en": {
          "title": "Sauté the bell pepper",
          "description": "Add the diced bell pepper to the pan and cook for 2 minutes, stirring frequently."
        }
      },
      {
        "id": "stew-tomatoes-shakshuka-with-bacon",
        "en": {
          "title": "Stew the tomatoes",
          "description": "Add the diced tomatoes to the pan, stir well, cover, and let simmer for 7 minutes until the tomatoes are soft. Season with salt and black pepper to taste."
        }
      },
      {
        "id": "add-bacon-and-eggs-shakshuka-with-bacon",
        "en": {
          "title": "Add bacon and eggs",
          "description": "Return the cooked bacon to the pan and stir to combine. Make three indentations in the mixture and crack an egg into each well."
        }
      },
      {
        "id": "cook-eggs-shakshuka-with-bacon",
        "en": {
          "title": "Cook the eggs",
          "description": "Cover the pan, ensure the heat is low, and cook for about 5 minutes until the egg whites are set but the yolks remain runny. Be careful not to overcook the yolks."
        }
      }
    ],
