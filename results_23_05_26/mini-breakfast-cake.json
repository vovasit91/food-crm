    "newCookingSteps": [
      {
        "id": "blend-batter-mini-breakfast-cake",
        "en": {
          "title": "Blend the batter",
          "description": "Combine kefir, egg, oats, and a pinch of salt in a blender. Blend until smooth and homogeneous."
        }
      },
      {
        "id": "heat-pan-mini-breakfast-cake",
        "en": {
          "title": "Heat the pan",
          "description": "Place a non-stick frying pan over medium heat. Lightly grease with oil if needed. Let it heat thoroughly."
        }
      },
      {
        "id": "cook-first-side-mini-breakfast-cake",
        "en": {
          "title": "Cook the first side",
          "description": "Pour the oat batter into the hot pan. Cover with a lid and cook over low heat for 3–4 minutes until the bottom is golden and set."
        }
      },
      {
        "id": "cook-second-side-mini-breakfast-cake",
        "en": {
          "title": "Flip and cook the second side",
          "description": "Carefully flip the pancake. Cook for another 3–4 minutes over low heat, uncovered or covered, until golden brown on both sides."
        }
      },
      {
        "id": "cut-pancake-mini-breakfast-cake",
        "en": {
          "title": "Cut the pancake into pieces",
          "description": "Transfer the cooked pancake to a cutting board. Cut it into 4 equal wedge-shaped pieces."
        }
      },
      {
        "id": "assemble-cake-mini-breakfast-cake",
        "en": {
          "title": "Assemble the cake",
          "description": "Spread one pancake piece with sweetened soft tvorog. Top with banana slices and chopped walnuts. Place another piece on top and repeat. Continue layering until all pieces are used, finishing with a top layer."
        }
      }
