    "newCookingSteps": [
      {
        "id": "slice-croissants-croissants-with-marshmallow-and-chocolate",
        "en": {
          "title": "Slice the croissants",
          "description": "Carefully slice each croissant lengthwise without cutting all the way through, creating a pocket."
        }
      },
      {
        "id": "stuff-croissants-croissants-with-marshmallow-and-chocolate",
        "en": {
          "title": "Fill with chocolate and marshmallows",
          "description": "Place pieces of dark chocolate and mini marshmallows inside the pocket of each croissant. Don't be afraid to add plenty — the marshmallows will melt and become gooey."
        }
      },
      {
        "id": "oven-bake-croissants-croissants-with-marshmallow-and-chocolate",
        "en": {
          "title": "Bake the croissants",
          "description": "Place the filled croissants on a baking sheet and bake in a preheated oven at 190°C (375°F) for 8-10 minutes, until the filling begins to melt."
        }
      },
      {
        "id": "melt-chocolate-croissants-with-marshmallow-and-chocolate",
        "en": {
          "title": "Melt the remaining chocolate",
          "description": "While the croissants are baking, melt the remaining dark chocolate in short bursts in the microwave or over a water bath. This will be used for decoration."
        }
      },
      {
        "id": "drizzle-croissants-croissants-with-marshmallow-and-chocolate",
        "en": {
          "title": "Drizzle and top with marshmallows",
          "description": "Remove the baked croissants from the oven and let them cool slightly. Using a brush or spoon, drizzle the melted chocolate over the croissants and add extra marshmallows on top."
        }
      }
    ],
