    "newCookingSteps": [
      {
        "id": "soak-cornmeal-cornmeal-casserole",
        "en": {
          "title": "Soak the cornmeal",
          "description": "Pour 200 ml of water over the cornmeal and leave it for 4 hours. This softens the grain for faster cooking."
        }
      },
      {
        "id": "drain-and-add-water-cornmeal-casserole",
        "en": {
          "title": "Drain and add remaining water",
          "description": "Drain the soaked cornmeal, then add the remaining 100 ml of water. Place the pot on the stove."
        }
      },
      {
        "id": "boil-and-cook-cornmeal-cornmeal-casserole",
        "en": {
          "title": "Boil and cook the cornmeal",
          "description": "Bring the water to a boil, then cook the cornmeal for 15 minutes over medium heat. Stir occasionally."
        }
      },
      {
        "id": "add-milk-and-cook-cornmeal-casserole",
        "en": {
          "title": "Add milk and cook until tender",
          "description": "Pour in the milk and continue cooking the porridge until it reaches the desired consistency. Stir gently to prevent lumps."
        }
      },
      {
        "id": "remove-and-cool-cornmeal-casserole",
        "en": {
          "title": "Remove from heat and cool",
          "description": "Take the pot off the stove and let the cornmeal porridge cool down slightly."
        }
      },
      {
        "id": "grate-apple-and-carrot-cornmeal-casserole",
        "en": {
          "title": "Grate the apple and carrot",
          "description": "Peel and grate the apple and carrot on a coarse grater."
        }
      },
      {
        "id": "combine-filling-cornmeal-casserole",
        "en": {
          "title": "Combine the filling",
          "description": "In a bowl, mix the grated apple and carrot. Sprinkle with sugar and stir."
        }
      },
      {
        "id": "whisk-egg-cornmeal-casserole",
        "en": {
          "title": "Whisk the egg",
          "description": "Beat the egg in a clean bowl until frothy."
        }
      },
      {
        "id": "mix-egg-with-cornmeal-cornmeal-casserole",
        "en": {
          "title": "Mix egg into the cornmeal",
          "description": "Pour half of the beaten egg into the cooled cornmeal porridge. Add salt and vanilla. Mix well."
        }
      },
      {
        "id": "grease-dish-cornmeal-casserole",
        "en": {
          "title": "Grease the baking dish",
          "description": "Grease a baking dish with butter to prevent sticking."
        }
      },
      {
        "id": "spread-half-cornmeal-cornmeal-casserole",
        "en": {
          "title": "Spread half the cornmeal mixture",
          "description": "Spoon half of the cornmeal porridge into the dish and spread it evenly."
        }
      },
      {
        "id": "add-filling-cornmeal-casserole",
        "en": {
          "title": "Add the apple-carrot filling",
          "description": "Distribute the fruit and vegetable filling evenly over the cornmeal layer."
        }
      },
      {
        "id": "top-with-remaining-cornmeal-cornmeal-casserole",
        "en": {
          "title": "Top with remaining cornmeal",
          "description": "Cover the filling with the rest of the cornmeal porridge and drizzle the remaining beaten egg on top."
        }
      },
      {
        "id": "bake-cornmeal-casserole",
        "en": {
          "title": "Bake the casserole",
          "description": "Preheat the oven to 200°C. Bake the casserole for 15–20 minutes until the top is golden brown."
        }
      }
