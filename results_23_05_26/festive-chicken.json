    "newCookingSteps": [
      {
        "id": "prepare-marinade-festive-chicken",
        "en": {
          "title": "Prepare the marinade",
          "description": "Press the garlic cloves. In a bowl, combine the pressed garlic, sour cream, mustard, chili ketchup, ground coriander, and salt. Mix well."
        }
      },
      {
        "id": "chop-vegetables-and-mix-festive-chicken",
        "en": {
          "title": "Chop vegetables and mix with half the marinade",
          "description": "Chop the onion and bell pepper into medium-sized pieces. Place them in a bowl, add half of the prepared marinade, and stir to combine."
        }
      },
      {
        "id": "stuff-chicken-festive-chicken",
        "en": {
          "title": "Stuff the chicken",
          "description": "Fill the cavity of the chicken with the vegetable mixture. Secure the skin with toothpicks or skewers. Tie the legs together to keep the stuffing inside."
        }
      },
      {
        "id": "coat-and-refrigerate-festive-chicken",
        "en": {
          "title": "Coat the chicken and refrigerate",
          "description": "Brush the chicken all over with the remaining marinade. Place it in a roasting bag, tie the bag, and refrigerate for 1 hour to allow the flavors to meld."
        }
      },
      {
        "id": "preheat-oven-festive-chicken",
        "en": {
          "title": "Preheat the oven",
          "description": "Preheat your oven to 150°C (300°F)."
        }
      },
      {
        "id": "bake-in-bag-festive-chicken",
        "en": {
          "title": "Bake the chicken in the bag",
          "description": "Transfer the roasting bag with the chicken to a baking dish. Make 3-4 small slits in the top of the bag to allow steam to escape. Bake for 1 hour at 150°C."
        }
      },
      {
        "id": "increase-heat-bake-festive-chicken",
        "en": {
          "title": "Increase heat and bake uncovered",
          "description": "Carefully cut open the roasting bag. Increase the oven temperature to 200°C (400°F). Continue baking for another 20 minutes until the skin is golden and crispy."
        }
      }
    ],
