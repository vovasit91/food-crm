    "newCookingSteps": [
      {
        "id": "mix-egg-milk-bread-pudding-with-cheese-and-bacon",
        "en": {
          "title": "Mix eggs and milk",
          "description": "Crack the eggs into a deep bowl and pour in the milk. Add salt and pepper to taste. Whisk until smooth and homogeneous."
        }
      },
      {
        "id": "soak-bread-bread-pudding-with-cheese-and-bacon",
        "en": {
          "title": "Soak the bread",
          "description": "Cut the loaf into large cubes. Grease a baking dish with olive oil, arrange the bread, and pour the egg-milk mixture over it. Let it sit for 10 minutes so the bread absorbs the liquid."
        }
      },
      {
        "id": "prep-cheese-bacon-onion-bread-pudding-with-cheese-and-bacon",
        "en": {
          "title": "Prep cheese, bacon, and onion",
          "description": "Grate the cheese coarsely. Cut the bacon and red onion into small cubes."
        }
      },
      {
        "id": "fry-bacon-bread-pudding-with-cheese-and-bacon",
        "en": {
          "title": "Fry the bacon",
          "description": "Heat a frying pan over medium heat. Add the bacon and fry until golden brown, about 2–3 minutes. Transfer the bacon to a plate."
        }
      },
      {
        "id": "fry-onion-bread-pudding-with-cheese-and-bacon",
        "en": {
          "title": "Fry the onion",
          "description": "In the same pan with the remaining bacon fat, fry the onion until soft, about 2–3 minutes."
        }
      },
      {
        "id": "assemble-bread-pudding-with-cheese-and-bacon",
        "en": {
          "title": "Assemble the pudding",
          "description": "Transfer the fried onion and half of the bacon to the baking dish with the bread. Gently mix. Sprinkle the grated cheese on top."
        }
      },
      {
        "id": "bake-pudding-bread-pudding-with-cheese-and-bacon",
        "en": {
          "title": "Bake the pudding",
          "description": "Place the dish in an oven preheated to 180°C. Bake for 20–25 minutes until the top is golden brown and the custard is fully set."
        }
      },
      {
        "id": "rest-pudding-bread-pudding-with-cheese-and-bacon",
        "en": {
          "title": "Rest the pudding",
          "description": "Remove the pudding from the oven and let it stand for 5 minutes before serving."
        }
      }
    ],
