        "id": "boil-apples-baked-apples-with-meringue-coat",
        "en": {
          "title": "Boil the apples",
          "description": "Bring the water to a boil, then simmer for 6–7 minutes. Do not overcook."
        }
      },
      {
        "id": "drain-apples-baked-apples-with-meringue-coat",
        "en": {
          "title": "Drain the apples",
          "description": "Drain the apples in a colander and let all the moisture drip off."
        }
      },
      {
        "id": "transfer-to-baking-sheet-baked-apples-with-meringue-coat",
        "en": {
          "title": "Transfer to a baking sheet",
          "description": "Place the drained apples on a baking sheet lined with parchment paper."
        }
      },
