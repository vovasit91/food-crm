        "en": {
          "title": "Sprinkle half of the sugar and cinnamon",
          "description": "Measure half of the remaining sugar and sprinkle it over the apples. Dust with half of the cinnamon."
        }
      },
      {
        "id": "beat-egg-whites-baked-apples-with-meringue-coat",
        "en": {
          "title": "Beat the egg whites",
          "description": "Beat the egg whites with 1 tablespoon of sugar until stiff peaks form."
        }
      },
      {
        "id": "top-apples-with-meringue-baked-apples-with-meringue-coat",
        "en": {
          "title": "Top apples with meringue",
          "description": "Spoon the whipped egg whites over each apple, creating a fluffy 'hat'."
        }
      },
