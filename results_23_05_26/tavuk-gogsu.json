    "newCookingSteps": [
      {
        "id": "boil-chicken-tavuk-gogsu",
        "en": {
          "title": "Boil the chicken",
          "description": "Place the chicken breast in a pot, cover with water, bring to a boil, then reduce heat to medium and cook for 20–25 minutes until tender."
        }
      },
      {
        "id": "shred-chicken-tavuk-gogsu",
        "en": {
          "title": "Shred the chicken",
          "description": "Let the cooked chicken cool, then shred it into very fine fibers using your hands or a fork."
        }
      },
      {
        "id": "wash-and-soak-chicken-tavuk-gogsu",
        "en": {
          "title": "Wash and soak the chicken",
          "description": "Rinse the shredded chicken well, squeeze out excess liquid, then cover with cold water and let it soak for 10 minutes. Repeat this process three times, squeezing the chicken dry after each soak."
        }
      },
      {
        "id": "whisk-dry-mixture-tavuk-gogsu",
        "en": {
          "title": "Whisk dry mixture",
          "description": "In a bowl, whisk together the rice flour, cornstarch, and 100 ml of milk until smooth and lump-free."
        }
      },
      {
        "id": "heat-milk-and-add-mixture-tavuk-gogsu",
        "en": {
          "title": "Heat milk and add mixture",
          "description": "Pour the remaining milk into a small saucepan and heat over medium heat until it begins to boil. Gradually whisk in the flour mixture."
        }
      },
      {
        "id": "cook-pudding-base-tavuk-gogsu",
        "en": {
          "title": "Cook the pudding base",
          "description": "Reduce heat to low and cook the milk mixture for 5–10 minutes, stirring constantly, until it thickens into a smooth pudding."
        }
      },
      {
        "id": "combine-chicken-with-milk-tavuk-gogsu",
        "en": {
          "title": "Combine chicken with hot milk",
          "description": "Take 3–4 tablespoons of the hot milk pudding and mix it with the prepared shredded chicken."
        }
      },
      {
        "id": "mix-chicken-into-pudding-tavuk-gogsu",
        "en": {
          "title": "Mix chicken into pudding",
          "description": "Transfer the chicken mixture back into the saucepan with the remaining pudding and whisk everything together until fully incorporated."
        }
      },
      {
        "id": "add-sugar-and-cook-tavuk-gogsu",
        "en": {
          "title": "Add sugar and cook",
          "description": "Stir in the sugar and continue cooking over low heat for 1 minute, until the sugar is completely dissolved."
        }
      },
      {
        "id": "add-vanilla-tavuk-gogsu",
        "en": {
          "title": "Add vanilla",
          "description": "Remove the pan from the heat and stir in the vanilla extract until evenly distributed."
        }
      },
      {
        "id": "chill-pudding-tavuk-gogsu",
        "en": {
          "title": "Chill the pudding",
          "description": "Lightly spray a rectangular dish with water, pour the pudding into it, and refrigerate for at least 1 hour until set."
        }
      }
    ],
