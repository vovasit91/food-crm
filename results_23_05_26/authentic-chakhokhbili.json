        "en": {
          "title": "Fry the onion",
          "description": "In the same skillet, fry the onion over medium heat until golden and translucent, about 5 minutes."
        }
      },
      {
        "id": "blanch-tomatoes-authentic-chakhokhbili",
        "en": {
          "title": "Blanch the tomatoes",
          "description": "Make shallow cuts at the bottom of each tomato, then pour boiling water over them. Let sit for 2 minutes, then drain."
        }
      },
      {
        "id": "peel-and-dice-tomatoes-authentic-chakhokhbili",
        "en": {
          "title": "Peel and dice the tomatoes",
          "description": "Once cool enough to handle, peel off the skins and chop the tomatoes into small cubes."
        }
      },
      {
        "id": "simmer-tomato-sauce-authentic-chakhokhbili",
        "en": {
          "title": "Simmer the tomato sauce",
          "description": "Add the fresh diced tomatoes and canned tomatoes to the skillet with the onion. Simmer over low heat for 10 minutes, stirring occasionally."
        }
      },
      {
        "id": "add-spices-authentic-chakhokhbili",
        "en": {
          "title": "Add the spices",
          "description": "Stir in the khmeli-suneli, utskho-suneli, savory, salt, and sugar. Mix well."
        }
      },
      {
