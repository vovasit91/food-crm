      {
        "id": "combine-cherries-sugar-rice-pudding-with-cherries",
        "en": {
          "title": "Combine cherries and sugar",
          "description": "Place the frozen cherries in a saucepan and sprinkle with 1 tablespoon of sugar."
        }
      },
      {
        "id": "cook-cherry-syrup-rice-pudding-with-cherries",
        "en": {
          "title": "Cook the cherry syrup",
          "description": "Set the saucepan over medium heat and cook, stirring frequently, until the cherries release their juice and the sugar dissolves into a thick syrup, about 5-6 minutes."
        }
      },
      {
        "id": "strain-cherries-rice-pudding-with-cherries",
        "en": {
          "title": "Strain the cherries",
          "description": "Remove the saucepan from the heat. Pour the mixture through a sieve to separate the syrup from the soft cherries. Set both aside."
        }
      },
      {
        "id": "combine-rice-milk-rice-pudding-with-cherries",
        "en": {
          "title": "Combine rice and milk",
          "description": "Pour the rice into a pot and add the milk. Stir to combine."
        }
      },
      {
        "id": "simmer-rice-rice-pudding-with-cherries",
        "en": {
          "title": "Simmer the rice in milk",
          "description": "Bring the mixture to a boil over medium heat, then reduce the heat to low. Cook, stirring occasionally, until the rice is tender and the porridge is thick, about 20-25 minutes."
        }
      },
      {
        "id": "add-seasonings-rice-pudding-with-cherries",
        "en": {
          "title": "Add cream and seasonings",
          "description": "Pour in the light cream, then add the salt, remaining sugar, and vanilla sugar. Stir to combine."
        }
      },
      {
        "id": "heat-rice-pudding-rice-pudding-with-cherries",
        "en": {
          "title": "Heat the pudding",
          "description": "Warm the porridge over low heat for 1-2 minutes, stirring gently, until everything is well incorporated and heated through. Remove from heat."
        }
      }
