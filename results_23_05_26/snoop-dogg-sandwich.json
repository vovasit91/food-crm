      },
      {
        "id": "toast-bread-snoop-dogg-sandwich",
        "en": {
          "title": "Toast the bread",
          "description": "Place the buttered bread slices in a hot frying pan and toast until golden brown on both sides. Transfer to a clean plate."
        }
      },
      {
        "id": "fry-sausage-snoop-dogg-sandwich",
        "en": {
          "title": "Fry the sausage",
          "description": "In the same pan, fry the sausage slices over medium heat until golden and slightly crispy on both sides."
        }
      },
      {
        "id": "place-sausage-snoop-dogg-sandwich",
        "en": {
          "title": "Place sausage on toast",
          "description": "Arrange the fried sausage slices evenly on top of one of the toasted bread slices."
        }
      },
      {
        "id": "layer-cheese-snoop-dogg-sandwich",
        "en": {
          "title": "Layer the cheese",
          "description": "Immediately place slices of processed cheese on top of the hot sausage. Press gently and let the residual heat melt the cheese slightly."
        }
      },
      {
        "id": "add-chips-snoop-dogg-sandwich",
