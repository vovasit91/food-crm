    "newCookingSteps": [
      {
        "id": "chop-and-grate-vegetable-bread",
        "en": {
          "title": "Chop herbs and grate cheese",
          "description": "Finely chop the onion, spinach, and parsley. Grate the hard cheese on the large side of a grater."
        }
      },
      {
        "id": "grate-and-squeeze-zucchini-vegetable-bread",
        "en": {
          "title": "Grate and squeeze zucchini and carrot",
          "description": "Grate the zucchini and carrot coarsely. Wrap them in cheesecloth and squeeze out as much liquid as possible."
        }
      },
      {
        "id": "combine-ingredients-vegetable-bread",
        "en": {
          "title": "Combine dry ingredients",
          "description": "In a deep bowl, mix together the squeezed vegetables, chopped herbs, and grated cheese. Add the salt and stir to distribute."
        }
      },
      {
        "id": "add-wet-ingredients-vegetable-bread",
        "en": {
          "title": "Add oil and eggs",
          "description": "Pour in the olive oil and crack the eggs over the vegetable mixture. Stir everything thoroughly until well combined."
        }
      },
      {
        "id": "mix-and-transfer-dough-vegetable-bread",
        "en": {
          "title": "Mix in flour and transfer to pan",
          "description": "Add the almond flour and mix until a dough forms. Transfer the dough to a loaf pan, using a silicone spatula to press it evenly into the corners."
        }
      },
      {
        "id": "sprinkle-seeds-vegetable-bread",
        "en": {
          "title": "Sprinkle hemp seeds on top",
          "description": "Evenly scatter the hemp seeds over the surface of the dough."
        }
      },
      {
        "id": "bake-bread-vegetable-bread",
        "en": {
          "title": "Bake the bread",
          "description": "Place the loaf pan in an oven preheated to 170°C and bake for 40 minutes. The bread is done when a wooden skewer inserted into the center comes out clean."
        }
      },
      {
        "id": "cool-and-remove-vegetable-bread",
        "en": {
          "title": "Cool and unmold",
          "description": "Let the bread cool in the pan for at least 10 minutes, then carefully remove it from the pan. Transfer to a wire rack to cool completely before slicing."
        }
      }
    ],
