      {
        "id": "mix-eggs-milk-pp-khachapuri",
        "en": {
          "title": "Mix eggs and milk",
          "description": "In a bowl, combine the eggs and milk and whisk until smooth. Do not overbeat."
        }
      },
      {
        "id": "mash-tvorog-pp-khachapuri",
        "en": {
          "title": "Mash tvorog",
          "description": "Mash the tvorog with a fork and add to the egg-milk mixture. Mix well, breaking up any large curds."
        }
      },
      {
        "id": "add-flour-seasoning-pp-khachapuri",
        "en": {
          "title": "Add flour and seasonings",
          "description": "Add the rice flour, salt, and pepper. Mix thoroughly."
        }
      },
      {
        "id": "add-cheese-herbs-pp-khachapuri",
        "en": {
          "title": "Add cheese and herbs",
          "description": "Grate the suluguni on a fine grater and add to the batter. Chop fresh herbs and add as well."
        }
      },
      {
        "id": "cook-first-side-pp-khachapuri",
        "en": {
          "title": "Cook the first side",
          "description": "Brush the skillet with oil and pour in the batter. Spread evenly with a spatula. Cover and cook over medium heat for 5–6 minutes until golden brown."
        }
      },
      {
        "id": "flip-and-cook-second-side-pp-khachapuri",
        "en": {
          "title": "Flip and cook the other side",
          "description": "Carefully flip the flatbread and cook covered for another 5–6 minutes."
        }
      }
