        "en": {
          "title": "Beat eggs and mix with broth",
          "description": "Crack the eggs into a bowl, add salt, and lightly beat with a fork. Pour in the chicken broth and mix again."
        }
      },
      {
        "id": "strain-and-pour-japanese-steamed-omelette",
        "en": {
          "title": "Strain the mixture and pour into molds",
          "description": "Strain the egg mixture through a fine sieve into a measuring cup. Pour into a ceramic or glass mold, filling it to about two-thirds full. If the mixture is too much, divide between two molds."
        }
      },
      {
        "id": "steam-japanese-steamed-omelette",
        "en": {
          "title": "Steam the omelette",
          "description": "Place the mold in a steamer, cover with plastic wrap, and steam for 12–14 minutes until set but still jiggly in the center."
        }
      }
