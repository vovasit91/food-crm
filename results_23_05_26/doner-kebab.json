    "newCookingSteps": [
      {
        "id": "mix-marinade-doner-kebab",
        "en": {
          "title": "Mix the marinade",
          "description": "Combine 1 tablespoon of oil with the spices: black pepper, cumin, cardamom, turmeric, dried garlic, paprika, and salt. Stir well."
        }
      },
      {
        "id": "rub-chicken-doner-kebab",
        "en": {
          "title": "Rub the chicken with marinade",
          "description": "Coat the chicken fillets thoroughly with the spice mixture on all sides."
        }
      },
      {
        "id": "let-chicken-marinate-doner-kebab",
        "en": {
          "title": "Let the chicken marinate",
          "description": "Allow the chicken to marinate for at least 1 hour, or longer for deeper flavor."
        }
      },
      {
        "id": "make-sauce-doner-kebab",
        "en": {
          "title": "Make the sauce",
          "description": "Press the garlic cloves into the mayonnaise, add black pepper, salt, and coriander. Mix well."
        }
      },
      {
        "id": "heat-oil-in-pan-doner-kebab",
        "en": {
          "title": "Heat oil in a pan",
          "description": "Place a frying pan over medium heat and add 2 tablespoons of oil. Heat until shimmering."
        }
      },
      {
        "id": "fry-chicken-first-side-doner-kebab",
        "en": {
          "title": "Fry chicken first side",
          "description": "Place the marinated chicken in the hot pan and cook for 3 minutes until golden brown. Do not move the chicken."
        }
      },
      {
        "id": "flip-and-fry-second-side-doner-kebab",
        "en": {
          "title": "Flip and fry second side",
          "description": "Flip the chicken and cook for another 3 minutes until the other side is browned and the chicken is cooked through."
        }
      },
      {
        "id": "chop-vegetables-and-slice-chicken-doner-kebab",
        "en": {
          "title": "Chop vegetables and slice chicken",
          "description": "Cut the cucumbers into strips, slice the tomatoes into rounds, and slice the onion into half rings. Slice the cooked chicken into thin strips."
        }
      },
      {
        "id": "assemble-wrap-doner-kebab",
        "en": {
          "title": "Assemble the wrap",
          "description": "Lay the lavash flat. Arrange the chopped vegetables and sliced chicken on top, then drizzle with the prepared sauce."
        }
      },
      {
        "id": "roll-wrap-doner-kebab",
        "en": {
          "title": "Roll the wrap",
          "description": "Fold the lavash over the filling, tucking in the sides to form a tight roll or envelope shape."
        }
      },
      {
        "id": "fry-wrap-doner-kebab",
        "en": {
          "title": "Fry the wrap",
          "description": "Place the rolled wrap seam-side down in the pan and fry over medium heat for 2-3 minutes per side, until golden and crispy all over. Serve immediately."
        }
      }
    ],
