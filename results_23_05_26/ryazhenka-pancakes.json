        "en": {
          "title": "Combine dry and wet ingredients",
          "description": "Sift the flour into a clean bowl. Mix in the salt and baking powder. Pour the wet mixture into the dry ingredients and whisk until smooth."
        }
      },
      {
        "id": "rest-dough-first-ryazhenka-pancakes",
        "en": {
          "title": "Rest dough",
          "description": "Cover the bowl with a clean cloth and let the dough rest in a warm place for 20 minutes."
        }
      },
      {
        "id": "add-baking-soda-ryazhenka-pancakes",
        "en": {
          "title": "Add baking soda and rest again",
          "description": "Add the baking soda to the dough, stir well. Cover and let rest in a warm place for another 10 minutes."
        }
      },
      {
        "id": "heat-pan-ryazhenka-pancakes",
        "en": {
          "title": "Heat the pan",
          "description": "Brush a frying pan with a small amount of oil and heat it over medium heat until hot."
        }
      },
      {
        "id": "fry-pancakes-ryazhenka-pancakes",
        "en": {
          "title": "Fry the pancakes",
          "description": "Scoop portions of the batter onto the hot pan, forming round pancakes about 6–7 cm in diameter. Fry for 2–3 minutes per side until golden brown. Transfer cooked pancakes to a plate and repeat with remaining batter."
