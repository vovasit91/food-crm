        "en": {
          "title": "Combine wet ingredients",
          "description": "Crack the eggs into a deep bowl. Add the Italian herbs, a pinch of salt, and some black pepper, then stir. Pour in the olive oil and milk, and stir again until well combined."
        }
      },
      {
        "id": "combine-dry-and-wet-tomato-olive-loaf",
        "en": {
          "title": "Mix dry ingredients into wet",
          "description": "Add the baking powder to the flour and sift the mixture into the liquid ingredients in several additions. Mix until you have a thick batter that resembles sour cream."
        }
      },
      {
        "id": "prepare-filling-and-mix-tomato-olive-loaf",
        "en": {
          "title": "Prepare filling and mix into batter",
          "description": "Slice the olives into rings. Grate the cheese on a coarse grater and set a little aside for garnish. Roughly chop the sun‑dried tomatoes. Add all the filling to the batter and mix thoroughly."
        }
      },
      {
        "id": "bake-tomato-olive-loaf",
        "en": {
          "title": "Bake the loaf",
          "description": "Transfer the batter into a loaf pan, sprinkle with the reserved cheese, and bake in a preheated oven at 180 °C for 35 minutes."
        }
      }
