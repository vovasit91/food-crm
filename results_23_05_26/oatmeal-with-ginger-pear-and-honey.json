        "en": {
          "title": "Caramelize the pear",
          "description": "Slice the pear into thin wedges. Fry the slices in a grill pan or regular skillet over medium-high heat for 3–5 minutes, until they are lightly caramelized."
        }
      },
      {
        "id": "add-ginger-and-serve-oatmeal-with-ginger-pear-and-honey",
        "en": {
          "title": "Add ginger and serve",
          "description": "Stir the ground ginger into the cooked oatmeal. Transfer to a bowl, top with the caramelized pear slices, pumpkin seeds, and drizzle with honey."
