    "newCookingSteps": [
      {
        "id": "boil-chicken-paella-with-chicken",
        "en": {
          "title": "Boil the chicken",
          "description": "Place the chicken in a pot, cover with salted water, and bring to a boil. Simmer until fully cooked, about 30 minutes, to create a flavorful broth."
        }
      },
      {
        "id": "remove-boiled-chicken-paella-with-chicken",
        "en": {
          "title": "Remove the chicken",
          "description": "Take the cooked chicken out of the broth and set aside. If needed, remove the meat from the bones and discard bones."
        }
      },
      {
        "id": "fry-chicken-paella-with-chicken",
        "en": {
          "title": "Fry the chicken",
          "description": "In a large frying pan over medium-high heat, heat a little olive oil. Fry the boiled chicken pieces until golden brown on all sides."
        }
      },
      {
        "id": "remove-fried-chicken-paella-with-chicken",
        "en": {
          "title": "Remove the fried chicken",
          "description": "Transfer the golden chicken pieces to a separate bowl and set aside."
        }
      },
      {
        "id": "saute-vegetables-paella-with-chicken",
        "en": {
          "title": "Sauté the vegetables",
          "description": "In the same pan, add a bit more oil if needed. Sauté the diced tomatoes, bell pepper, chopped garlic, onion, and paprika for 4-5 minutes until softened. Season with salt and pepper."
        }
      },
      {
        "id": "add-rice-paella-with-chicken",
        "en": {
          "title": "Add the rice",
          "description": "Stir the rice into the vegetable mixture. Cook over medium heat for 3-5 minutes, stirring frequently, until the rice grains are lightly toasted."
        }
      },
      {
        "id": "add-broth-and-simmer-paella-with-chicken",
        "en": {
          "title": "Add broth and simmer",
          "description": "Return the chicken to the pan. Pour in the chicken broth until the rice is just covered. Bring to a boil, then reduce heat to low and simmer uncovered for 10-15 minutes, until the rice is almost tender."
        }
      },
      {
        "id": "add-wine-and-simmer-paella-with-chicken",
        "en": {
          "title": "Add wine and simmer until evaporated",
          "description": "Pour the white wine over the rice and continue to simmer until the liquid is fully absorbed and the rice is cooked through."
        }
      },
      {
        "id": "add-peas-paella-with-chicken",
        "en": {
          "title": "Add peas and serve",
          "description": "Fold in the green peas, heat for a minute, then remove from heat. Serve the paella warm, garnished with lemon wedges, parsley, or dill if desired."
        }
      }
    ],
