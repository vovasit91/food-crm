    "newCookingSteps": [
      {
        "id": "prepare-vegetables-congee-with-carrots",
        "en": {
          "title": "Prepare vegetables",
          "description": "Grate the carrot on the large side of a grater. Slice the ginger root into thin rounds, about 1–2 mm thick."
        }
      },
      {
        "id": "heat-coconut-mixture-congee-with-carrots",
        "en": {
          "title": "Heat coconut milk with vegetables and spices",
          "description": "Pour the coconut milk into a pot. Add the grated carrot, raisins, cardamom, cloves, and cinnamon. Stir well. Place the pot over medium heat, cover, and heat for 2 minutes."
        }
      },
      {
        "id": "cook-spices-add-rice-congee-with-carrots",
        "en": {
          "title": "Cook spices and add rice",
          "description": "Remove the lid and cook the mixture, stirring constantly, for 1 minute until the spices become fragrant and the coconut milk takes on an orange color from the carrot. Add the rice and stir thoroughly."
        }
      },
      {
        "id": "bring-to-boil-congee-with-carrots",
        "en": {
          "title": "Add water and bring to a boil",
          "description": "Pour water into the pot. Add the star anise and ginger slices. Stir, then bring the mixture to a boil."
        }
      },
      {
        "id": "simmer-congee-congee-with-carrots",
        "en": {
          "title": "Simmer the congee",
          "description": "Reduce the heat to low. Partially cover the pot and simmer for about 20 minutes, or until the rice is tender and the congee reaches your desired thickness."
        }
      },
      {
        "id": "remove-aromatics-congee-with-carrots",
        "en": {
          "title": "Remove aromatics and serve",
          "description": "Remove the pot from the heat. Take out the ginger slices and star anise. Serve the congee warm."
        }
      }
    ],
