    "newCookingSteps": [
      {
        "id": "prep-vegetables-bean-pate",
        "en": {
          "title": "Prepare the vegetables",
          "description": "Dice the onion into 3-4 mm cubes. Coarsely grate the carrot. Finely chop the garlic. Separate the parsley leaves from the stems."
        }
      },
      {
        "id": "saute-onion-carrot-bean-pate",
        "en": {
          "title": "Sauté onion and carrot",
          "description": "Heat the sunflower oil in a frying pan over medium heat. Fry the onion, stirring, for 1-2 minutes until lightly golden. Add the carrot and fry, stirring frequently, for another 3-4 minutes."
        }
      },
      {
        "id": "add-garlic-paprika-cool-bean-pate",
        "en": {
          "title": "Add garlic and paprika, then cool",
          "description": "Add the garlic and paprika to the pan. Cook, stirring, for 1-2 minutes. Remove the pan from the heat and let the vegetables cool slightly."
        }
      },
      {
        "id": "blend-bean-pate",
        "en": {
          "title": "Blend the pâté",
          "description": "Place the canned red beans and parsley leaves into a blender. Add the sautéed vegetables and salt. Blend on medium speed for 2-3 minutes until smooth or to your desired texture."
        }
      }
    ],
