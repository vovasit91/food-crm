    "newCookingSteps": [
      {
        "id": "separate-eggs-curd-casserole-marshmallow",
        "en": {
          "title": "Separate the eggs and chill the whites",
          "description": "Carefully separate the egg whites from the yolks. Place the whites in the refrigerator to chill — cold whites whip better."
        }
      },
      {
        "id": "whisk-yolks-milk-curd-casserole-marshmallow",
        "en": {
          "title": "Whisk the yolks with milk",
          "description": "In a small bowl, lightly whisk the egg yolks together with the milk until smooth and combined."
        }
      },
      {
        "id": "blend-curd-curd-casserole-marshmallow",
        "en": {
          "title": "Blend the curd into the yolk mixture",
          "description": "Add the cottage cheese (tvorog) to the yolk mixture and use an immersion blender to blend until completely smooth."
        }
      },
      {
        "id": "chop-pear-marshmallow-curd-casserole-marshmallow",
        "en": {
          "title": "Chop pear and marshmallow and fold in",
          "description": "Cut the pear and marshmallow into small cubes. Gently fold them into the curd mixture, taking care not to break up the marshmallow pieces."
        }
      },
      {
        "id": "grease-dish-curd-casserole-marshmallow",
        "en": {
          "title": "Grease the baking dish and transfer the mixture",
          "description": "Grease a baking dish with vegetable oil. Transfer the curd mixture into the dish and smooth the surface."
        }
      },
      {
        "id": "preheat-oven-curd-casserole-marshmallow",
        "en": {
          "title": "Preheat the oven to 170°C",
          "description": "Preheat your oven to 170°C (340°F) so it is ready for baking."
        }
      },
      {
        "id": "whip-egg-whites-curd-casserole-marshmallow",
        "en": {
          "title": "Whip the egg whites with sugar",
          "description": "Take the chilled egg whites from the refrigerator, add the powdered sugar, and whip with a mixer until stiff peaks form."
        }
      },
      {
        "id": "spread-whites-curd-casserole-marshmallow",
        "en": {
          "title": "Spread the whipped whites over the casserole",
          "description": "Gently spread the whipped egg whites evenly over the curd mixture in the dish, smoothing the top."
        }
      },
      {
        "id": "bake-curd-casserole-marshmallow",
        "en": {
          "title": "Bake for 40 minutes",
          "description": "Place the dish in the preheated oven and bake at 170°C for 40 minutes, until the top is golden and the casserole is set."
        }
      }
