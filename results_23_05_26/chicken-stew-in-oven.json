    "newCookingSteps": [
      {
        "id": "remove-meat-chicken-stew-in-oven",
        "en": {
          "title": "Remove meat from bones",
          "description": "Remove the chicken meat from the bones. You can leave some small bones. Cut off the fat and set it aside; you'll need it later."
        }
      },
      {
        "id": "season-meat-chicken-stew-in-oven",
        "en": {
          "title": "Season the meat",
          "description": "Salt and pepper the meat, add turmeric, and mix well."
        }
      },
      {
        "id": "place-spices-chicken-stew-in-oven",
        "en": {
          "title": "Place spices in jar",
          "description": "Place the bay leaf and peppercorns at the bottom of the jar."
        }
      },
      {
        "id": "pack-meat-chicken-stew-in-oven",
        "en": {
          "title": "Pack meat into jar",
          "description": "Pack the meat tightly into the jar so that it reaches the neck."
        }
      },
      {
        "id": "slow-cook-chicken-stew-in-oven",
        "en": {
          "title": "Slow cook in oven",
          "description": "Cover the jar with foil and poke a few holes with a fork. Place the jar in a baking dish and put it in a cold oven. Turn the oven on to 200°C. Watch for the contents to start boiling, then reduce the temperature to 110°C and let it simmer for 3 hours."
        }
      },
      {
        "id": "render-fat-chicken-stew-in-oven",
        "en": {
          "title": "Render chicken fat and pour over stew",
          "description": "Place the reserved chicken fat in a dry skillet and render over medium heat. When the stewing time is up, pour the rendered fat into the jar."
        }
      },
      {
        "id": "seal-jar-chicken-stew-in-oven",
        "en": {
          "title": "Seal and cool the jar",
          "description": "Screw the lid on the jar. Invert it, wrap in a towel, and let it cool completely. Once cool, store in a dark, cool place."
        }
      }
    ],
