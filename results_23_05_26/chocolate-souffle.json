    "newCookingSteps": [
      {
        "id": "separate-whip-whites-chocolate-souffle",
        "en": {
          "title": "Separate eggs and whip whites",
          "description": "Separate the eggs, placing the whites in a large bowl and the yolks in a separate bowl. Beat the whites on low speed until foamy, then gradually increase speed and add the sugar in a thin stream. Continue beating until stiff, glossy peaks form."
        }
      },
      {
        "id": "mix-paste-yolks-chocolate-souffle",
        "en": {
          "title": "Mix chocolate paste with yolks",
          "description": "In a small bowl, combine the chocolate-hazelnut spread and the egg yolks. Stir until smooth and fully combined."
        }
      },
      {
        "id": "fold-one-third-whites-chocolate-souffle",
        "en": {
          "title": "Fold in one third of the whites",
          "description": "Add one third of the beaten egg whites to the chocolate mixture. Gently fold with a spatula until just combined, taking care not to deflate the whites."
        }
      },
      {
        "id": "fold-remaining-whites-chocolate-souffle",
        "en": {
          "title": "Fold in remaining whites",
          "description": "Add the remaining egg whites to the batter. Continue folding gently with a spatula until the mixture is homogeneous and no streaks remain."
        }
      },
      {
        "id": "butter-dust-molds-chocolate-souffle",
        "en": {
          "title": "Butter and dust the molds",
          "description": "Grease the soufflé dishes with butter. Lightly dust the insides with cocoa powder, tapping out the excess. Fill each mold about two-thirds full with the batter. Wipe the edges clean with a napkin."
        }
      },
      {
        "id": "bake-chocolate-souffle",
        "en": {
          "title": "Bake the soufflé",
          "description": "Preheat the oven to 190°C (375°F). Place the filled molds in the oven and bake for 20 minutes until risen and firm on top. Serve immediately."
        }
      }
    ],
