    "newCookingSteps": [
      {
        "id": "grate-carrot-cheese-carrot-tortillas-with-chicken-and-avocado",
        "en": {
          "title": "Grate carrot and cheese",
          "description": "Finely grate the carrot and the cheese. Use a fine grater for best texture."
        }
      },
      {
        "id": "mix-batter-carrot-tortillas-with-chicken-and-avocado",
        "en": {
          "title": "Mix the batter",
          "description": "Combine the grated carrot, cheese, and egg in a bowl. Stir until the mixture is uniform and well combined."
        }
      },
      {
        "id": "line-tray-carrot-tortillas-with-chicken-and-avocado",
        "en": {
          "title": "Line baking tray with parchment",
          "description": "Line a baking tray with parchment paper to prevent sticking."
        }
      },
      {
        "id": "form-tortillas-carrot-tortillas-with-chicken-and-avocado",
        "en": {
          "title": "Form tortillas on tray",
          "description": "Spoon the carrot mixture onto the prepared tray and shape it into two round, thin tortillas. Flatten them evenly."
        }
      },
      {
        "id": "bake-tortillas-carrot-tortillas-with-chicken-and-avocado",
        "en": {
          "title": "Bake the tortillas",
          "description": "Place the tray in a preheated oven at 180°C (350°F) and bake for 20-25 minutes, until the tortillas are golden and firm. They should be slightly crispy on the edges."
        }
      },
      {
        "id": "cool-tortillas-carrot-tortillas-with-chicken-and-avocado",
        "en": {
          "title": "Cool the tortillas",
          "description": "Remove the tortillas from the parchment paper and let them cool slightly on a wire rack. They should be cool enough to handle."
        }
      },
      {
        "id": "spread-cream-cheese-carrot-tortillas-with-chicken-and-avocado",
        "en": {
          "title": "Spread cream cheese",
          "description": "Spread a generous layer of cream cheese over half of each tortilla, leaving the other half uncovered."
        }
      },
      {
        "id": "add-arugula-carrot-tortillas-with-chicken-and-avocado",
        "en": {
          "title": "Add arugula",
          "description": "Distribute fresh arugula leaves evenly over the cream cheese layer."
        }
      },
      {
        "id": "slice-cucumber-carrot-tortillas-with-chicken-and-avocado",
        "en": {
          "title": "Slice cucumber",
          "description": "Cut the cucumber into thin slices and arrange them in a single layer over the arugula."
        }
      },
      {
        "id": "prepare-avocado-carrot-tortillas-with-chicken-and-avocado",
        "en": {
          "title": "Prepare avocado",
          "description": "Remove the pit and skin from the avocado. Slice the flesh into thin pieces and lay them over the cucumber."
        }
      },
      {
        "id": "slice-chicken-carrot-tortillas-with-chicken-and-avocado",
        "en": {
          "title": "Slice chicken breast",
          "description": "Cut the chicken breast into bite-sized pieces or thin strips and scatter them over the avocado."
        }
      },
      {
        "id": "assemble-tortilla-carrot-tortillas-with-chicken-and-avocado",
        "en": {
          "title": "Assemble the tortilla",
          "description": "Fold the uncovered half of the tortilla over the filling and press gently to seal. Serve immediately."
        }
      }
    ],
