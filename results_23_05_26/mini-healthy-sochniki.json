    "newCookingSteps": [
      {
        "id": "mix-egg-and-milk-mini-healthy-sochniki",
        "en": {
          "title": "Mix egg and milk",
          "description": "In a separate bowl, whisk the whole egg with the milk using a fork."
        }
      },
      {
        "id": "knead-dough-mini-healthy-sochniki",
        "en": {
          "title": "Knead the dough",
          "description": "Add the sifted mixture of rice flour, cornmeal, and baking powder. Add the sweetener. Knead into a soft, homogeneous dough. Gather it into a ball, wrap in plastic wrap, and refrigerate for 20 minutes."
        }
      },
      {
        "id": "chill-dough-mini-healthy-sochniki",
        "en": {
          "title": "Chill the dough",
          "description": "Place the wrapped dough in the refrigerator for 20 minutes."
        }
      },
      {
        "id": "prepare-filling-mini-healthy-sochniki",
        "en": {
          "title": "Prepare the filling",
          "description": "Mash the cottage cheese in a bowl with a fork. Add the egg white, vanilla, and sweetener. Mix well."
        }
      },
      {
        "id": "roll-and-cut-dough-mini-healthy-sochniki",
        "en": {
          "title": "Roll and cut the dough",
          "description": "Take the dough out of the refrigerator. Roll it out to a thickness of 2-3 mm on a surface lightly dusted with rice flour. Use a glass to cut out circles."
        }
      },
      {
        "id": "assemble-and-brush-mini-healthy-sochniki",
        "en": {
          "title": "Assemble and brush the sochniki",
          "description": "Place 1-2 teaspoons of filling on one half of each circle and fold the other half over. Place the pastries on a baking sheet lined with parchment paper. Brush with beaten egg yolk and sprinkle with sesame seeds."
        }
      },
      {
        "id": "preheat-oven-mini-healthy-sochniki",
        "en": {
          "title": "Preheat the oven",
          "description": "Preheat the oven to 180°C (350°F)."
        }
      },
      {
        "id": "bake-sochniki-mini-healthy-sochniki",
        "en": {
          "title": "Bake the sochniki",
          "description": "Bake for 15-20 minutes until lightly golden."
        }
      }
    ],
