        "id": "boil-eggs-toasts-with-pate-and-eggs",
        "en": {
          "title": "Boil the eggs",
          "description": "Bring water to a boil in a pot. Gently lower the eggs using a spoon to prevent cracking. Boil for 10 minutes, then transfer to ice water to cool."
        }
      },
      {
        "id": "fry-bread-toasts-with-pate-and-eggs",
        "en": {
          "title": "Fry the bread",
          "description": "Heat vegetable oil in a frying pan over medium heat. Fry the bread slices until golden and crispy on both sides."
        }
      },
      {
        "id": "prepare-egg-mixture-toasts-with-pate-and-eggs",
        "en": {
          "title": "Prepare the egg mixture",
          "description": "Peel the cooled eggs and dice or grate them finely. Chop the dill and mix it with the eggs. Season with a pinch of salt."
        }
      },
      {
        "id": "assemble-toasts-with-pate-and-eggs",
        "en": {
          "title": "Assemble the toasts",
          "description": "Spread the pate evenly on the toasted bread slices. Top with the egg and dill mixture."
        }
      }
