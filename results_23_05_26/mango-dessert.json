    "newCookingSteps": [
      {
        "id": "beat-eggs-sugar-mango-dessert",
        "en": {
          "title": "Beat eggs with sugar",
          "description": "In a bowl, beat the eggs with sugar until the mixture is fluffy and homogeneous. This should take a couple of minutes."
        }
      },
      {
        "id": "add-flour-mango-dessert",
        "en": {
          "title": "Add flour gradually",
          "description": "Gradually sift in the flour while continuing to beat the egg mixture. Ensure no dry lumps remain and the batter is runny."
        }
      },
      {
        "id": "bake-biscuit-mango-dessert",
        "en": {
          "title": "Bake the biscuit",
          "description": "Pour the batter into a parchment-lined baking pan. Bake in an oven preheated to 180°C for 25 minutes, or until golden and springy to the touch."
        }
      },
      {
        "id": "cool-biscuit-mango-dessert",
        "en": {
          "title": "Cool the biscuit",
          "description": "Remove the biscuit from the oven and transfer it onto a wire rack along with the parchment paper. Let it cool completely."
        }
      },
      {
        "id": "whip-cream-sugar-mango-dessert",
        "en": {
          "title": "Whip cream with powdered sugar",
          "description": "In a clean bowl, pour the heavy cream and add the powdered sugar. Whip until soft peaks form and the mixture is fluffy."
        }
      },
      {
        "id": "add-cream-cheese-mango-dessert",
        "en": {
          "title": "Add cream cheese",
          "description": "Add the cream cheese to the whipped cream and gently fold until combined. Be careful not to deflate the cream."
        }
      },
      {
        "id": "blend-mango-lemon-mango-dessert",
        "en": {
          "title": "Blend mango with lemon juice",
          "description": "Place the mango pieces in a blender, drizzle with lemon juice, and blend until smooth puree."
        }
      },
      {
        "id": "assemble-dessert-mango-dessert",
        "en": {
          "title": "Assemble the dessert",
          "description": "Cut the cooled biscuit into small cubes or break into pieces. In serving glasses, layer whipped cream, biscuit cubes, and mango puree. Repeat layers until all ingredients are used. Garnish with mint leaves if desired."
        }
      }
    ],
