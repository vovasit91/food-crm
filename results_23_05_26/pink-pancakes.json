    "newCookingSteps": [
      {
        "id": "boil-beets-pink-pancakes",
        "en": {
          "title": "Boil the beet",
          "description": "Place the beet in cold water and bring to a boil. Simmer over low heat for 35–40 minutes until tender. Test with a skewer, then cool and peel."
        }
      },
      {
        "id": "grate-and-squeeze-beets-pink-pancakes",
        "en": {
          "title": "Grate and squeeze the beet juice",
          "description": "Grate the peeled beet on the fine side of a grater. Press the grated beet through a sieve to extract the juice. Discard the pulp."
        }
      },
      {
        "id": "sift-flour-and-separate-eggs-pink-pancakes",
        "en": {
          "title": "Sift flour and separate eggs",
          "description": "Sift the flour into a bowl. Separate the eggs, adding the yolks to the flour. Mix the yolks into the flour."
        }
      },
      {
        "id": "melt-butter-and-combine-wet-ingredients-pink-pancakes",
        "en": {
          "title": "Melt butter and combine wet ingredients",
          "description": "Melt the butter in the microwave or on the stove. Add it to the flour-yolk mixture. While stirring, gradually pour in the milk and the beet juice."
        }
      },
      {
        "id": "whip-whites-and-fold-into-batter-pink-pancakes",
        "en": {
          "title": "Whip egg whites and fold into batter",
          "description": "In a separate deep bowl, whip the egg whites with a mixer until stiff peaks form. Gently fold the whipped whites into the batter, mixing thoroughly to eliminate lumps."
        }
      },
      {
        "id": "add-salt-and-sugar-pink-pancakes",
        "en": {
          "title": "Add salt and sugar",
          "description": "Season the batter with salt and sugar to taste. Stir until dissolved."
        }
      },
      {
        "id": "cook-pancakes-pink-pancakes",
        "en": {
          "title": "Cook the pancakes",
          "description": "Heat a pancake pan over medium heat and grease it lightly with oil. Pour a ladleful of batter into the pan, tilting to spread evenly. Cook for 2 minutes on one side, then flip and cook for 1 minute on the other side. Repeat with remaining batter."
        }
      }
    ],
