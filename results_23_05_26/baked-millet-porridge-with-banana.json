        "en": {
          "title": "Heat milk and vanilla sugar",
          "description": "Combine almond milk and vanilla sugar in a saucepan. Place over medium heat and bring to a boil."
        }
      },
      {
        "id": "cook-millet-porridge-baked-millet-porridge-with-banana",
        "en": {
          "title": "Cook millet porridge",
          "description": "Stir in millet once the milk boils, then reduce heat to low. Simmer for 20 minutes, stirring occasionally, until the millet is tender and the porridge thickens."
        }
      },
      {
        "id": "cool-porridge-baked-millet-porridge-with-banana",
        "en": {
          "title": "Cool porridge slightly",
          "description": "Remove the saucepan from the heat and let the porridge cool for about 10 minutes, so it's warm but not steaming."
        }
      },
      {
        "id": "prepare-banana-baked-millet-porridge-with-banana",
        "en": {
          "title": "Prepare banana",
          "description": "Peel the banana and slice it into rounds. Sprinkle with lemon juice to prevent browning and set aside."
        }
      },
      {
        "id": "mix-porridge-mixture-baked-millet-porridge-with-banana",
        "en": {
          "title": "Mix porridge mixture",
          "description": "In a deep bowl, whisk together the egg and heavy cream. Add the cooled millet porridge and stir until well combined and smooth. Gently fold in the banana slices."
        }
      },
      {
        "id": "fill-ramekins-baked-millet-porridge-with-banana",
        "en": {
          "title": "Fill ramekins",
          "description": "Grease ceramic ramekins with butter. Fill each ramekin two-thirds full with the millet mixture."
        }
      },
      {
        "id": "bake-millet-porridge-baked-millet-porridge-with-banana",
        "en": {
          "title": "Bake millet porridge",
          "description": "Preheat your oven to 180°C (350°F). Place the filled ramekins on a baking sheet or wire rack. Bake for 20 minutes, until the top is golden and the edges are set."
        }
      },
      {
        "id": "cool-baked-porridge-baked-millet-porridge-with-banana",
        "en": {
          "title": "Cool baked porridge",
          "description": "Remove the ramekins from the oven and let them cool slightly before serving."
        }
      }
